{
  "pluginId": "com.orbpro.rf-atmospheric-gaseous",
  "name": "RF Atmospheric (Gaseous) Absorption",
  "version": "0.1.0",
  "pluginFamily": "comms",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct"],
  "runtimeTargets": ["browser", "node"],
  "methods": [
    {
      "methodId": "compute_oxygen_db_per_km",
      "displayName": "Compute Oxygen Specific Attenuation",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericRequest", "fileIdentifier": "RATR" }], "description": "Aligned-binary atmospheric-attenuation request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericResult", "fileIdentifier": "RATS" }], "description": "Aligned-binary atmospheric-attenuation result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Single-Lorentzian oxygen-line absorption in dB/km. Valid < 57 GHz."
    },
    {
      "methodId": "compute_water_vapor_db_per_km",
      "displayName": "Compute Water Vapor Specific Attenuation",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericRequest", "fileIdentifier": "RATR" }], "description": "Aligned-binary atmospheric-attenuation request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericResult", "fileIdentifier": "RATS" }], "description": "Aligned-binary atmospheric-attenuation result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Single-Lorentzian H₂O-line absorption (centered at 22.235 GHz) in dB/km."
    },
    {
      "methodId": "compute_total_atmospheric_db",
      "displayName": "Compute Total Atmospheric Absorption",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericRequest", "fileIdentifier": "RATR" }], "description": "Aligned-binary atmospheric-attenuation request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericResult", "fileIdentifier": "RATS" }], "description": "Aligned-binary atmospheric-attenuation result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Total slant-path atmospheric absorption (oxygen + water vapor) in dB."
    },
    {
      "methodId": "compute_saturation_vapor_pressure",
      "displayName": "Compute WMO Magnus Saturation Vapor Pressure",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericRequest", "fileIdentifier": "RATR" }], "description": "Aligned-binary atmospheric-attenuation request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-atmospheric-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AtmosphericResult", "fileIdentifier": "RATS" }], "description": "Aligned-binary atmospheric-attenuation result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "WMO No. 8 Annex 4.A.1 saturation vapor pressure over water in hPa."
    }
  ],
  "timers": [],
  "protocols": [],
  "schemasUsed": [
    { "schemaName": "orbpro.comms.rf.AtmosphericRequest", "fileIdentifier": "RATR" },
    { "schemaName": "orbpro.comms.rf.AtmosphericResult", "fileIdentifier": "RATS" }
  ],
  "buildArtifacts": [
    { "artifactId": "rf-atmospheric-gaseous-runtime", "kind": "javascript-runtime", "path": "index.js", "target": "web,worker,node" }
  ],
  "abiVersion": 1
}
