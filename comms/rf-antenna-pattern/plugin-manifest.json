{
  "pluginId": "com.orbpro.rf-antenna-pattern",
  "name": "RF Antenna Pattern Evaluator",
  "version": "0.1.0",
  "pluginFamily": "comms",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct"],
  "runtimeTargets": ["browser", "node"],
  "methods": [
    {
      "methodId": "evaluate_gain",
      "displayName": "Evaluate Analytic Gain",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-antenna-pattern-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AntennaPatternRequest", "fileIdentifier": "RAPR" }], "description": "Aligned-binary antenna-pattern gain request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-antenna-pattern-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.AntennaPatternResult", "fileIdentifier": "RAPS" }], "description": "Aligned-binary antenna-pattern gain result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Antenna-pattern gain evaluation: analytic families (isotropic through teardrop), sampled cone×clock dB grids with bilinear interpolation and clock wrap, and the boresight/up → (cone, clock) geometry bridge. C++ port of the AntennaPattern.js evaluator."
    }
  ],
  "timers": [],
  "protocols": [],
  "schemasUsed": [
    { "schemaName": "orbpro.comms.rf.AntennaPatternRequest", "fileIdentifier": "RAPR" },
    { "schemaName": "orbpro.comms.rf.AntennaPatternResult", "fileIdentifier": "RAPS" }
  ],
  "buildArtifacts": [
    { "artifactId": "rf-antenna-pattern-runtime", "kind": "javascript-runtime", "path": "index.js", "target": "web,worker,node" }
  ],
  "abiVersion": 1
}
