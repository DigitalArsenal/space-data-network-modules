{
  "pluginId": "com.orbpro.rf-cloud-fog",
  "name": "RF Cloud / Fog Attenuation",
  "version": "0.1.0",
  "pluginFamily": "comms",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct"],
  "runtimeTargets": ["browser", "node"],
  "methods": [
    {
      "methodId": "compute_specific_coefficient",
      "displayName": "Compute K_l Coefficient",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-cloud-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.CloudRequest", "fileIdentifier": "RCDR" }], "description": "Aligned-binary cloud-attenuation request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-cloud-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.CloudResult", "fileIdentifier": "RCDS" }], "description": "Aligned-binary cloud-attenuation result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Mass-specific cloud-liquid-water attenuation coefficient K_l in dB/(km · g/m³)."
    },
    {
      "methodId": "compute_attenuation",
      "displayName": "Compute Cloud / Fog Attenuation",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-cloud-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.CloudRequest", "fileIdentifier": "RCDR" }], "description": "Aligned-binary cloud-attenuation request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-cloud-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.CloudResult", "fileIdentifier": "RCDS" }], "description": "Aligned-binary cloud-attenuation result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Total slant-path cloud / fog attenuation A = K_l · ρ · path_km in dB."
    }
  ],
  "timers": [],
  "protocols": [],
  "schemasUsed": [
    { "schemaName": "orbpro.comms.rf.CloudRequest", "fileIdentifier": "RCDR" },
    { "schemaName": "orbpro.comms.rf.CloudResult", "fileIdentifier": "RCDS" }
  ],
  "buildArtifacts": [
    { "artifactId": "rf-cloud-fog-runtime", "kind": "javascript-runtime", "path": "index.js", "target": "web,worker,node" }
  ],
  "abiVersion": 1
}
