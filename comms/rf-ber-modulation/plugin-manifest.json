{
  "pluginId": "com.orbpro.rf-ber-modulation",
  "name": "RF BER per Modulation",
  "version": "0.1.0",
  "pluginFamily": "comms",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct"],
  "runtimeTargets": ["browser", "node"],
  "methods": [
    {
      "methodId": "compute_erfc",
      "displayName": "Compute erfc",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-ber-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.BerRequest", "fileIdentifier": "RBRR" }], "description": "Aligned-binary BER request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-ber-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.BerResult", "fileIdentifier": "RBRS" }], "description": "Aligned-binary BER result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Numerical Recipes §6.2 Chebyshev erfc(x) primitive (~7-digit accuracy)."
    },
    {
      "methodId": "compute_ber_from_ebno",
      "displayName": "Compute BER from Eb/N0",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-ber-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.BerRequest", "fileIdentifier": "RBRR" }], "description": "Aligned-binary BER request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-ber-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.BerResult", "fileIdentifier": "RBRS" }], "description": "Aligned-binary BER result frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Closed-form bit-error rate for BPSK/QPSK/8-PSK/16-QAM/64-QAM/FSK (Sklar §4)."
    }
  ],
  "timers": [],
  "protocols": [],
  "schemasUsed": [
    { "schemaName": "orbpro.comms.rf.BerRequest", "fileIdentifier": "RBRR" },
    { "schemaName": "orbpro.comms.rf.BerResult", "fileIdentifier": "RBRS" }
  ],
  "buildArtifacts": [
    { "artifactId": "rf-ber-modulation-runtime", "kind": "javascript-runtime", "path": "index.js", "target": "web,worker,node" }
  ],
  "abiVersion": 1
}
