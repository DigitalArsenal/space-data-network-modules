{
  "pluginId": "com.orbpro.rf-link-budget",
  "name": "RF Link-Budget Orchestrator",
  "version": "0.1.0",
  "pluginFamily": "comms",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct"],
  "runtimeTargets": ["browser", "node"],
  "methods": [
    {
      "methodId": "compute_link_budget",
      "displayName": "Compute Composed Link Budget",
      "inputPorts": [
        { "portId": "request", "acceptedTypeSets": [{ "setId": "comms.rf-link-budget-request", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.LinkBudgetRequest", "fileIdentifier": "RLBR" }], "description": "Aligned-binary link-budget request frames." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary inputs." }
      ],
      "outputPorts": [
        { "portId": "result", "acceptedTypeSets": [{ "setId": "comms.rf-link-budget-result", "allowedTypes": [{ "schemaName": "orbpro.comms.rf.LinkBudgetResult", "fileIdentifier": "RLBS" }], "description": "Aligned-binary link-budget result frames (96-byte struct)." }], "minStreams": 1, "maxStreams": 65535, "required": true, "description": "Aligned-binary outputs." }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Friis + kTB + Shannon link-budget orchestrator. Includes the Eb/N0 = SNR + 10·log10(B/Rb) fix (Sklar Eq. 4.27) addressing the audit-identified bug at RfCommsCore.js:2872."
    }
  ],
  "timers": [],
  "protocols": [],
  "schemasUsed": [
    { "schemaName": "orbpro.comms.rf.LinkBudgetRequest", "fileIdentifier": "RLBR" },
    { "schemaName": "orbpro.comms.rf.LinkBudgetResult", "fileIdentifier": "RLBS" }
  ],
  "buildArtifacts": [
    { "artifactId": "rf-link-budget-runtime", "kind": "javascript-runtime", "path": "index.js", "target": "web,worker,node" }
  ],
  "abiVersion": 1
}
