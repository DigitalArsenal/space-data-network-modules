{
  "pluginId": "com.orbpro.rf-doppler-fresnel",
  "name": "RF Doppler / Fresnel Primitives",
  "version": "0.1.0",
  "pluginFamily": "comms",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct"],
  "runtimeTargets": ["browser", "node"],
  "methods": [
    {
      "methodId": "compute_doppler",
      "displayName": "Compute Doppler Shift",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "comms.rf-doppler-request",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.comms.rf.DopplerRequest",
                  "fileIdentifier": "RDPR"
                }
              ],
              "description": "Aligned-binary Doppler request frames (relative_velocity_mps: f64, frequency_hz: f64)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true,
          "description": "Aligned-binary Doppler inputs."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "comms.rf-doppler-result",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.comms.rf.DopplerResult",
                  "fileIdentifier": "RDPS"
                }
              ],
              "description": "Aligned-binary Doppler result frames (shift_hz: f64)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true,
          "description": "Aligned-binary Doppler outputs."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Computes classical first-order Doppler shift Δf = (v_r/c) · f."
    },
    {
      "methodId": "compute_fresnel",
      "displayName": "Compute Fresnel-Zone Radius",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "comms.rf-fresnel-request",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.comms.rf.FresnelRequest",
                  "fileIdentifier": "RFRR"
                }
              ],
              "description": "Aligned-binary Fresnel-zone request frames (d1_m: f64, d2_m: f64, frequency_hz: f64, zone: i32)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true,
          "description": "Aligned-binary Fresnel-zone inputs."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "comms.rf-fresnel-result",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.comms.rf.FresnelResult",
                  "fileIdentifier": "RFRS"
                }
              ],
              "description": "Aligned-binary Fresnel-zone result frames (radius_m: f64)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true,
          "description": "Aligned-binary Fresnel-zone outputs."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "drain-until-yield",
      "description": "Computes the n-th Fresnel-zone radius at an obstruction plane (ITU-R P.526-15 §3)."
    }
  ],
  "timers": [],
  "protocols": [],
  "schemasUsed": [
    {
      "schemaName": "orbpro.comms.rf.DopplerRequest",
      "fileIdentifier": "RDPR"
    },
    {
      "schemaName": "orbpro.comms.rf.DopplerResult",
      "fileIdentifier": "RDPS"
    },
    {
      "schemaName": "orbpro.comms.rf.FresnelRequest",
      "fileIdentifier": "RFRR"
    },
    {
      "schemaName": "orbpro.comms.rf.FresnelResult",
      "fileIdentifier": "RFRS"
    }
  ],
  "buildArtifacts": [
    {
      "artifactId": "rf-doppler-fresnel-runtime",
      "kind": "javascript-runtime",
      "path": "index.js",
      "target": "web,worker,node"
    }
  ],
  "abiVersion": 1
}
