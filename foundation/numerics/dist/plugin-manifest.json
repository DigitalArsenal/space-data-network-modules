{
  "pluginId": "com.digitalarsenal.foundation.numerics",
  "name": "Foundation Numerics",
  "version": "0.1.0",
  "description": "Shared SDS NUM numerical utility module for Basilisk-compatible scalar root solving, vector saturation, vector discretization, scalar interpolation, and bounded Gauss-Markov sequence statistics.",
