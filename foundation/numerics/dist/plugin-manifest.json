      "displayName": "Solve Scalar Root",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sds-num-root-solve-request",
              "allowedTypes": [
                {
                  "schemaName": "NUM.fbs",
                  "fileIdentifier": "$NUM",
                  "rootTypeName": "NUM"
                },
                {
                  "schemaName": "NUM.fbs",
                  "fileIdentifier": "$NUM",
                  "rootTypeName": "NUM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS NUM envelope carrying NUMRootSolveRequest."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Root-solve request."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sds-num-root-solve-result",
              "allowedTypes": [
                {
                  "schemaName": "NUM.fbs",
                  "fileIdentifier": "$NUM",
                  "rootTypeName": "NUM"
                },
                {
                  "schemaName": "NUM.fbs",
                  "fileIdentifier": "$NUM",
                  "rootTypeName": "NUM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS NUM envelope carrying NUMRootSolveResult."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Root-solve result."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Solves one scalar root with Basilisk-compatible Newton-Raphson iteration."
    },
