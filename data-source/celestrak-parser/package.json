{
  "name": "@digitalarsenal/sdn-module-celestrak-parser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sdn-module": "./dist/isomorphic/module.wasm",
  "exports": {
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "plugin-manifest.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:sdk-compat": "node --test tests/sdk_compat.test.mjs",
    "test:parity": "SDN_RUN_CELESTRAK_PARSER_PARITY=1 node --test tests/parity.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "space-data-module-sdk": "0.9.2"
  }
}
