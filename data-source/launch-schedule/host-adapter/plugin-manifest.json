{
  "pluginId": "com.digitalarsenal.data-source.launch-schedule-host",
  "name": "Launch notices scheduled source adapter",
  "version": "0.1.0",
  "description": "Generic host configuration and retrieval receipt for the launch notices flow. Requires an SDK host supplying plugin.getConfig; registry normalization remains in the portable core. SDN auto-publishes configured source lanes after successful ingestion.",
  "pluginFamily": "data_source",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Reads generic host configuration and the clock once per scheduled cycle; HTTP, signing, IPFS and persistence remain in existing host capability nodes. No threads."
  },
  "methods": [
    {
      "methodId": "prepare_scheduled",
      "displayName": "Prepare scheduled launch registry",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "tick-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Generic timer tick. Configuration is supplied by plugin.getConfig."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Generic timer tick. Configuration is supplied by plugin.getConfig."
        }
      ],
      "outputPorts": [
        {
          "portId": "config",
          "acceptedTypeSets": [
            {
              "setId": "config-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "One location, selected hourly variables, launch registry days and explicit API access tier."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "One location, selected hourly variables, launch registry days and explicit API access tier."
        },
        {
          "portId": "status",
          "acceptedTypeSets": [
            {
              "setId": "status-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Skipped timer cycle or unchanged response; flow bookkeeping, never a data record."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Skipped timer cycle or unchanged response; flow bookkeeping, never a data record."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
