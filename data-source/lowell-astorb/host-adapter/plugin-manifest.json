{
 "pluginId": "com.digitalarsenal.data-source.lowell-astorb-host",
 "name": "Lowell astorb scheduled source adapter",
 "version": "0.1.0",
 "description": "Generic host configuration and retrieval receipt for the asteroid retrieval flow. Requires an SDK host supplying plugin.getConfig (keys lowell_astorb_enabled, lowell_astorb_producer_peer_id, lowell_astorb_source); parsing stays in the portable core. SDN auto-publishes the configured source lane after successful ingestion.",
 "pluginFamily": "data_source",
 "capabilities": [],
 "externalInterfaces": [],
 "invokeSurfaces": [
  "direct",
  "command"
 ],
 "runtimeTargets": [
  "browser",
  "wasmedge"
 ],
 "sequentialJustification": {
  "kind": "pure-transform",
  "detail": "Reads generic host configuration and the clock once per scheduled cycle; HTTP, signing, IPFS and persistence remain in existing host capability nodes. No threads."
 },
 "methods": [
  {
   "methodId": "prepare_scheduled",
   "displayName": "Prepare scheduled astorb retrieval",
   "inputPorts": [
    {
     "portId": "tick",
     "acceptedTypeSets": [
      {
       "setId": "tick-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "intra-flow-control-frame",
        "mediaType": "application/json",
        "detail": "Generic timer tick. Configuration is supplied by plugin.getConfig."
       }
      }
     ],
     "minStreams": 1,
     "maxStreams": 1,
     "required": true,
     "description": "Generic timer tick. Configuration is supplied by plugin.getConfig."
    }
   ],
   "outputPorts": [
    {
     "portId": "config",
     "acceptedTypeSets": [
      {
       "setId": "config-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "intra-flow-control-frame",
        "mediaType": "application/json",
        "detail": "The source configuration for plan_astorb."
       }
      }
     ],
     "minStreams": 0,
     "maxStreams": 1,
     "required": false,
     "description": "The source configuration for plan_astorb."
    },
    {
     "portId": "status",
     "acceptedTypeSets": [
      {
       "setId": "status-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "intra-flow-control-frame",
        "mediaType": "application/json",
        "detail": "Skipped timer cycle or unchanged response; flow bookkeeping, never a data record."
       }
      }
     ],
     "minStreams": 0,
     "maxStreams": 1,
     "required": false,
     "description": "Skipped timer cycle or unchanged response; flow bookkeeping, never a data record."
    }
   ],
   "maxBatch": 1,
   "drainPolicy": "single-shot"
  },
  {
   "methodId": "receipt_scheduled",
   "displayName": "Attach retrieval receipt",
   "inputPorts": [
    {
     "portId": "job",
     "acceptedTypeSets": [
      {
       "setId": "job-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "intra-flow-control-frame",
        "mediaType": "application/json",
        "detail": "The astorb retrieval plan emitted by plan_astorb."
       }
      }
     ],
     "minStreams": 1,
     "maxStreams": 1,
     "required": true,
     "description": "The astorb retrieval plan emitted by plan_astorb."
    },
    {
     "portId": "response",
     "acceptedTypeSets": [
      {
       "setId": "response-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "foreign-wire-format",
        "mediaType": "application/vnd.sdn.http-raw-body-v1",
        "detail": "The raw-body-v1 HTTP response carrying the astorb.dat.gz bytes."
       }
      }
     ],
     "minStreams": 1,
     "maxStreams": 1,
     "required": true,
     "description": "The raw-body-v1 HTTP response carrying the astorb.dat.gz bytes."
    }
   ],
   "outputPorts": [
    {
     "portId": "job",
     "acceptedTypeSets": [
      {
       "setId": "job-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "intra-flow-control-frame",
        "mediaType": "application/json",
        "detail": "The retrieval plan, forwarded."
       }
      }
     ],
     "minStreams": 0,
     "maxStreams": 1,
     "required": false,
     "description": "The retrieval plan, forwarded."
    },
    {
     "portId": "response",
     "acceptedTypeSets": [
      {
       "setId": "response-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "foreign-wire-format",
        "mediaType": "application/vnd.sdn.http-raw-body-v1",
        "detail": "The raw-body-v1 HTTP response, forwarded."
       }
      }
     ],
     "minStreams": 0,
     "maxStreams": 1,
     "required": false,
     "description": "The raw-body-v1 HTTP response, forwarded."
    },
    {
     "portId": "receipt",
     "acceptedTypeSets": [
      {
       "setId": "receipt-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "intra-flow-control-frame",
        "mediaType": "application/json",
        "detail": "retrieved_at_ms and the producer peer ID."
       }
      }
     ],
     "minStreams": 0,
     "maxStreams": 1,
     "required": false,
     "description": "retrieved_at_ms and the producer peer ID."
    },
    {
     "portId": "status",
     "acceptedTypeSets": [
      {
       "setId": "status-v1",
       "allowedTypes": [
        {
         "acceptsAnyFlatbuffer": true
        }
       ],
       "wildcardJustification": {
        "kind": "intra-flow-control-frame",
        "mediaType": "application/json",
        "detail": "Not-modified or skipped cycle; never a data record."
       }
      }
     ],
     "minStreams": 0,
     "maxStreams": 1,
     "required": false,
     "description": "Not-modified or skipped cycle; never a data record."
    }
   ],
   "maxBatch": 1,
   "drainPolicy": "single-shot"
  }
 ]
}
