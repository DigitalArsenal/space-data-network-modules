{
  "pluginId": "com.digitalarsenal.data-source.lowell-astorb-host",
  "name": "Lowell astorb scheduled source adapter",
  "version": "0.4.0",
  "description": "Host side of the asteroid retrieval flow: generic host configuration (plugin.getConfig: lowell_astorb_enabled, lowell_astorb_producer_peer_id, lowell_astorb_source), the retrieval receipt, and ingest_astorb, which validates the whole download (gzip CRC-32 and length, fixed columns) and then streams the $SBD records into the node's store in ~12 MiB parts through the storage_ingest capability (storage.ingest_with_source), so the node never holds the 372 MB batch at once; then the largest tenth of them under their own lane (astorb-largest-10pct) and the two $EGP groups that list both lanes (astorb-groups). Parsing is the portable core's own (astorb_core.hpp). SDN auto-publishes the configured lanes once each batch has settled.",
  "pluginFamily": "data_source",
  "capabilities": [
    "storage_ingest"
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "The validated astorb records, in parts, through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "One configuration read per cycle; ingest_astorb inflates and parses serially and makes one storage.ingest_with_source host call per part; the host owns I/O and persistence. No threads."
  },
