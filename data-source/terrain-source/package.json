{
  "name": "@spacedatanetwork/terrain-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terrain DEM tiling module: decodes open DEM source responses, emits terrain tile records with water-mask channel. Pure transform; scheduling lives in the sibling terrain-ingest module.",
  "scripts": {
    "build": "node build.mjs && node build-parity.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:parity": "node build-parity.mjs",
    "build:shipped": "node build.mjs"
  },
  "sdn-module": "./dist/isomorphic/module.wasm",
  "exports": {
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "plugin-manifest.json"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "space-data-module-sdk": "^0.8.15",
    "spacedatastandards.org": "^1.196.0"
  }
}
