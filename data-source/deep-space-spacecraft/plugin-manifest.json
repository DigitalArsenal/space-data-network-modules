{
  "pluginId": "com.digitalarsenal.data-source.deep-space-spacecraft",
  "name": "Notable deep-space spacecraft (Horizons)",
  "version": "0.2.0",
  "description": "Retrieves 39 spacecraft as per-regime OEM catalogs from NASA/JPL Horizons: Sun-centered archives and rolling body-centered windows, classified in C++/WASM. Six bounded advance stages, segment membership, lifecycle attributes and EGP query groups. The host executes HTTP requests.",
  "pluginFamily": "data_source",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Bounded deterministic Horizons request planning, CSV parsing, OEM construction and interpolation. Only typed plugin.getConfig; no threads or network imports."
  },
  "schemasUsed": [
    {
      "schemaName": "TimerTick.fbs",
      "fileIdentifier": "TICK",
      "rootTypeName": "TimerTick"
    },
    {
      "schemaName": "HttpRequest.fbs",
      "fileIdentifier": "HREQ",
      "rootTypeName": "HttpRequest"
    },
    {
      "schemaName": "HttpResponse.fbs",
      "fileIdentifier": "HRSP",
      "rootTypeName": "HttpResponse"
    },
    {
      "schemaName": "FlowNotice.fbs",
      "fileIdentifier": "FNTC",
      "rootTypeName": "FlowNotice"
    },
    {
      "schemaName": "IngestRequest.fbs",
      "fileIdentifier": "INGQ",
      "rootTypeName": "IngestRequest"
    },
    {
      "schemaName": "OEM.fbs",
      "fileIdentifier": "$OEM",
      "rootTypeName": "OEM"
    },
    {
      "schemaName": "EGP.fbs",
      "fileIdentifier": "$EGP",
      "rootTypeName": "EGP"
    }
  ],
  "methods": [
    {
      "methodId": "plan_horizons",
      "displayName": "Plan Horizons coverage probes",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "tick-typed",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Daily trigger; ModuleConfig comes from plugin.getConfig."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequest.fbs",
                  "fileIdentifier": "HREQ",
                  "rootTypeName": "HttpRequest"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 60,
          "required": false,
          "description": "Plain GETs in pending-request order."
        },
        {
          "portId": "state",
          "acceptedTypeSets": [
            {
              "setId": "state-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "The retrieval state for the next stage: objects and the pending request list."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Deterministic retrieval state for the next stage."
        },
        {
          "portId": "status",
          "acceptedTypeSets": [
            {
              "setId": "status-typed",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Stage counts and skipped craft as <naif_id>:<code>; disabled is Skipped."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "advance",
