              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Evaluation request containing a jd_tdb array of epochs; never a dataset record."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Requested Julian dates on the TDB time scale."
        }
      ],
      "outputPorts": [
        {
          "portId": "states",
          "acceptedTypeSets": [
            {
              "setId": "states-v1",
              "allowedTypes": [
