                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Evaluation response containing jd_tdb, block and Cartesian position and velocity; never an ingest dataset record."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Evaluated states in km and km/s, ICRF, using each block's center and declared interpolation."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
