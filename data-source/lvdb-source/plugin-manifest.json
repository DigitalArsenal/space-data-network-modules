{
  "pluginId": "com.digitalarsenal.data-source.lvdb-source",
  "name": "Local Volume Database",
  "version": "0.1.0",
  "description": "CC0 LVDB release to SSY stellar systems.",
  "pluginFamily": "data_source",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Bounded deterministic parsing; no workers or shared state."
  },
  "schemasUsed": [
    {
      "schemaName": "SSY.fbs",
      "fileIdentifier": "$SSY",
      "rootTypeName": "SSY"
    },
    {
      "schemaName": "ModuleConfig.fbs",
      "fileIdentifier": "MCFG",
      "rootTypeName": "ModuleConfig"
    }
  ],
  "methods": [
    {
      "methodId": "plan_release",
      "displayName": "Fetch release marker",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "tick-typed",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "config",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-module-config",
              "allowedTypes": [
                {
                  "schemaName": "ModuleConfig.fbs",
                  "fileIdentifier": "MCFG",
                  "rootTypeName": "ModuleConfig",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Optional empty MCFG; release selection follows upstream release_version.txt."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequest.fbs",
                  "fileIdentifier": "HREQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 9,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "plan_catalog",
      "displayName": "Fetch release assets",
      "inputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponse.fbs",
                  "fileIdentifier": "HRSP",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "config",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-module-config",
              "allowedTypes": [
                {
                  "schemaName": "ModuleConfig.fbs",
                  "fileIdentifier": "MCFG",
                  "rootTypeName": "ModuleConfig",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Optional empty MCFG; release selection follows upstream release_version.txt."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequest.fbs",
                  "fileIdentifier": "HREQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 9,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "parse_catalog",
      "displayName": "Parse LVDB release",
      "inputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponse.fbs",
                  "fileIdentifier": "HRSP",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 4,
          "required": true
        },
        {
          "portId": "config",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-module-config",
              "allowedTypes": [
                {
                  "schemaName": "ModuleConfig.fbs",
                  "fileIdentifier": "MCFG",
                  "rootTypeName": "ModuleConfig",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Optional empty MCFG; release selection follows upstream release_version.txt."
        }
      ],
      "outputPorts": [
        {
          "portId": "records",
          "acceptedTypeSets": [
            {
              "setId": "records-typed",
              "allowedTypes": [
                {
                  "schemaName": "SSY.fbs",
                  "fileIdentifier": "$SSY",
                  "rootTypeName": "SSY",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "meta",
          "acceptedTypeSets": [
            {
              "setId": "meta-typed",
              "allowedTypes": [
                {
                  "schemaName": "IngestRequest.fbs",
                  "fileIdentifier": "INGQ",
                  "rootTypeName": "IngestRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
