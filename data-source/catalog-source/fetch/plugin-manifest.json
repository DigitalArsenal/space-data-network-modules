{
  "pluginId": "com.digitalarsenal.data-source.catalog-fetch",
  "name": "Catalog Fetch",
  "version": "0.1.0",
  "description": "Prepare original GCAT and McCants downloads, validate bounded ZIP editions and publish completed catalog batches.",
  "pluginFamily": "data_source",
  "capabilities": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "catalog_prepare_fetch",
      "displayName": "Fetch original catalog edition",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Host timer signal for a catalog retrieval job.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Host timer signal for a catalog retrieval job."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Host timer signal for a catalog retrieval job."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Bounded HTTP request control descriptor.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded HTTP request control descriptor."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Bounded HTTP request control descriptor."
        },
        {
          "portId": "job",
          "acceptedTypeSets": [
            {
              "setId": "job",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Original catalog source identity and attribution.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Original catalog source identity and attribution."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Original catalog source identity and attribution."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "catalog_unpack_fetch",
      "displayName": "Validate and unpack catalog download",
      "inputPorts": [
        {
          "portId": "job",
          "acceptedTypeSets": [
            {
              "setId": "job",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Original catalog source identity and attribution.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Original catalog source identity and attribution."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Original catalog source identity and attribution."
        },
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "HTTP response status and raw source bytes in the existing $HRB connector envelope.",
              "wildcardJustification": {
                "kind": "foreign-wire-format",
                "mediaType": "application/vnd.sdn.http-raw-body-v1",
                "detail": "HTTP response status and raw source bytes in the existing $HRB connector envelope."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "HTTP response status and raw source bytes in the existing $HRB connector envelope."
        }
      ],
      "outputPorts": [
        {
          "portId": "source",
          "acceptedTypeSets": [
            {
              "setId": "source",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Complete original catalog TSV or TLE text; decompressed with bounded size and CRC validation.",
              "wildcardJustification": {
                "kind": "foreign-wire-format",
                "mediaType": "text/plain",
                "detail": "Complete original catalog TSV or TLE text; decompressed with bounded size and CRC validation."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Complete original catalog TSV or TLE text; decompressed with bounded size and CRC validation."
        },
        {
          "portId": "meta",
          "acceptedTypeSets": [
            {
              "setId": "meta",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Edition hash, original attribution and storage reconciliation metadata.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Edition hash, original attribution and storage reconciliation metadata."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Edition hash, original attribution and storage reconciliation metadata."
        },
        {
          "portId": "unchanged",
          "acceptedTypeSets": [
            {
              "setId": "unchanged",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "HTTP 304 notice; no records or replacement batch.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "HTTP 304 notice; no records or replacement batch."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "HTTP 304 notice; no records or replacement batch."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "catalog_publish_request",
      "displayName": "Publish successfully stored catalog edition",
      "inputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "result",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Result from the storage-ingest capability.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Result from the storage-ingest capability."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Result from the storage-ingest capability."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Local publication request after successful complete edition ingest.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Local publication request after successful complete edition ingest."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Local publication request after successful complete edition ingest."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [],
  "buildArtifacts": [
    {
      "artifactId": "catalog-fetch-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1,
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Bounded sequential parsing, ZIP validation and request preparation. Independent editions are scheduled by the host; the module creates no threads."
  },
  "externalInterfaces": []
}
