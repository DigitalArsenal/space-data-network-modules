{
  "pluginId": "com.digitalarsenal.flows.mars-themis-imagery-ingest",
  "name": "Mars THEMIS Day IR imagery (USGS Astrogeology)",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Every linked guest is wasi-sequential; the flow dispatches them serially and delegates external concurrency to its host."
  },
  "description": "Mars imagery from the USGS Astrogeology THEMIS Day IR global mosaic 100 m v12 (NASA/JPL/ASU, public domain) as a 256 px JPEG tile pyramid to level 9 (81.4 m/px), planetocentric, read once by HTTP range, packs of 16 tiles added to the node's IPFS and filed as $PNM (provider usgs-astrogeology, source mars-themis-day-ir); the configured SDN auto-publisher signs and announces the lane. Disabled cycles emit status only.",
  "capabilities": [
    "http",
    "ipfs",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.body-imagery-tiles",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [],
  "methods": [
    {
      "methodId": "yearly",
      "displayName": "Flow trigger yearly",
      "description": "Compiled-flow ingress for trigger \"yearly\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK). Configuration is supplied by plugin.getConfig."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Generic timer tick. Configuration is supplied by plugin.getConfig."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-flow-notice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice Skipped, REASON disabled."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Skipped (disabled) timer cycle; flow bookkeeping, never a data record."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [],
  "runtimeTargets": [
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_mars_themis_imagery_ingest-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "prepare",
      "pluginId": "com.digitalarsenal.data-source.body-imagery-tiles",
      "methodId": "prepare_scheduled",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "retrieve",
      "pluginId": "com.digitalarsenal.data-source.body-imagery-tiles",
      "methodId": "retrieve_tiles",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "dispatchModel": "host-capability",
      "uiX": 0,
      "uiY": 0
    }
  ],
  "flowEdges": [
    {
      "edgeId": "prepare-cycle-retrieve-cycle",
      "fromNodeId": "prepare",
      "fromPortId": "cycle",
      "toNodeId": "retrieve",
      "toPortId": "cycle",
      "contract": {
        "canonicalType": {
          "schemaName": "FlowNotice.fbs",
          "fileIdentifier": "FNTC",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "FlowNotice",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": false,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "prepare-status-egress-result",
      "fromNodeId": "prepare",
      "fromPortId": "status",
      "toNodeId": "egress",
      "toPortId": "result",
      "contract": {
        "canonicalType": {
          "schemaName": "FlowNotice.fbs",
          "fileIdentifier": "FNTC",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "FlowNotice",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": false,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "retrieve-report-egress-result",
      "fromNodeId": "retrieve",
      "fromPortId": "report",
      "toNodeId": "egress",
      "toPortId": "result",
      "contract": {
        "canonicalType": {
          "schemaName": "FlowNotice.fbs",
          "fileIdentifier": "FNTC",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "FlowNotice",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": false,
        "routePolicy": "canonical-only"
      }
    }
  ],
  "flowTriggers": [
    {
      "triggerId": "yearly",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 31536000000,
      "httpPath": null
    }
  ],
  "flowTriggerBindings": [
    {
      "triggerId": "yearly",
      "targetNodeId": "prepare",
      "targetPortId": "tick"
    }
  ],
  "abiVersion": 1
}
