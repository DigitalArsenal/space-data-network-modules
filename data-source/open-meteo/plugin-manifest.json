{
  "pluginId": "com.digitalarsenal.data-source.open-meteo",
  "name": "Open-Meteo weather forecasts",
  "version": "0.1.0",
  "description": "Fetch-plan and normalization nodes for attributed hourly point forecasts. Emits binary WXF; generic host HTTP, scheduling, storage and publication supply network transport.",
  "pluginFamily": "data_source",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Bounded deterministic point-forecast request planning and binary normalization. No host calls, threads or network access."
  },
  "methods": [
    {
      "methodId": "plan_forecast",
      "displayName": "Plan forecast request",
      "inputPorts": [
        {
          "portId": "config",
          "acceptedTypeSets": [
            {
              "setId": "config-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "One location, selected hourly variables, forecast days and explicit API access tier."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One location, selected hourly variables, forecast days and explicit API access tier."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "GET descriptor for the generic HTTP host. Customer API key is attached privately by the host, never in the job."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "GET descriptor for the generic HTTP host. Customer API key is attached privately by the host, never in the job."
        },
        {
          "portId": "job",
          "acceptedTypeSets": [
            {
              "setId": "job-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Canonical request attribution, requested location and variables used to bind parsing to the request."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Canonical request attribution, requested location and variables used to bind parsing to the request."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "parse_forecast",
      "displayName": "Normalize forecast",
      "inputPorts": [
        {
          "portId": "job",
          "acceptedTypeSets": [
            {
              "setId": "job-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Unmodified forecast plan."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Unmodified forecast plan."
        },
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "foreign-wire-format",
                "mediaType": "application/vnd.sdn.http-raw-body-v1",
                "detail": "Bounded raw-body-v1 response from hostcap/http-request: $HRB, int32 status, upstream JSON bytes."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Bounded raw-body-v1 response from hostcap/http-request: $HRB, int32 status, upstream JSON bytes."
        },
        {
          "portId": "receipt",
          "acceptedTypeSets": [
            {
              "setId": "receipt-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Authenticated host receipt: integer retrieved_at_ms and producer_peer_id."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Authenticated host receipt: integer retrieved_at_ms and producer_peer_id."
        }
      ],
      "outputPorts": [
        {
          "portId": "records",
          "acceptedTypeSets": [
            {
              "setId": "weather-forecast",
              "allowedTypes": [
                {
                  "schemaName": "WXF.fbs",
                  "fileIdentifier": "$WXF",
                  "rootTypeName": "WXF"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Size-prefixed binary WXF stream, one 1x1 field per variable and UTC valid time."
        },
        {
          "portId": "meta",
          "acceptedTypeSets": [
            {
              "setId": "meta-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Attribution and licence metadata for generic storage.ingest_with_source. The host adds a cryptographic batch ID."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Attribution and licence metadata for generic storage.ingest_with_source. The host adds a cryptographic batch ID."
        },
        {
          "portId": "report",
          "acceptedTypeSets": [
            {
              "setId": "report-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Validation counts, missing values and retrieval time; never a dataset record."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Validation counts, missing values and retrieval time; never a dataset record."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "WXF.fbs",
      "fileIdentifier": "$WXF",
      "rootTypeName": "WXF"
    }
  ]
}
