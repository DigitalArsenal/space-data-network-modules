{
  "pluginId": "com.digitalarsenal.data-source.open-meteo-host",
  "name": "Open-Meteo scheduled source adapter",
  "version": "0.2.0",
  "description": "Scheduling gate for the Open-Meteo flow (typed contracts 1.0). prepare_scheduled: a TimerTick in; node CONFIG (plugin.getConfig) open_meteo_enabled must be true (else a FlowNotice Skipped 'disabled'), open_meteo_producer_peer_id set and open_meteo_forecast.access noncommercial (scheduled customer access needs a credential adapter and is refused); the tick is then forwarded to open-meteo plan_forecast. receipt_scheduled: the HttpResponse in; a 304 becomes a FlowNotice Unchanged (the current batch is kept, nothing republished), anything else is forwarded verbatim to open-meteo parse_forecast. The only host call is the builtin plugin.getConfig (SDS $PIV). No JSON.",
  "pluginFamily": "data_source",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Scheduling gates over node configuration; one builtin plugin.getConfig hostcall per invocation. HTTP, signing, IPFS and persistence remain in existing host capability nodes. No threads."
  },
  "methods": [
    {
      "methodId": "prepare_scheduled",
      "displayName": "Prepare scheduled forecast",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-TimerTick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (TICK) from the flow's timer trigger."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-TimerTick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "The same TimerTick, forwarded verbatim."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "The tick for open-meteo plan_forecast, only when scheduled fetching is enabled and allowed."
        },
        {
          "portId": "status",
          "acceptedTypeSets": [
            {
              "setId": "sdn-FlowNotice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (FNTC) kind Skipped, REASON 'disabled'."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Why the cycle fetched nothing."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Gates one timer tick on node CONFIG and forwards it to plan_forecast, or reports the skipped cycle."
    },
    {
      "methodId": "receipt_scheduled",
      "displayName": "Attach retrieval receipt",
      "inputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-HttpResponse",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponse.fbs",
                  "fileIdentifier": "HRSP",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "HttpResponse (HRSP) of the forecast GET."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The forecast response."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-HttpResponse",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponse.fbs",
                  "fileIdentifier": "HRSP",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "The same HttpResponse, forwarded verbatim."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "The response for open-meteo parse_forecast (not a 304)."
        },
        {
          "portId": "status",
          "acceptedTypeSets": [
            {
              "setId": "sdn-FlowNotice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (FNTC) kind Unchanged for a 304 (SCHEMA WXF.fbs, PROVIDER_ID open-meteo, SOURCE_NAME the plan's source)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "The unchanged notice: the publisher had nothing new."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Turns a 304 into an Unchanged notice; forwards every other response to parse_forecast."
    }
  ],
  "schemasUsed": []
}
