{
  "pluginId": "com.digitalarsenal.data-source.ephemeris-source",
  "name": "Ephemeris Source Retriever",
  "version": "0.1.5",
  "description": "Portable C++ ephemeris discovery and raw source descriptor processing. Network replies are explicit frames; scheduled acquisition uses the companion host adapter.",
  "pluginFamily": "data_source",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Bounded request planning, explicit listing-response discovery and raw NCD descriptor transformation. The core has no host imports and spawns no threads."
  },
  "methods": [
    {
      "methodId": "describe_sources",
      "displayName": "Describe Sources",
      "inputPorts": [],
      "outputPorts": [
        {
          "portId": "sources",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "ephemeris-sources",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded host orchestration metadata or unmodified source bytes; not a normalized data record."
              }
            }
          ]
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "plan_source_requests",
      "displayName": "Plan source discovery requests",
      "inputPorts": [
        {
          "portId": "config",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "ephemeris-config",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded host orchestration metadata or unmodified source bytes; not a normalized data record."
              }
            }
          ]
        }
      ],
      "outputPorts": [
        {
          "portId": "requests",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "ephemeris-resources",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded credential-free HTTP request descriptors for generic browser orchestration."
              }
            }
          ]
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "discover_sources",
      "displayName": "Discover Sources",
      "inputPorts": [
        {
          "portId": "config",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
