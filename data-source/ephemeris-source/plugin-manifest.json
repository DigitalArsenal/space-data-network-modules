            {
              "setId": "ephemeris-resources",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded host orchestration metadata or unmodified source bytes; not a normalized data record."
              }
            }
          ]
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "describe_artifact",
      "displayName": "Describe Artifact",
      "inputPorts": [
        {
          "portId": "resource",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "ephemeris-resource",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded host orchestration metadata or unmodified source bytes; not a normalized data record."
              }
            }
          ]
        },
        {
          "portId": "receipt",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "ephemeris-receipt",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded host orchestration metadata or unmodified source bytes; not a normalized data record."
              }
            }
          ]
        },
        {
          "portId": "body",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "ephemeris-body",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "foreign-wire-format",
                "mediaType": "application/vnd.sdn.ephemeris-source-file",
                "detail": "Exact bytes of the resource format named in the accompanying discovery descriptor: Starlink MEME, OneWeb LTEF, Planet states/TLE, CCSDS OEM KVN, SES I11, Intelsat TXT, Telesat CSV, CSS OEM ZIP, compressed SP3, ESA CPF or EUMETSAT TLE JavaScript. No SDS identity is asserted for foreign source bytes."
              }
            }
          ]
        }
      ],
      "outputPorts": [
        {
          "portId": "descriptor",
          "required": false,
          "minStreams": 0,
          "maxStreams": 64,
          "acceptedTypeSets": [
            {
              "setId": "sds-ncd",
              "allowedTypes": [
                {
                  "schemaName": "NCD.fbs",
                  "fileIdentifier": "$NCD",
                  "rootTypeName": "NCD"
                }
              ],
              "description": "Canonical size-prefixed SDS record."
            }
          ]
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
