          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "ephemeris-body",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "foreign-wire-format",
                "mediaType": "application/vnd.sdn.ephemeris-source-file",
                "detail": "Exact bytes of the resource format named in the accompanying discovery descriptor: Starlink MEME, OneWeb LTEF, Planet states/TLE, CCSDS OEM KVN, SES I11, Intelsat TXT, Telesat CSV, CSS OEM ZIP, compressed SP3, ESA CPF or EUMETSAT TLE JavaScript. No SDS identity is asserted for foreign source bytes."
              }
            }
          ]
        }
      ],
      "outputPorts": [
        {
          "portId": "catalog",
          "required": false,
          "minStreams": 0,
          "maxStreams": 64,
          "acceptedTypeSets": [
            {
              "setId": "coverage-cat",
              "allowedTypes": [
                {
                  "schemaName": "CAT.fbs",
                  "fileIdentifier": "$CAT",
                  "rootTypeName": "CAT"
                }
              ]
            }
          ]
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
