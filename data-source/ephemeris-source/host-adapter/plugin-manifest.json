{
  "pluginId": "com.digitalarsenal.data-source.ephemeris-source-host",
  "name": "Ephemeris Scheduled Publication Adapter",
  "version": "0.1.1",
  "description": "Bounded raw source acquisition into immutable IPFS files and attributed canonical NCD records; durable IRM continuation. Existing SDN source publisher independently signs and distributes NCD datasets.",
  "pluginFamily": "data_source",
  "capabilities": [
    "http",
    "ipfs",
    "storage_query",
    "storage_write",
    "storage_ingest",
    "timers"
  ],
  "externalInterfaces": [
    {
      "kind": "http",
      "host": "navigation-office.esa.int",
      "interfaceId": "provider-0",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "api.starlink.com",
      "interfaceId": "provider-1",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "app.telesat.com",
      "interfaceId": "provider-2",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "ephemerides.planet-labs.com",
      "interfaceId": "provider-3",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "ephemeris.oneweb.net",
      "interfaceId": "provider-4",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "igs.bkg.bund.de",
      "interfaceId": "provider-5",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "my.intelsat.com",
      "interfaceId": "provider-6",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "nasa-public-data.s3.amazonaws.com",
      "interfaceId": "provider-7",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "navigation-office.esa.int",
      "interfaceId": "provider-8",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "service.eumetsat.int",
      "interfaceId": "provider-9",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "ses-satellite-orbital-data-public.s3.eu-west-1.amazonaws.com",
      "interfaceId": "provider-10",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "www.cmse.gov.cn",
      "interfaceId": "provider-11",
      "direction": "bidirectional",
      "capability": "http"
    },
    {
      "kind": "http",
      "host": "www.ses.com",
      "interfaceId": "provider-12",
      "direction": "bidirectional",
      "capability": "http"
    }
  ],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "inherently-sequential-algorithm",
    "detail": "Each source part advances an ordered durable IRM checkpoint only after its immutable raw pin and attributed NCD ingestion succeed. No guest threads are spawned."
  },
  "methods": [
    {
      "methodId": "configure",
      "displayName": "Configure source retrieval",
      "inputPorts": [
        {
          "portId": "request",
          "required": true,
          "minStreams": 1,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Safe ephemeris configuration only; runtime input persistence reapplies this method after restart. Secret values are forbidden."
              }
            }
          ]
        }
      ],
      "outputPorts": [
        {
          "portId": "status",
          "required": false,
          "minStreams": 0,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "retrieval-status",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded retrieval progress only; never a normalized data record."
              }
            }
          ]
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "pull",
      "displayName": "Retrieve and publish raw source files",
      "inputPorts": [
        {
          "portId": "request",
          "required": false,
          "minStreams": 0,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Optional direct invocation control frame; standalone cron invokes with no payload."
              }
            }
          ]
        }
      ],
      "outputPorts": [
        {
          "portId": "descriptor",
          "required": false,
          "minStreams": 0,
          "maxStreams": 64,
          "acceptedTypeSets": [
            {
              "setId": "sds-ncd",
              "allowedTypes": [
                {
                  "schemaName": "NCD.fbs",
                  "fileIdentifier": "$NCD",
                  "rootTypeName": "NCD"
                }
              ]
            }
          ]
        },
        {
          "portId": "status",
          "required": false,
          "minStreams": 0,
          "maxStreams": 1,
          "acceptedTypeSets": [
            {
              "setId": "retrieval-status",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Bounded retrieval progress only; never a normalized data record."
              }
            }
          ]
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "NCD.fbs",
      "fileIdentifier": "$NCD",
      "rootTypeName": "NCD"
    },
    {
      "schemaName": "IRM.fbs",
      "fileIdentifier": "$IRM",
      "rootTypeName": "IRM"
    }
  ],
  "timers": [
    {
      "timerId": "ephemeris-pull",
      "methodId": "pull",
      "defaultIntervalMs": 60000,
      "description": "Continue a bounded source queue when explicitly configured and enabled."
    }
  ]
}
