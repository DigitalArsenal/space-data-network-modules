// OrbPro Plugin SDK - Stream Invoke Schemas (test bindings subset)
//
// A trimmed copy of the StreamInvokeRequest / StreamInvokeResponse tables that
// the contract tests encode on the wire when talking to OrbPro's native
// `plugin_stream_invoke` entry point. The C++ plugin reads the same table from
// the full PluginMessage.fbs, which additionally pulls sensor/SDF/manifest
// unions that the JS tests never touch — keeping this schema small avoids the
// transitive flatc include chain in generate-test-bindings.mjs.
//
// The `drain_policy` field from the canonical schema is intentionally omitted:
// tests never set it, so the plugin falls back to its FlatBuffer default.

include "TypedArenaBuffer.fbs";

namespace orbpro.plugin;

/// Generic stream-based method invocation request.
table StreamInvokeRequest {
  /// Stable target method identifier from PluginManifest.
  method_id: string (required);

  /// Input FlatBuffer frames grouped as a vector of descriptors.
  inputs: [orbpro.stream.TypedArenaBuffer];

  /// Maximum number of output frames the caller is prepared to accept.
  output_stream_cap: uint32;
}

/// Generic stream-based method invocation result.
table StreamInvokeResponse {
  /// Output FlatBuffer frames produced by the method.
  outputs: [orbpro.stream.TypedArenaBuffer];

  /// Number of queued input frames still waiting upstream after this call.
  backlog_remaining: uint32;

  /// True when the runtime yielded before fully draining the input backlog.
  yielded: bool = false;

  /// Error code (0 = success).
  error_code: int32;

  /// Error message if `error_code != 0`.
  error_message: string;
}
