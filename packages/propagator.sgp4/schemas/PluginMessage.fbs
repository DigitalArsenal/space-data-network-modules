// OrbPro Plugin SDK - Plugin Message Schema
//
// Unified message envelope for all plugin communication.
// This is the top-level schema that wraps all plugin I/O types.
//
// Generate with: flatc --gen-all PluginMessage.fbs

include "BaseTypes.fbs";
include "StateVector.fbs";
include "SensorDetection.fbs";
include "SDFDetection.fbs";
include "Arena.fbs";
include "TypedArenaBuffer.fbs";
include "PluginManifest.fbs";

namespace orbpro.plugin;

// =============================================================================
// Plugin Types (matches PLG schema)
// =============================================================================

/// Plugin type category
enum PluginType : ubyte {
  /// Sensor simulation and analysis
  SENSOR = 0,
  /// Orbital propagation algorithms
  PROPAGATOR = 1,
  /// Custom rendering/visualization
  RENDERER = 2,
  /// Data analysis and processing
  ANALYSIS = 3,
  /// External data source integration
  DATA_SOURCE = 4,
  /// Communications modeling
  COMMS = 5,
  /// GLSL shader plugins
  SHADER = 6,
  /// Signed distance field plugins
  SDF = 7
}

/// Plugin lifecycle state
enum PluginState : ubyte {
  /// Not loaded
  UNLOADED = 0,
  /// Loading in progress
  LOADING = 1,
  /// Ready for calls
  READY = 2,
  /// Error state
  ERROR = 3,
  /// Destroyed
  DESTROYED = 4
}

// =============================================================================
// Generic Plugin Request
// =============================================================================

/// Union of all possible plugin request payloads
union RequestPayload {
  /// Generic schema-tagged stream invocation
  StreamInvoke: StreamInvokeRequest,
  /// Initialize propagator from TLE/elements
  PropagatorInit: orbpro.propagator.PropagatorInit,
  /// Batch propagation request
  PropagatorBatch: orbpro.propagator.PropagatorBatchRequest,
  /// Sensor configuration
  SensorConfig: orbpro.sensor.SensorConfig,
  /// Batch sensor detection request
  SensorBatch: orbpro.sensor.SensorBatchRequest,
  /// SDF configuration
  SDFConfig: orbpro.sdf.SDFConfig,
  /// Batch SDF evaluation request
  SDFBatch: orbpro.sdf.SDFBatchRequest,
  /// Shader compile request
  ShaderCompile: ShaderCompileRequest,
  /// Generic binary data
  RawData: RawDataPayload
}

/// Union of all possible plugin response payloads
union ResponsePayload {
  /// Generic schema-tagged stream invocation result
  StreamInvoke: StreamInvokeResponse,
  /// Batch propagation response
  PropagatorBatch: orbpro.propagator.PropagatorBatchResponse,
  /// Batch sensor detection response
  SensorBatch: orbpro.sensor.SensorBatchResponse,
  /// Batch SDF evaluation response
  SDFBatch: orbpro.sdf.SDFBatchResponse,
  /// Shader compile response
  ShaderCompile: ShaderCompileResponse,
  /// Error response
  Error: ErrorResponse,
  /// Generic binary data
  RawData: RawDataPayload
}

// =============================================================================
// Shader Plugin Types
// =============================================================================

/// Shader injection point
enum ShaderInjectionPoint : ubyte {
  /// Before main() function
  BEFORE_MAIN = 0,
  /// After uniform declarations
  AFTER_UNIFORMS = 1,
  /// Before discard statement
  BEFORE_DISCARD = 2,
  /// After color computation
  AFTER_COLOR = 3,
  /// As a callable hook function
  HOOK_FUNCTION = 4
}

/// Shader uniform type
enum UniformType : ubyte {
  FLOAT = 0,
  VEC2 = 1,
  VEC3 = 2,
  VEC4 = 3,
  MAT3 = 4,
  MAT4 = 5,
  INT = 6,
  IVEC2 = 7,
  IVEC3 = 8,
  IVEC4 = 9,
  BOOL = 10,
  SAMPLER2D = 11,
  SAMPLERCUBE = 12
}

/// Shader uniform declaration
table ShaderUniform {
  /// Uniform name in GLSL
  name: string (required);
  /// Uniform type
  type: UniformType;
  /// Default value as JSON (e.g., "0.5", "[1.0, 0.0, 0.0]")
  default_value: string;
  /// Human-readable description
  description: string;
}

/// Shader compile request (standard mode)
table ShaderCompileRequest {
  /// Get vertex shader source
  get_vertex: bool = false;
  /// Get fragment shader source
  get_fragment: bool = true;
  /// Get uniform declarations
  get_uniforms: bool = true;
  /// Target injection point
  injection_point: ShaderInjectionPoint = AFTER_COLOR;
}

/// Shader compile response
table ShaderCompileResponse {
  /// Vertex shader GLSL source (null if not requested)
  vertex_source: string;
  /// Fragment shader GLSL source (null if not requested)
  fragment_source: string;
  /// Uniform declarations
  uniforms: [ShaderUniform];
  /// Preprocessor defines
  defines: [string];
  /// Injection point this shader targets
  injection_point: ShaderInjectionPoint;
  /// For hardened mode: WebGL program ID
  program_id: int32;
  /// Error code (0 = success)
  error_code: int32;
  /// Error message
  error_message: string;
}

// =============================================================================
// Generic Payloads
// =============================================================================

/// Raw binary data payload
table RawDataPayload {
  /// Data type identifier
  type_id: string;
  /// Binary data
  data: [ubyte];
}

/// Generic stream-based method invocation request.
table StreamInvokeRequest {
  /// Stable target method identifier from PluginManifest.
  method_id: string (required);

  /// Input FlatBuffer frames grouped as a vector of descriptors.
  inputs: [orbpro.stream.TypedArenaBuffer];

  /// Maximum number of output frames the caller is prepared to accept.
  output_stream_cap: uint32;

  /// Drain policy requested for this call.
  drain_policy: orbpro.manifest.DrainPolicy = DRAIN_UNTIL_YIELD;
}

/// Generic stream-based method invocation result.
table StreamInvokeResponse {
  /// Output FlatBuffer frames produced by the method.
  outputs: [orbpro.stream.TypedArenaBuffer];

  /// Number of queued input frames still waiting upstream after this call.
  backlog_remaining: uint32;

  /// True when the runtime yielded before fully draining the input backlog.
  yielded: bool = false;

  /// Error code (0 = success).
  error_code: int32;

  /// Error message if `error_code != 0`.
  error_message: string;
}

/// Error response
table ErrorResponse {
  /// Error code
  code: int32;
  /// Error message
  message: string;
  /// Stack trace (debug builds only)
  stack_trace: string;
  /// Source file where error occurred
  source_file: string;
  /// Line number
  source_line: int32;
}

// =============================================================================
// Plugin Message Envelope
// =============================================================================

/// Complete plugin message envelope
table PluginMessage {
  /// Message ID (for request/response correlation)
  id: uint64;

  /// Source plugin ID (0 = host)
  source_plugin: uint32;

  /// Target plugin ID (0 = host)
  target_plugin: uint32;

  /// Plugin type of target
  target_type: PluginType;

  /// Timestamp as Julian date
  timestamp: double;

  /// Request payload (for requests)
  request: RequestPayload;

  /// Response payload (for responses)
  response: ResponsePayload;

  /// Arena metadata
  arena_input_offset: uint32;
  arena_input_size: uint32;
  arena_output_offset: uint32;
  arena_output_size: uint32;
}

root_type PluginMessage;
file_identifier "PMSG";
