{
  "pluginId": "hpop-propagator",
  "name": "HPOP Propagator Plugin",
  "version": "0.1.0",
  "description": "High-Precision Orbit Propagator exposed through a canonical SDK command bridge.",
  "pluginFamily": "propagator",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["command"],
  "runtimeTargets": ["browser", "wasi", "wasmedge"],
  "methods": [
    {
      "methodId": "invoke",
      "displayName": "Invoke HPOP Operation",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "any-flatbuffer",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "any-flatbuffer",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
