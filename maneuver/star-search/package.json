{
  "name": "@digitalarsenal/sdn-module-maneuver-star-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sdn-module": "./dist/isomorphic/module.wasm",
  "exports": {
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "plugin-manifest.json",
    "README.md",
    "PORTING_NOTES.md",
    "vendor/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "sh tests/harness/build-native.sh && ./tests/harness/star_native",
    "vectors": "node scripts/generate-vectors.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "space-data-module-sdk": "0.8.20"
  }
}
