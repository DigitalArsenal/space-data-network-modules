{
  "pluginId": "com.digitalarsenal.analysis.association",
  "name": "Observation association",
  "version": "0.3.0",
  "description": "Associates radar ($RDO), electro-optical ($EOO) and RF ($RFO) observations with catalog predictions ($OEM with covariance): joint chi-square gating on the innovation covariance S = H P H^T + R for range, range rate, Doppler, RA/Dec and azimuth/elevation; global nearest-neighbour assignment per sensor scan (Hungarian, with a per-observation non-assignment cost equal to the gate); ambiguity and posterior association probability; observations that fit no prediction are re-emitted as UCT records. Earth orientation through ERFA (IAU 2006/2000A, CIO based) with caller-supplied $EOP. The evidence (every candidate, d2, p-value, posterior, residuals, geometry, outcome) is one $ASN association report; the options are the node config (plugin.getConfig). Also solves general rectangular assignment problems ($ASN problem in, $ASN solution out).",
  "pluginFamily": "analysis",
  "threadModel": "wasi-sequential",
  "sequentialJustification": {
    "kind": "inherently-sequential-algorithm",
    "detail": "Each scan is one shortest-augmenting-path assignment whose augmentations depend on the previous dual variables; scans are small (tens of observations) and the gate evaluation is a few hundred microseconds per observation, so parallel reductions would change floating-point association order with no useful speedup. One host call (plugin.getConfig for the options); no threads, propagation or network access."
  },
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "schemasUsed": [
    {
      "schemaName": "RDO.fbs",
      "fileIdentifier": "$RDO",
      "rootTypeName": "RDO"
    },
    {
      "schemaName": "EOO.fbs",
      "fileIdentifier": "$EOO",
      "rootTypeName": "EOO"
    },
    {
      "schemaName": "RFO.fbs",
      "fileIdentifier": "$RFO",
      "rootTypeName": "RFO"
    },
    {
      "schemaName": "OEM.fbs",
      "fileIdentifier": "$OEM",
      "rootTypeName": "OEM"
    },
    {
      "schemaName": "EOP.fbs",
      "fileIdentifier": "$EOP",
      "rootTypeName": "EOP"
    },
    {
      "schemaName": "ASN.fbs",
      "fileIdentifier": "$ASN",
      "rootTypeName": "ASN"
    }
  ],
  "methods": [
    {
      "methodId": "associate_observations",
      "displayName": "Associate observations",
      "inputPorts": [
        {
          "portId": "radar_observations",
          "acceptedTypeSets": [
            {
              "setId": "sds-observations-rdo",
              "allowedTypes": [
                {
                  "schemaName": "RDO.fbs",
                  "fileIdentifier": "$RDO",
                  "rootTypeName": "RDO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Radar observation ($RDO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Radar observation records ($RDO, plain or size-prefixed). Measured: RANGE, RANGE_RATE, AZIMUTH, ELEVATION; a field is measured when its 1-sigma uncertainty is positive. OB_TIME is UTC. At least one observation on any observations port."
        },
        {
          "portId": "optical_observations",
          "acceptedTypeSets": [
            {
              "setId": "sds-observations-eoo",
              "allowedTypes": [
                {
                  "schemaName": "EOO.fbs",
                  "fileIdentifier": "$EOO",
                  "rootTypeName": "EOO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Electro-optical observation ($EOO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Electro-optical observation records ($EOO, plain or size-prefixed). Measured: RA, DECLINATION (J2000 or GCRF topocentric), AZIMUTH, ELEVATION, RANGE, RANGE_RATE; a field is measured when its 1-sigma uncertainty is positive. OB_TIME is UTC. At least one observation on any observations port."
        },
        {
          "portId": "rf_observations",
          "acceptedTypeSets": [
            {
              "setId": "sds-observations-rfo",
              "allowedTypes": [
                {
                  "schemaName": "RFO.fbs",
                  "fileIdentifier": "$RFO",
                  "rootTypeName": "RFO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "RF observation ($RFO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "RF observation records ($RFO, plain or size-prefixed). Measured: RANGE, RANGE_RATE or one-way Doppler from FREQUENCY and NOMINAL_FREQUENCY (MHz), AZIMUTH, ELEVATION; a field is measured when its 1-sigma uncertainty is positive. OB_TIME is UTC. At least one observation on any observations port."
        },
        {
          "portId": "predictions",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Catalog predictions with covariance."
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true,
          "description": "One or more $OEM frames. One data block per catalog object span (OBJECT names it), TIME_SYSTEM UTC, Earth-centred, with COVARIANCE_MATRIX_LINES spanning the observations. Frames GCRF, ICRF, J2000, EME2000, TEME or an ITRF realization; covariance in the state frame or RSW_INERTIAL."
        },
        {
          "portId": "earth_orientation",
          "acceptedTypeSets": [
            {
              "setId": "sds-eop",
              "allowedTypes": [
                {
                  "schemaName": "EOP.fbs",
                  "fileIdentifier": "$EOP",
                  "rootTypeName": "EOP",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "IERS Earth orientation."
            }
          ],
          "minStreams": 0,
          "maxStreams": 366,
          "required": false,
          "description": "$EOP rows bracketing the observations (one row, several frames, or a size-prefixed stream). Required whenever an Earth-fixed sensor or prediction meets an inertial one."
        }
      ],
      "outputPorts": [
        {
          "portId": "radar_associated",
          "acceptedTypeSets": [
            {
              "setId": "sds-associated-rdo",
              "allowedTypes": [
                {
                  "schemaName": "RDO.fbs",
                  "fileIdentifier": "$RDO",
                  "rootTypeName": "RDO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Radar observation ($RDO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Each associated $RDO: the same record with UCT false and the catalog identity (SAT_NO, ON_ORBIT)."
        },
        {
          "portId": "optical_associated",
          "acceptedTypeSets": [
            {
              "setId": "sds-associated-eoo",
              "allowedTypes": [
                {
                  "schemaName": "EOO.fbs",
                  "fileIdentifier": "$EOO",
                  "rootTypeName": "EOO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Electro-optical observation ($EOO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Each associated $EOO: the same record with UCT false and the catalog identity (NORAD_CAT_ID, ID_ON_ORBIT; CORR_QUALITY = posterior association probability)."
        },
        {
          "portId": "rf_associated",
          "acceptedTypeSets": [
            {
              "setId": "sds-associated-rfo",
              "allowedTypes": [
                {
                  "schemaName": "RFO.fbs",
                  "fileIdentifier": "$RFO",
                  "rootTypeName": "RFO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "RF observation ($RFO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Each associated $RFO: the same record with UCT false and the catalog identity (SAT_NO, ON_ORBIT; CONFIDENCE = posterior association probability)."
        },
        {
          "portId": "radar_ucts",
          "acceptedTypeSets": [
            {
              "setId": "sds-ucts-rdo",
              "allowedTypes": [
                {
                  "schemaName": "RDO.fbs",
                  "fileIdentifier": "$RDO",
                  "rootTypeName": "RDO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Radar observation ($RDO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Each uncorrelated $RDO: the same record with UCT true and the association fields cleared."
        },
        {
          "portId": "optical_ucts",
          "acceptedTypeSets": [
            {
              "setId": "sds-ucts-eoo",
              "allowedTypes": [
                {
                  "schemaName": "EOO.fbs",
                  "fileIdentifier": "$EOO",
                  "rootTypeName": "EOO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Electro-optical observation ($EOO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Each uncorrelated $EOO: the same record with UCT true and the association fields cleared."
        },
        {
          "portId": "rf_ucts",
          "acceptedTypeSets": [
            {
              "setId": "sds-ucts-rfo",
              "allowedTypes": [
                {
                  "schemaName": "RFO.fbs",
                  "fileIdentifier": "$RFO",
                  "rootTypeName": "RFO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "RF observation ($RFO)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "Each uncorrelated $RFO: the same record with UCT true and the association fields cleared."
        },
        {
          "portId": "report",
          "acceptedTypeSets": [
            {
              "setId": "asn-association-report",
              "allowedTypes": [
                {
                  "schemaName": "ASN.fbs",
                  "fileIdentifier": "$ASN",
                  "rootTypeName": "ASN",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "$ASN with ASSOCIATION_REPORT set."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The association evidence: one $ASN whose ASSOCIATION_REPORT holds the options used, the chi-square gates, the counts and, per observation, its measurements and sigmas, every listed candidate (d2, p-value, posterior, residuals, predicted values, light time, geometry when the geometry option is on), the outcome (associated or UCT, with the reason) and ambiguity."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": ""
    },
    {
      "methodId": "solve_assignment",
      "displayName": "Solve assignment",
      "inputPorts": [
        {
          "portId": "problem",
          "acceptedTypeSets": [
            {
              "setId": "asn-problem",
              "allowedTypes": [
                {
                  "schemaName": "ASN.fbs",
                  "fileIdentifier": "$ASN",
                  "rootTypeName": "ASN",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "$ASN with PROBLEM set."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One $ASN whose PROBLEM is a dense cost matrix (DENSE_COST, NaN or +Infinity = forbidden) or sparse ENTRIES (absent pairs forbidden), with optional UNASSIGNED_COST (one value, or one per row) and OBJECTIVE."
        }
      ],
      "outputPorts": [
        {
          "portId": "solution",
          "acceptedTypeSets": [
            {
              "setId": "asn-solution",
              "allowedTypes": [
                {
                  "schemaName": "ASN.fbs",
                  "fileIdentifier": "$ASN",
                  "rootTypeName": "ASN",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "$ASN with SOLUTION set."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One $ASN whose SOLUTION gives the column of each row (-1 = unassigned), the total cost (assigned plus unassigned costs paid), the counts and the method."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
