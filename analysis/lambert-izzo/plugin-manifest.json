{
  "pluginId": "com.orbpro.lambert-izzo",
  "name": "Izzo Lambert Solver",
  "version": "0.2.0",
  "description": "Izzo Lambert boundary-value solver and bounded departure-by-arrival delta-V grid search.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "threadModel": "wasi-sequential",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "A bounded sweep of at most 400 by 400 Lambert cells streams one departure row at a time. The caller can partition departure ranges across instances; the kernel holds one row and no cross-call state."
  },
  "methods": [
    {
      "methodId": "solve_lambert",
      "displayName": "Solve Lambert Transfer",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "analysis.lambert-solve-request",
              "allowedTypes": [
                {
                  "schemaName": "LMS.fbs",
                  "fileIdentifier": "$LMS",
                  "rootTypeName": "LMS"
                }
              ],
              "description": "Canonical Lambert boundary-value request: r1, r2, time of flight, gravitational parameter, transfer way, and revolution budget."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One Lambert transfer solve request."
        }
      ],
      "outputPorts": [
        {
          "portId": "solutions",
          "acceptedTypeSets": [
            {
              "setId": "analysis.lambert-solve-result",
              "allowedTypes": [
                {
                  "schemaName": "LMO.fbs",
                  "fileIdentifier": "$LMO",
                  "rootTypeName": "LMO"
                }
              ],
              "description": "Canonical Lambert solve result with departure/arrival velocities, multi-revolution branch metadata, and solver diagnostics."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Lambert solve result or no stream when the request fails closed."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Solves single- and multi-revolution Lambert boundary-value transfer cases with Izzo's revisited algorithm."
    },
    {
      "methodId": "grid_search",
      "displayName": "Lambert Delta-V Mesh",
      "description": "Sweep sampled ephemerides and minimize total endpoint delta-V over directions and revolution branches. Emit one PCE per departure row and a best-cell PCE.",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "lambert-grid.request",
              "allowedTypes": [
                {
                  "schemaName": "PCE.fbs",
                  "fileIdentifier": "$PCE",
                  "rootTypeName": "PCE"
                }
              ],
              "description": "SDS parameter evaluation record with documented provider-defined grid parameters and SI units."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "mesh",
          "acceptedTypeSets": [
            {
              "setId": "lambert-grid.mesh",
              "allowedTypes": [
                {
                  "schemaName": "PCE.fbs",
                  "fileIdentifier": "$PCE",
                  "rootTypeName": "PCE"
                }
              ],
              "description": "SDS parameter evaluation record with documented provider-defined grid parameters and SI units."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "best",
          "acceptedTypeSets": [
            {
              "setId": "lambert-grid.best",
              "allowedTypes": [
                {
                  "schemaName": "PCE.fbs",
                  "fileIdentifier": "$PCE",
                  "rootTypeName": "PCE"
                }
              ],
              "description": "SDS parameter evaluation record with documented provider-defined grid parameters and SI units."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "timers": [],
  "protocols": [],
  "schemasUsed": [
    {
      "schemaName": "LMS.fbs",
      "fileIdentifier": "$LMS",
      "rootTypeName": "LMS"
    },
    {
      "schemaName": "LMO.fbs",
      "fileIdentifier": "$LMO",
      "rootTypeName": "LMO"
    },
    {
      "schemaName": "PCE.fbs",
      "fileIdentifier": "$PCE",
      "rootTypeName": "PCE"
    }
  ],
  "buildArtifacts": [
    {
      "artifactId": "lambert-izzo-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1
}
