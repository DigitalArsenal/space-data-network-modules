{
  "pluginId": "launch-ascent-analysis",
  "name": "Launch Ascent Analysis",
  "version": "0.1.0",
  "description": "Evaluates launch-ascent trajectory samples by composing atmosphere and hypersonic-condition providers.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["command"],
  "runtimeTargets": ["browser", "wasmedge"],
  "methods": [
    {
      "methodId": "simulate_launch_ascent",
      "displayName": "Simulate Launch Ascent",
      "inputPorts": [
        {
          "portId": "ascent",
          "acceptedTypeSets": [
            {
              "setId": "launch-ascent-scenario",
              "allowedTypes": [
                { "schemaName": "LDM.fbs", "fileIdentifier": "$LDM", "rootTypeName": "LDM" }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "launch",
          "acceptedTypeSets": [
            {
              "setId": "launch-ascent-message",
              "allowedTypes": [
                { "schemaName": "LAM.fbs", "fileIdentifier": "$LAM", "rootTypeName": "LAM" }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
