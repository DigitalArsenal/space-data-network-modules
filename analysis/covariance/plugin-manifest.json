{
  "pluginId": "covariance-analysis",
  "name": "Covariance Analysis",
  "version": "0.1.0",
  "description": "Combines direct covariance, synthetic TLE-series scatter, and sensor bias inputs into an SDS-compatible covariance product.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["command"],
  "runtimeTargets": ["browser", "wasmedge"],
  "threadModel": "wasi-sequential",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Each invocation combines one object's covariance, TLE sample scatter and sensor biases into one fixed-size 6x6 covariance product. The kernel performs ordered scalar reductions and sorts three diagonal position sigmas without spawning guest threads; independent objects are parallelized by the caller."
  },
  "methods": [
    {
      "methodId": "compute_covariance",
      "displayName": "Compute Covariance",
      "inputPorts": [
        {
          "portId": "covariance",
          "acceptedTypeSets": [
            {
              "setId": "covariance-request",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "covariance",
          "acceptedTypeSets": [
            {
              "setId": "ocm-covariance-result",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
