{
  "pluginId": "sensor-coverage-analysis",
  "name": "Sensor Coverage Analysis",
  "version": "0.1.0",
  "description": "Computes OrbPro Sensor-driven time coverage, intervals, revisit/gap/response statistics, and Orekit-style swath products from propagated sensor geometry.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct", "command"],
  "runtimeTargets": ["browser", "wasmedge"],
  "methods": [
    {
      "methodId": "compute_sensor_coverage",
      "displayName": "Compute Sensor Coverage",
      "inputPorts": [
        {
          "portId": "coverage",
          "acceptedTypeSets": [
            {
              "setId": "coverage-scv-request",
              "allowedTypes": [
                {
                  "schemaName": "SensorCoverageCompatibilityJson",
                  "fileIdentifier": "JSON",
                  "rootTypeName": "SensorCoverageCompatibilityRequest"
                },
                {
                  "schemaName": "SCV/main.fbs",
                  "fileIdentifier": "$SCV",
                  "rootTypeName": "SCV",
                  "wireFormat": "flatbuffer",
                  "requiredAlignment": 8
                }
              ],
              "description": "Canonical SDS SCV FlatBuffer request payload with explicit JSON compatibility fallback during migration."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Required canonical SDS SCV request envelope or explicit JSON compatibility adapter."
        }
      ],
      "outputPorts": [
        {
          "portId": "coverage",
          "acceptedTypeSets": [
            {
              "setId": "coverage-scv-result",
              "allowedTypes": [
                {
                  "schemaName": "SensorCoverageCompatibilityJson",
                  "fileIdentifier": "JSON",
                  "rootTypeName": "SensorCoverageCompatibilityResult"
                },
                {
                  "schemaName": "SCV/main.fbs",
                  "fileIdentifier": "$SCV",
                  "rootTypeName": "SCV",
                  "wireFormat": "flatbuffer",
                  "requiredAlignment": 8
                }
              ],
              "description": "Canonical SDS SCV progress/result envelopes with explicit JSON compatibility fallback during migration."
            }
          ],
          "minStreams": 0,
          "maxStreams": 3,
          "required": false,
          "description": "Coverage result stream: SCV progress/result frames plus optional JSON compatibility result."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Computes deterministic sensor coverage, access intervals, coverage FOMs, and swath geometry products."
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "SCV/main.fbs",
      "fileIdentifier": "$SCV",
      "rootTypeName": "SCV",
      "wireFormat": "flatbuffer",
      "requiredAlignment": 8,
      "description": "Canonical binary request/result/progress ABI for this module's active coverage contract."
    }
  ],
  "timers": [],
  "protocols": [],
  "abiVersion": 1
}
