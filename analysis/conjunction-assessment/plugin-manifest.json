              "allowedTypes": [
                { "schemaName": "orbpro.conjunction.ConjunctionEvent", "fileIdentifier": "CAEV" },
                { "schemaName": "orbpro.conjunction.ConjunctionEvent", "fileIdentifier": "CAEV", "wireFormat": "aligned-binary", "rootTypeName": "ConjunctionEvent", "requiredAlignment": 8 }
