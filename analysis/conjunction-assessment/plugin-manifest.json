          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "orbpro.conjunction.pair-request",
              "allowedTypes": [
                { "schemaName": "orbpro.conjunction.ConjunctionPairRequest", "fileIdentifier": "CAPQ" },
                { "schemaName": "orbpro.conjunction.ConjunctionPairRequest", "fileIdentifier": "CAPQ", "wireFormat": "aligned-binary", "rootTypeName": "ConjunctionPairRequest", "requiredAlignment": 8 }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
