          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "cdm",
          "acceptedTypeSets": [
            {
              "setId": "sds.cdm",
              "allowedTypes": [
                { "schemaName": "CDM.fbs", "fileIdentifier": "$CDM" },
                { "schemaName": "CDM.fbs", "fileIdentifier": "$CDM", "wireFormat": "aligned-binary", "rootTypeName": "CDM", "requiredAlignment": 8 }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
