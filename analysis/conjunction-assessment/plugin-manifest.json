{
  "pluginId": "conjunction-assessment",
  "name": "Conjunction Assessment Plugin",
  "version": "0.2.0",
  "description": "Conjunction assessment and collision probability analysis through the SDS PIV/TAB invoke surface.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "dependencies": [
    {
      "pluginId": "com.orbpro.sgp4",
      "minVersion": "1.0.0"
    }
