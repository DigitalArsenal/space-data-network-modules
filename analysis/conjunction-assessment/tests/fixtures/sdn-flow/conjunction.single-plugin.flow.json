{
  "programId": "com.digitalarsenal.examples.conjunction-single-plugin-flow",
  "name": "Conjunction Assessment Single Plugin Flow",
  "version": "0.1.0",
  "nodes": [
    {
      "nodeId": "conjunction",
      "pluginId": "conjunction-assessment",
      "methodId": "screen_catalog",
      "kind": "transform",
      "drainPolicy": "drain-to-empty"
    }
  ],
  "edges": [],
  "triggers": [
    {
      "triggerId": "manual-request",
      "kind": "manual",
      "source": "user"
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "manual-request",
      "targetNodeId": "conjunction",
      "targetPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 16
    }
  ],
  "requiredPlugins": ["conjunction-assessment", "com.orbpro.sgp4"],
  "description": "Minimal sdn-flow example invoking the conjunction assessment plugin through the canonical command bridge."
}
