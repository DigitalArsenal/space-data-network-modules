{
  "pluginId": "conjunction-assessment",
  "name": "Conjunction Assessment Plugin",
  "version": "0.6.0",
  "description": "Conjunction assessment and collision probability analysis through the SDS PIV/TAB invoke surface.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "dependencies": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "assess_conjunction",
      "displayName": "Assess Conjunction",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sds-cqr",
              "allowedTypes": [
                {
                  "schemaName": "CQR.fbs",
                  "fileIdentifier": "$CQR",
                  "rootTypeName": "CQR",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "uncertainty_model",
          "acceptedTypeSets": [
            {
              "setId": "uncertainty-model-v1",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/vnd.sdn.ca-uncertainty-model",
                "detail": "CAU1 tag, label, regimes (mean altitude and eccentricity bounds), prediction-age bins, and per stratum the RTN position-velocity covariance, calibration flag and reference (analysis/gp-error-model, written by scripts/uncertainty-model.mjs)."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Empirical prediction-error model for element-set sources. With a covariance ALGORITHM, each event between two element sets takes the covariance of its regime and prediction age (TCA minus epoch), labelled EMPIRICAL_MODEL and CALIBRATED only where the model's calibration gate passed; absent, or outside the model, events keep the Alfano maximum."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sds-cqr",
              "allowedTypes": [
                {
                  "schemaName": "CQR.fbs",
                  "fileIdentifier": "$CQR",
                  "rootTypeName": "CQR",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "cdm",
          "acceptedTypeSets": [
            {
              "setId": "sds-cdm",
              "allowedTypes": [
                {
                  "schemaName": "CDM.fbs",
                  "fileIdentifier": "$CDM",
                  "rootTypeName": "CDM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
