{
  "pluginId": "com.digitalarsenal.analysis.sea-state",
  "name": "Sea state",
  "version": "0.1.0",
  "description": "Deep-water wind sea from the JONSWAP 1973 spectrum with a Pierson-Moskowitz 1964 fully developed limit; typed SI inputs and engine mapping.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Each invocation is a bounded deterministic transform of its typed input; the module owns no background workers or mutable simulation state."
  },
  "schemasUsed": [
    {
      "schemaName": "PCE.fbs",
      "fileIdentifier": "$PCE",
      "rootTypeName": "PCE",
      "wireFormat": "flatbuffer"
    }
  ],
  "methods": [
    {
      "methodId": "sea_state",
      "displayName": "Wind sea and engine state",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request",
              "allowedTypes": [
                {
                  "schemaName": "PCE.fbs",
                  "fileIdentifier": "$PCE",
                  "rootTypeName": "PCE",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "result",
              "allowedTypes": [
                {
                  "schemaName": "PCE.fbs",
                  "fileIdentifier": "$PCE",
                  "rootTypeName": "PCE",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "threadModel": "wasi-sequential"
}
