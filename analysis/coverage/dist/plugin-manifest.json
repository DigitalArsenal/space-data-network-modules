{
  "pluginId": "com.orbpro.coverage",
  "name": "Coverage Analysis",
  "version": "1.0.0",
  "description": "Analytical ground-grid coverage accumulation, figure-of-merit computation, interval tracking, and heatmap generation.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct", "command"],
