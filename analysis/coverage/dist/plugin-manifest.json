        {
          "portId": "grid",
          "acceptedTypeSets": [
            {
              "setId": "analysis.coverage-grid-config",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.CoverageGridConfig",
                  "fileIdentifier": "CVGC",
                  "rootTypeName": "CoverageGridConfig"
                },
                {
                  "schemaName": "orbpro.analysis.CoverageGridConfig",
                  "fileIdentifier": "CVGC",
                  "rootTypeName": "CoverageGridConfig",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Coverage grid configuration frames."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Analytical coverage grid configuration."
        }
      ],
      "outputPorts": [
        {
          "portId": "results",
          "acceptedTypeSets": [
