{
  "pluginId": "orbit-determination",
  "name": "Orbit Determination Plugin",
  "version": "0.2.0",
  "description": "Fits near-term SGP4 supplemental-GP mean elements ($OMM) to an operator ephemeris: an SDS $OEM FlatBuffer, or a text ephemeris file (SpaceX MEME or CCSDS OEM KVN) carried as an SDS $FIL. Both fit the same core and emit the same records: $OMM elements, $OCM epoch state with explicit covariance availability, epoch, frame and units, and $OBD OD results (the fit, plus the scored reference element set when one is configured). Labels, iteration limit, text format, the reference element set and the opt-in two-line set ($FIL) come from node CONFIG (plugin.getConfig).",
  "pluginFamily": "orbit_determination",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "command",
    "direct"
  ],
  "runtimeTargets": [
    "browser",
    "wasi",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "fit",
      "displayName": "Fit supplemental-GP $OMM from an operator $OEM or text ephemeris file",
      "inputPorts": [
        {
          "portId": "oem",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "One SDS OEM FlatBuffer, carried as a FlatBuffer or aligned-binary frame."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "One SDS OEM ephemeris per invocation. Supply exactly one OEM or text ephemeris frame."
        },
        {
          "portId": "meme",
          "acceptedTypeSets": [
            {
              "setId": "sds-fil",
              "allowedTypes": [
                {
                  "schemaName": "FIL.fbs",
                  "fileIdentifier": "$FIL",
                  "rootTypeName": "FIL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "One SDS $FIL whose CONTENT is the text ephemeris (SpaceX MEME or CCSDS OEM KVN; CONFIG inputFormat selects, else sniffed)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "A text ephemeris file as an SDS $FIL. Supply exactly one $OEM or $FIL ephemeris."
        }
      ],
      "outputPorts": [
        {
          "portId": "omm",
          "acceptedTypeSets": [
            {
              "setId": "sds-omm",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Fitted supplemental-GP elements, carried as an aligned-binary frame containing a size-prefixed SDS OMM."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "One size-prefixed SDS OMM."
        },
        {
          "portId": "ocm",
          "acceptedTypeSets": [
            {
              "setId": "sds-ocm",
              "allowedTypes": [
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Epoch state and optional formal fit covariance, with explicit availability and interpretation."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "One size-prefixed SDS OCM with fit uncertainty status."
        },
        {
          "portId": "obd",
          "acceptedTypeSets": [
            {
              "setId": "sds-obd",
              "allowedTypes": [
                {
                  "schemaName": "OBD.fbs",
                  "fileIdentifier": "$OBD",
                  "rootTypeName": "OBD",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "OBD.fbs",
                  "fileIdentifier": "$OBD",
                  "rootTypeName": "OBD",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "OD run results, carried as FlatBuffers or aligned-binary frames containing a size-prefixed SDS OBD."
            }
          ],
          "minStreams": 0,
          "maxStreams": 2,
          "required": false,
          "description": "The fit ($OBD, METHOD DIFFERENTIAL_CORRECTION, METHOD_SOURCE SDN-OD: WRMS = position RMS km, NUM_ITERATIONS, FIT_SPAN days; SENSORS[0].SENSOR_ID = CONFIG dataSource when given) and, when CONFIG names a reference element set (refEpoch + refMeanMotion ...), that set scored by the same SGP4 over the same points (METHOD GENERAL_PERTURBATIONS, METHOD_SOURCE reference, WRMS = its RMS km)."
        },
        {
          "portId": "tle",
          "acceptedTypeSets": [
            {
              "setId": "sds-fil",
              "allowedTypes": [
                {
                  "schemaName": "FIL.fbs",
                  "fileIdentifier": "$FIL",
                  "rootTypeName": "FIL",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Opt-in (CONFIG emitTle): the fitted elements as the legacy two-line set, an SDS $FIL NAME \"<NORAD>.tle\", MEDIA_TYPE text/plain, CONTENT \"line1\\nline2\" (Alpha-5 catalog numbers from 100000; above 339999 the fit fails unrepresentable-catalog-number)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
