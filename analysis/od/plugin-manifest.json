{
  "pluginId": "orbit-determination",
  "name": "Orbit Determination Plugin",
  "version": "0.1.0",
  "description": "Fits near-term SGP4 SupGP/OMM mean elements to operator ephemeris samples (SpaceX MEME text or CCSDS OEM KVN, selected via the options inputFormat field) and returns JSON fit results with RMS.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["command"],
  "runtimeTargets": ["browser", "wasi", "wasmedge"],
  "methods": [
    {
      "methodId": "fit",
      "displayName": "Fit SupGP from operator ephemeris (MEME or CCSDS OEM)",
      "inputPorts": [
        {
          "portId": "meme",
          "acceptedTypeSets": [
            {
              "setId": "any-flatbuffer",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "options",
          "acceptedTypeSets": [
            {
              "setId": "json-options",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "any-flatbuffer",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
