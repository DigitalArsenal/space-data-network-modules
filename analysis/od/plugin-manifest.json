{
  "pluginId": "orbit-determination",
  "name": "Orbit Determination Plugin",
  "version": "0.1.0",
  "description": "Fits near-term SGP4 supplemental-GP mean elements ($OMM) to operator ephemeris ($OEM). Primary flow path is aligned-binary FlatBuffers ($OEM in -> fit -> $OMM out); a text command path (SpaceX MEME / CCSDS OEM KVN -> JSON) is retained for command back-compat.",
  "pluginFamily": "orbit_determination",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "command",
    "direct"
  ],
  "runtimeTargets": [
    "browser",
    "wasi",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "fit",
      "displayName": "Fit supplemental-GP $OMM from operator $OEM ephemeris",
      "inputPorts": [
        {
          "portId": "oem",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM"
                },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OEM ephemeris (FlatBuffer or aligned-binary). Accepts a BATCH of 1..N $OEM frames (one per operator object); the threaded `fit` fans them across std::thread workers. Held in memory only; never stored."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false,
          "description": "Generic $OEM batch (untagged; provider from node CONFIG). At least one frame across any oem* port is required."
        },
        {
          "portId": "options",
          "acceptedTypeSets": [
            {
              "setId": "options",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Labeling / fit-config / scoring overrides. In a baked flow these live in node CONFIG."
        },
        {
          "portId": "meme",
          "acceptedTypeSets": [
            {
              "setId": "text-ephemeris",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Back-compat command surface: SpaceX MEME text or CCSDS OEM KVN (inputFormat option selects/auto-detects)."
        },
        {
          "portId": "oem_starlink",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM"
                },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OEM ephemeris (FlatBuffer or aligned-binary). Accepts a BATCH of 1..N $OEM frames (one per operator object); the threaded `fit` fans them across std::thread workers. Held in memory only; never stored."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false,
          "description": "Per-provider $OEM batch (starlink); the fit derives the provider token from the port and emits it on the provenance port."
        },
        {
          "portId": "oem_glonass",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM"
                },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OEM ephemeris (FlatBuffer or aligned-binary). Accepts a BATCH of 1..N $OEM frames (one per operator object); the threaded `fit` fans them across std::thread workers. Held in memory only; never stored."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false,
          "description": "Per-provider $OEM batch (glonass); the fit derives the provider token from the port and emits it on the provenance port."
        },
        {
          "portId": "oem_intelsat",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM"
                },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OEM ephemeris (FlatBuffer or aligned-binary). Accepts a BATCH of 1..N $OEM frames (one per operator object); the threaded `fit` fans them across std::thread workers. Held in memory only; never stored."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false,
          "description": "Per-provider $OEM batch (intelsat); the fit derives the provider token from the port and emits it on the provenance port."
        },
        {
          "portId": "oem_cpf",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM"
                },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OEM ephemeris (FlatBuffer or aligned-binary). Accepts a BATCH of 1..N $OEM frames (one per operator object); the threaded `fit` fans them across std::thread workers. Held in memory only; never stored."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false,
          "description": "Per-provider $OEM batch (cpf); the fit derives the provider token from the port and emits it on the provenance port."
        },
        {
          "portId": "oem_iss",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM"
                },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OEM ephemeris (FlatBuffer or aligned-binary). Accepts a BATCH of 1..N $OEM frames (one per operator object); the threaded `fit` fans them across std::thread workers. Held in memory only; never stored."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false,
          "description": "Per-provider $OEM batch (iss); the fit derives the provider token from the port and emits it on the provenance port."
        }
      ],
      "outputPorts": [
        {
          "portId": "omm",
          "acceptedTypeSets": [
            {
              "setId": "sds-omm",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM"
                },
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OMM supplemental-GP mean elements (ORIGINATOR=SDN-OD), aligned-binary. One $OMM per fitted object in the batch."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false
        },
        {
          "portId": "obd",
          "acceptedTypeSets": [
            {
              "setId": "sds-obd",
              "allowedTypes": [
                {
                  "schemaName": "OBD.fbs",
                  "fileIdentifier": "$OBD",
                  "rootTypeName": "OBD"
                },
                {
                  "schemaName": "OBD.fbs",
                  "fileIdentifier": "$OBD",
                  "rootTypeName": "OBD",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OBD orbit-determination run result (WRMS, iterations, DIFFERENTIAL_CORRECTION), aligned-binary."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false
        },
        {
          "portId": "ocm",
          "acceptedTypeSets": [
            {
              "setId": "sds-ocm",
              "allowedTypes": [
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM"
                },
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "SDS $OCM comprehensive message: epoch STATE + 6x6 COVARIANCE (normal-equations fit covariance) + OD residual summary, aligned-binary."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false
        },
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "json-result",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Back-compat command surface: JSON fit result (text path only)."
        },
        {
          "portId": "provenance",
          "acceptedTypeSets": [
            {
              "setId": "od-provenance",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "CID-keyed provenance sidecar per emitted record: [u32 cid_len][cid][u32 provider_len][provider][u32 source_name_len][source_name]. The flatsql-store maps cid->{provider,source_name}."
            }
          ],
          "minStreams": 0,
          "maxStreams": 100000,
          "required": false,
          "description": "Per-record provider attribution keyed by the record CID."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "OEM.fbs",
      "fileIdentifier": "$OEM",
      "rootTypeName": "OEM"
    },
    {
      "schemaName": "OMM.fbs",
      "fileIdentifier": "$OMM",
      "rootTypeName": "OMM"
    },
    {
      "schemaName": "OBD.fbs",
      "fileIdentifier": "$OBD",
      "rootTypeName": "OBD"
    },
    {
      "schemaName": "OCM.fbs",
      "fileIdentifier": "$OCM",
      "rootTypeName": "OCM"
    }
  ]
}
