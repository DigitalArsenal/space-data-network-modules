{
  "pluginId": "com.orbpro.swath",
  "name": "Swath Analysis",
  "version": "1.0.0",
  "description": "Sensor footprint projection, ground-track generation, access geometry, and swath analytics for mission planning.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct", "command"],
  "runtimeTargets": ["browser", "wasmedge"],
  "methods": [
    {
      "methodId": "project_footprint",
      "displayName": "Project Footprint",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-footprint-request",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathFootprintRequest",
                  "fileIdentifier": "SFPQ",
                  "rootTypeName": "SwathFootprintRequest"
                },
                {
                  "schemaName": "orbpro.analysis.SwathFootprintRequest",
                  "fileIdentifier": "SFPQ",
                  "rootTypeName": "SwathFootprintRequest",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary state-vector plus sensor-geometry request."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Footprint request."
        }
      ],
      "outputPorts": [
        {
          "portId": "results",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-footprint-result",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathFootprintResult",
                  "fileIdentifier": "SFPR",
                  "rootTypeName": "SwathFootprintResult"
                },
                {
                  "schemaName": "orbpro.analysis.SwathFootprintResult",
                  "fileIdentifier": "SFPR",
                  "rootTypeName": "SwathFootprintResult",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary footprint vertex result."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Footprint result."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Projects a sensor footprint onto the WGS84 ellipsoid."
    },
    {
      "methodId": "ground_track",
      "displayName": "Ground Track",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-ground-track-request",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathGroundTrackRequest",
                  "fileIdentifier": "SGRQ",
                  "rootTypeName": "SwathGroundTrackRequest"
                },
                {
                  "schemaName": "orbpro.analysis.SwathGroundTrackRequest",
                  "fileIdentifier": "SGRQ",
                  "rootTypeName": "SwathGroundTrackRequest",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary state-batch request."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Ground-track request."
        }
      ],
      "outputPorts": [
        {
          "portId": "results",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-ground-track-result",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathGroundTrackResult",
                  "fileIdentifier": "SGRS",
                  "rootTypeName": "SwathGroundTrackResult"
                },
                {
                  "schemaName": "orbpro.analysis.SwathGroundTrackResult",
                  "fileIdentifier": "SGRS",
                  "rootTypeName": "SwathGroundTrackResult",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary ground-track result."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Ground-track result."
        }
      ],
      "maxBatch": 1024,
      "drainPolicy": "single-shot",
      "description": "Computes geodetic ground-track points from state vectors."
    },
    {
      "methodId": "generate_swath",
      "displayName": "Generate Swath",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-generation-request",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathGenerationRequest",
                  "fileIdentifier": "SWAQ",
                  "rootTypeName": "SwathGenerationRequest"
                },
                {
                  "schemaName": "orbpro.analysis.SwathGenerationRequest",
                  "fileIdentifier": "SWAQ",
                  "rootTypeName": "SwathGenerationRequest",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary swath generation request."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Swath request."
        }
      ],
      "outputPorts": [
        {
          "portId": "results",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-generation-result",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathGenerationResult",
                  "fileIdentifier": "SWAS",
                  "rootTypeName": "SwathGenerationResult"
                },
                {
                  "schemaName": "orbpro.analysis.SwathGenerationResult",
                  "fileIdentifier": "SWAS",
                  "rootTypeName": "SwathGenerationResult",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary swath generation result."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Swath result."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Generates swath footprint segments across a propagated path."
    },
    {
      "methodId": "point_in_footprint",
      "displayName": "Point In Footprint",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-containment-request",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathContainmentRequest",
                  "fileIdentifier": "SPIQ",
                  "rootTypeName": "SwathContainmentRequest"
                },
                {
                  "schemaName": "orbpro.analysis.SwathContainmentRequest",
                  "fileIdentifier": "SPIQ",
                  "rootTypeName": "SwathContainmentRequest",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary footprint containment request."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Containment request."
        }
      ],
      "outputPorts": [
        {
          "portId": "results",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-containment-result",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathContainmentResult",
                  "fileIdentifier": "SPIR",
                  "rootTypeName": "SwathContainmentResult"
                },
                {
                  "schemaName": "orbpro.analysis.SwathContainmentResult",
                  "fileIdentifier": "SPIR",
                  "rootTypeName": "SwathContainmentResult",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary footprint containment result."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Containment result."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Tests whether a geodetic point is inside a sensor footprint."
    },
    {
      "methodId": "access_geometry",
      "displayName": "Access Geometry",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-access-request",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathAccessRequest",
                  "fileIdentifier": "SAPQ",
                  "rootTypeName": "SwathAccessRequest"
                },
                {
                  "schemaName": "orbpro.analysis.SwathAccessRequest",
                  "fileIdentifier": "SAPQ",
                  "rootTypeName": "SwathAccessRequest",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary access-geometry request."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Access request."
        }
      ],
      "outputPorts": [
        {
          "portId": "results",
          "acceptedTypeSets": [
            {
              "setId": "analysis.swath-access-result",
              "allowedTypes": [
                {
                  "schemaName": "orbpro.analysis.SwathAccessResult",
                  "fileIdentifier": "SAPR",
                  "rootTypeName": "SwathAccessResult"
                },
                {
                  "schemaName": "orbpro.analysis.SwathAccessResult",
                  "fileIdentifier": "SAPR",
                  "rootTypeName": "SwathAccessResult",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ],
              "description": "Aligned-binary access-geometry result."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Access result."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "description": "Computes instantaneous range, elevation, azimuth, and visibility."
    }
  ],
  "schemasUsed": [],
  "buildArtifacts": [
    {
      "artifactId": "swath-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1
}
