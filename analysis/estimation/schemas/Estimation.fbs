include "Propagator.fbs";

namespace orbpro.estimation;

// Estimation family ABI. This schema is the single source of truth for the
// fixed-layout C boundary and the request/result wire. Propagation is an
// inverted port protocol: the guest emits state/STM requests and consumes the
// supplied Propagator.fbs answers. It imports no provider-specific function.

enum EstimatorKind : ubyte (abi, abi_c_name: "OrbProEstimatorKind", abi_c_prefix: "ORBPRO_ESTIMATOR_") {
  BATCH_WEIGHTED_LEAST_SQUARES = 0,
  EXTENDED_KALMAN_FILTER = 1,
  UNSCENTED_KALMAN_FILTER = 2,
  EXTENDED_KALMAN_FILTER_WITH_RTS = 3,
  LINEAR_KALMAN_FILTER = 4,
  // Extension v3 (TEAG/ESPF; docs/espf-spec.md).
  ESPF_2025 = 5,
  ESPF_2026 = 6,
  ELLIPSOIDAL_SET_MEMBERSHIP = 7
}

enum MeasurementKind : ushort (abi, abi_c_name: "OrbProMeasurementKind", abi_c_prefix: "ORBPRO_MEASUREMENT_") {
  RANGE = 0,
  RANGE_RATE = 1,
  DOPPLER = 2,
  AZIMUTH_ELEVATION = 3,
  X_EAST_Y_NORTH = 4,
  X_SOUTH_Y_EAST = 5,
  RIGHT_ASCENSION_DECLINATION = 6,
  POSITION_VECTOR = 7,
  SEQUENTIAL_RANGE = 8,
  PSEUDONOISE_RANGE = 9,
  TIME_CORRELATED_PHASE = 10,
  RELAY_RANGE = 11,
  RELAY_DOPPLER = 12,
  RELAY_DIFFERENCED_DOPPLER = 13,
  BISTATIC_RANGE = 14,
  SKIN_RANGE = 15,
  CROSSLINK_RANGE = 16,
  CROSSLINK_RANGE_RATE = 17,
  LASER_RANGE = 18,
  TIME_DIFFERENCE_OF_ARRIVAL = 19,
  FREQUENCY_DIFFERENCE_OF_ARRIVAL = 20,
  POSITION_VELOCITY = 21,
  PSEUDORANGE = 22,
  LINEAR = 23
}

enum ProcessNoiseKind : ubyte (abi, abi_c_name: "OrbProProcessNoiseKind", abi_c_prefix: "ORBPRO_PROCESS_NOISE_") {
  NONE = 0,
  STATE_NOISE_COMPENSATION = 1,
  DYNAMIC_MODEL_COMPENSATION = 2
}

enum TroposphereKind : ubyte (abi, abi_c_name: "OrbProTroposphereKind", abi_c_prefix: "ORBPRO_TROPOSPHERE_") {
  NONE = 0,
  HOPFIELD_SAASTAMOINEN = 1,
  MARINI = 2
}

enum IonosphereKind : ubyte (abi, abi_c_name: "OrbProIonosphereKind", abi_c_prefix: "ORBPRO_IONOSPHERE_") {
  NONE = 0,
  TOTAL_ELECTRON_CONTENT = 1,
  REFERENCE_PROFILE = 2
}

enum InitialOrbitKind : ubyte (abi, abi_c_name: "OrbProInitialOrbitKind", abi_c_prefix: "ORBPRO_IOD_") {
  GAUSS = 0,
  LAPLACE = 1,
  GIBBS = 2,
  HERRICK_GIBBS = 3
}

enum EstimationStatus : int (abi, abi_c_name: "OrbProEstimationStatus", abi_c_prefix: "ORBPRO_ESTIMATION_") {
  INTERNAL = -20,
  PROPAGATOR_PROTOCOL = -19,
  BUFFER_TOO_SMALL = -18,
  NOT_CONVERGED = -5,
  BAD_INPUT = -4,
  NULL_OUTPUT = -3,
  NOT_CONFIGURED = -1,
  OK = 0,
  NEEDS_PROPAGATION = 1
}

struct EstimationEpoch (abi, abi_c_name: "OrbProEstimationEpoch", abi_c_helper_prefix: "orbpro_estimation_epoch_") {
  jd_day:double;
  seconds:double;
}

/// One observation in SI units. The first value_count lanes of value and
/// sigma are meaningful. station_position_m is in the request frame.
struct EstimationObservation (abi, abi_c_name: "OrbProEstimationObservation", abi_c_helper_prefix: "orbpro_estimation_observation_") {
  epoch:EstimationEpoch;
  value:[double:4];
  sigma:[double:4];
  station_position_m:[double:3];
  station_velocity_mps:[double:3];
  station_east:[double:3];
  station_north:[double:3];
  station_up:[double:3];
  remote_position_m:[double:3];
  remote_velocity_mps:[double:3];
  frequency_hz:double;
  transmitter_delay_seconds:double;
  receiver_delay_seconds:double;
  transponder_delay_seconds:double;
  elevation_rad:double;
  station_latitude_rad:double;
  station_height_m:double;
  pressure_hpa:double;
  temperature_k:double;
  relative_humidity:double;
  wavelength_m:double;
  total_electron_content:double;
  total_electron_content_rate_per_second:double;
  turnaround_numerator:uint;
  turnaround_denominator:uint;
  kind:MeasurementKind;
  value_count:ubyte;
  flags:ubyte;
  transmitter_index:uint;
  receiver_index:uint;
}

struct EstimationErrorModel (abi, abi_c_name: "OrbProEstimationErrorModel", abi_c_helper_prefix: "orbpro_estimation_error_model_") {
  noise_sigma:double;
  bias:double;
  bias_sigma:double;
  correlation_time_seconds:double;
  minimum_value:double;
  maximum_value:double;
  sigma_edit_threshold:double;
  random_seed:ulong;
  measurement_kind:MeasurementKind;
  troposphere:TroposphereKind;
  ionosphere:IonosphereKind;
  flags:ubyte;
}

/// Fixed configuration copied byte-for-byte in every runtime. initial_state
/// is Cartesian [x,y,z,vx,vy,vz] in metres and metres per second; covariance
/// is row-major 6 by 6 in matching SI units.
struct EstimationConfig (abi, abi_c_name: "OrbProEstimationConfig", abi_c_helper_prefix: "orbpro_estimation_config_") {
  initial_epoch:EstimationEpoch;
  initial_state:[double:6];
  initial_covariance:[double:36];
  process_noise_spectral_density:[double:6];
  state_convergence_tolerance:double;
  rms_convergence_tolerance:double;
  sigma_edit_threshold:double;
  dynamic_model_correlation_time_seconds:double;
  maximum_iterations:uint;
  reference_frame:orbpro.propagator.ReferenceFrame;
  estimator:EstimatorKind;
  process_noise:ProcessNoiseKind;
  flags:ushort;
}

struct EstimationState (abi, abi_c_name: "OrbProEstimationState", abi_c_helper_prefix: "orbpro_estimation_state_") {
  epoch:EstimationEpoch;
  state:[double:6];
  covariance:[double:36];
  residual_rms:double;
  recovered_noise_sigma:double;
  iteration_count:uint;
  accepted_count:uint;
  rejected_count:uint;
  reference_frame:orbpro.propagator.ReferenceFrame;
  converged:ubyte;
  smoothed:ubyte;
  estimator:EstimatorKind;
}

struct FilterEpoch (abi, abi_c_name: "OrbProFilterEpoch", abi_c_helper_prefix: "orbpro_filter_epoch_") {
  epoch:EstimationEpoch;
  filtered_state:[double:6];
  filtered_covariance:[double:36];
  smoothed_state:[double:6];
  smoothed_covariance:[double:36];
  normalized_innovation_squared:double;
}

/// State and state-transition matrix supplied by the propagator port. The STM
/// maps deviations at the estimator epoch to this sample epoch.
struct EstimationPropagatorSample (abi, abi_c_name: "OrbProEstimationPropagatorSample", abi_c_helper_prefix: "orbpro_estimation_propagator_sample_") {
  epoch:EstimationEpoch;
  state:[double:6];
  stm:[double:36];
}

struct InitialOrbitRequest (abi, abi_c_name: "OrbProInitialOrbitRequest", abi_c_helper_prefix: "orbpro_initial_orbit_request_") {
  // Three inertial position vectors for Gibbs and Herrick-Gibbs.
  positions_m:[double:9];
  // Three observer positions followed by the three topocentric angle pairs
  // used by Gauss and Laplace. The method selects which input set is read.
  observer_positions_m:[double:9];
  right_ascensions_rad:[double:3];
  declinations_rad:[double:3];
  epochs:EstimationEpoch;
  interval_12_seconds:double;
  interval_23_seconds:double;
  gravitational_parameter_m3_s2:double;
  method:InitialOrbitKind;
}

struct InitialOrbitResult (abi, abi_c_name: "OrbProInitialOrbitResult", abi_c_helper_prefix: "orbpro_initial_orbit_result_") {
  epoch:EstimationEpoch;
  state:[double:6];
  iterations:uint;
  reference_frame:orbpro.propagator.ReferenceFrame;
  status:EstimationStatus;
}

/// Request/result wire. observations are decoded from $TDM/$CRD before they
/// cross this family boundary; their source record identifiers remain on the
/// request for a complete provenance trail.
table EstimationRequest {
  config:EstimationConfig;
  observations:[EstimationObservation];
  error_models:[EstimationErrorModel];
  source_record_ids:[string];
  propagator_port_id:string (required);
  propagator_capability:string (required);
  trace_id:string;
  options:SequentialOptions;
  extended_observations:[ExtendedObservation];
  batch_options:BatchFitOptions;
}

table EstimationResult {
  status:EstimationStatus = OK;
  estimate:EstimationState;
  filter_history:[FilterEpoch];
  residuals:[double];
  /// Row-major 6x6 covariance blocks, one per batch iteration, in iteration
  /// order. Empty for sequential estimators.
  iteration_covariances:[double];
  rejected_observation_indices:[uint];
  odr_record:[ubyte];
  ocm_record:[ubyte];
  error_message:string;
  trace_id:string;
  extended_history:[ExtendedFilterEpoch];
  propagation_requests:[PropagationQuery];
  batch_fit:BatchFitResult;
  // Extension v3: per-observation support diagnostics and the final support
  // state (ESPF_2025, ESPF_2026, ELLIPSOIDAL_SET_MEMBERSHIP).
  support_history:[SupportEpoch];
  final_support:SupportState;
}

table EstimationEnvelope {
  request:EstimationRequest;
  result:EstimationResult;
  propagator_samples:[EstimationPropagatorSample];
  simulated_observations:[EstimationObservation];
  initial_orbit_request:InitialOrbitRequest;
  initial_orbit_result:InitialOrbitResult;
  propagation_answers:[PropagationAnswer];
  // Extension v3: the TEAG primitives (method evaluate_teag).
  teag_request:TeagRequest;
  teag_result:TeagResult;
}

root_type EstimationEnvelope;
file_identifier "$EST";

// Module-local append-only extension v1. All legacy structs remain byte-exact.
table SequentialOptions {
  ukf_alpha:double = 1;
  ukf_beta:double = 2;
  ukf_kappa:double = 0;
  nonlinear_propagation:bool = false;
  smooth:bool = false;
  adaptive_process_noise:bool = false;
  inflate_measurement_noise:bool = false;
  adaptation_rate:double = 0.05;
  minimum_process_scale:double = 0.01;
  maximum_process_scale:double = 100;
  maximum_measurement_scale:double = 100;
  estimate_clock:bool = false;
  initial_clock_bias_m:double = 0;
  initial_clock_drift_mps:double = 0;
  // Required 8x8 row-major covariance when estimate_clock=true; includes orbit.
  initial_covariance8:[double];
  clock_bias_psd:double = 0;
  clock_drift_psd:double = 0;
  // Extension v3: ESPF and set-membership options, and a support state to
  // start from (an arc split at an epoch continues exactly).
  espf:EspfOptions;
  set_membership:SetMembershipOptions;
  initial_support:SupportState;
}

table ExtendedObservation {
  observation:EstimationObservation (required);
  // Exactly value_count lanes (1..6); replaces the legacy four-lane arrays.
  values:[double] (required);
  sigmas:[double] (required);
  // LINEAR only: row-major value_count x state_dimension, y = H x + offset.
  linear_matrix:[double];
  linear_offset:[double];
  satellite_clock_bias_m:double = 0;
}

table ExtendedFilterEpoch {
  epoch:EstimationEpoch;
  state_dimension:ubyte = 6;
  filtered_state:[double];
  filtered_covariance:[double];
  smoothed_state:[double];
  smoothed_covariance:[double];
  normalized_innovation_squared:double;
  accepted:bool;
  process_noise_scale:double = 1;
  measurement_noise_scale:double = 1;
}

// Inverted propagator port. Replay the unchanged request plus all answers.
// A query's STM is relative to its seed epoch, not the original filter epoch.
// Caller routes queries to its selected C++ WASM provider, then echoes each
// query verbatim with the provider sample. No host physics is required.
table PropagationQuery {
  sequence:uint;
  seed:EstimationState (required);
  target_epoch:EstimationEpoch (required);
  // Extension v2 (fit_batch): the seed's dynamic parameters, in the order of
  // BatchFitOptions.parameter_kinds.
  parameter_values:[double];
}
table PropagationAnswer {
  query:PropagationQuery (required);
  sample:EstimationPropagatorSample (required);
  // Extension v2 (fit_batch): row-major 6 x p sensitivity of the sample state
  // to the seed's parameters (the S block of [[Phi, S], [0, I]]), SI.
  sensitivity:[double];
}

// Module-local append-only extension v2: batch least squares of the state at
// the configuration epoch plus dynamic parameters (fit_batch).
table BatchFitOptions {
  // The caller's propagator vocabulary for the solve-for parameters (for
  // propagator/hpop, PRW DYNAMIC_PARAMETERS ordinals); opaque to the module
  // and echoed in the result.
  parameter_kinds:[ubyte];
  // Their initial nominal (and a priori) values, SI.
  parameter_values:[double];
  // Optional row-major (6 + p)^2 a priori covariance of
  // [config.initial_state, parameter_values]; empty: no a priori information.
  apriori_covariance:[double];
  // Optional covariance per observation, value_count^2 row-major values
  // each, concatenated in observation order, replacing the sigmas.
  observation_covariances:[double];
  maximum_iterations:uint = 20;
  // Converged when the correction's length under the normal matrix,
  // sqrt(dx' N dx / (6 + p)), is below this (dimensionless).
  correction_tolerance:double = 1e-3;
  // Edit an observation whose whitened residual RMS exceeds this many times
  // the previous iteration's weighted RMS (at least 1); 0 disables editing.
  sigma_edit_threshold:double = 0;
  // Axes of observation_covariances: 0 the request axes, 1 the radial,
  // transverse and normal axes of each observed state (POSITION_VELOCITY).
  covariance_axes:ubyte = 0;
}

table BatchFitResult {
  state_dimension:ubyte;
  parameter_kinds:[ubyte];
  // [state at the configuration epoch, parameters], SI.
  estimate:[double];
  // Formal covariance (J' W J + P0^-1)^-1, row-major (6 + p)^2.
  covariance:[double];
  // The formal covariance times the reduced chi-square.
  scaled_covariance:[double];
  chi_square:double;
  reduced_chi_square:double;
  weighted_rms:double;
  measurement_count:uint;
  degrees_of_freedom:uint;
  iterations:uint;
  converged:bool;
  // Whitened post-fit residuals, one per scalar measurement of each accepted
  // and rejected observation, linearized at the final correction.
  whitened_residuals:[double];
  rejected_observation_indices:[uint];
}

// Module-local append-only extension v3: the Epistemic Support-Point Filter
// (ESPF 2025: Jah and Haslett, arXiv 2508.20806; ESPF 2026: Jah 2026, TEAG
// and ESPF-HJ, preprints 202603.2010 and 202603.2110, and arXiv 2603.10065),
// the ellipsoidal set-membership filter, and the TEAG primitives. Each
// default is a value a paper states or a recorded choice (docs/espf-spec.md).
table EspfOptions {
  // Smolyak Clenshaw-Curtis level; 0 = the variant's default (2025: 2, 2026: 3).
  smolyak_level:ubyte = 0;
  // r0: the initial admissible set {(x - x0)' P0^-1 (x - x0) <= r0^2} with P0
  // the configuration's initial covariance (2025: its bounding box).
  initial_bound_scale:double = 3;
  // k_w: the process-noise set has shape k_w^2 Q (Q of process_noise).
  process_bound_scale:double = 1;
  // k_y: the sensor set Pi_y has shape k_y^2 R (R from the sigmas).
  measurement_bound_scale:double = 1;
  // 2026 sigma controller (ESPF-HJ section 6: r+ = 1.15, r- = 0.97).
  sigma_initial:double = 1;
  sigma_min:double = 0.1;
  sigma_max:double = 1;
  rate_expand:double = 1.15;
  rate_contract:double = 0.97;
  // N_min; 0 = 2n + 1 (2603.10065 Definition 2.1).
  minimum_survivors:uint = 0;
  // PCRB dimension: 0 the state dimension n (TEAG Theorem 4.5), 1 the
  // measurement rank m (rank-aware PCRB, preprints 202607.2165).
  pcrb_rank:ubyte = 0;
  // Medoid metric: 0 the MVEE of the survivors (TEAG section 5.1, eq. 3),
  // 1 the whitened innovation metric (ESPF-HJ eq. 48).
  medoid_metric:ubyte = 0;
  // Volumetric faithfulness: eigenvalues of the regeneration shape at least
  // this fraction of the largest.
  vfi_floor_ratio:double = 1e-12;
  mvee_tolerance:double = 1e-7;
  mvee_max_iterations:uint = 20000;
  // Truncated possibilistic entropy per epoch (costly; diagnostics only).
  entropy_diagnostics:bool = false;
  // Emit each epoch's survivors and possibilities in SupportEpoch.
  record_support:bool = false;
  // 2025: plausibility radius r = sqrt(-2 log(1 - eta)); 3 is eta = 1 - e^-4.5.
  plausibility_radius:double = 3;
  compatibility_floor:double = 1e-6;
  surprisal_threshold:double = 1;
  // Spread regularization Pi + eps diag(Pi) (relative) or Pi + eps I (SI).
  regularization:double = 1e-6;
  regularization_relative:bool = true;
  spread_sigma0:double = 1;
  spread_sigma_min:double = 0;
  spread_sigma_max:double = 1e300;
  dispersion_gain:double = 0;
  surprisal_gain:double = 0;
  surprisal_reference:double = 0;
  surprisal_scale:double = 1;
  radius_gain_expand:double = 0;
  radius_gain_contract:double = 0;
  // Temporal decay exp(-decay_rate tau), tau the assimilated observation count.
  decay_rate:double = 0.05;
  // Mode weights w ~ pi N: 0 N = the residual possibility exp(-d^2/2),
  // 1 N = the singleton necessity, 2 N = the compatibility.
  mode_weighting:ubyte = 0;
  // The 2025 appendix's Gaussian limit: unscented points, product fusion.
  gaussian_limit:bool = false;
  // 2026 sigma controller: expand when the realised support contraction
  // reaches this fraction of the PCRB floor (1: the floor itself; ESPF-HJ
  // section 6 says "approaching"; docs/espf-spec.md G18).
  pcrb_trigger:double = 1;
}

table SetMembershipOptions {
  initial_bound_scale:double = 3;
  process_bound_scale:double = 3;
  measurement_bound_scale:double = 3;
  // 0 minimum trace, 1 minimum log det of the outer bounding ellipsoid.
  criterion:ubyte = 0;
}

table SupportState {
  epoch:EstimationEpoch;
  estimator:EstimatorKind;
  dimension:ubyte = 6;
  // count x 6, SI, request frame, at epoch.
  points:[double];
  possibility:[double];
  estimate:[double];
  // Row-major 6 x 6: the set carried forward.
  shape:[double];
  sigma:double = 1;
  radius:double = 3;
  dispersion:double;
  steps:uint;
}

table SupportEpoch {
  epoch:EstimationEpoch;
  estimate:[double];
  // Posterior set: 2026 the MVEE of the survivors; 2025 the spread matrix;
  // set-membership the bounding ellipsoid. Shapes, not covariances.
  shape:[double];
  carried_shape:[double];
  predicted_shape:[double];
  support_count:uint;
  survivor_count:uint;
  medoid_index:int = -1;
  choquet_surprisal:double;
  information:double;
  normalization_shift:double;
  minimum_whitened_innovation:double;
  basin_radius:double;
  basin_threshold:double;
  pcrb_floor:double;
  log_volume_change:double;
  sigma:double;
  radius:double;
  dispersion:double;
  mean_surprisal:double;
  regime_log_det:double;
  entropy:double;
  entropy_alpha:double;
  inconsistent:bool;
  accepted:bool = true;
  survivors:[double];
  survivor_possibility:[double];
}

// The TEAG primitives on a finite support (method evaluate_teag). Every
// output whose inputs are present is computed; the rest are left empty.
table TeagRequest {
  dimension:ubyte;
  // count x dimension.
  points:[double];
  // Phi- per point (default 0, full prior possibility).
  prior_impossibility:[double];
  // psi per point; absent: half the whitened squared innovation below.
  surprisal:[double];
  whitened_squared_innovation:[double];
  // Membership masks, event_count x count row-major (1 = in the event).
  events:[ubyte];
  event_count:uint;
  alpha_levels:[double];
  front_tolerance:double = 0;
  // Medoid subset (default every point) and metric shape (n x n; default the
  // MVEE of the subset).
  subset:[uint];
  metric_shape:[double];
  // PCRB: 0 = dimension; prior whitened radius r-.
  effective_dimension:uint;
  prior_radius:double = 1;
  smolyak_dimension:ubyte;
  smolyak_level:ubyte;
  shape_a:[double];
  shape_b:[double];
  mvee_tolerance:double = 1e-9;
  mvee_max_iterations:uint = 100000;
  entropy:bool = false;
  minimum_count:uint;
  // Compute the MVEE of every point (also for the medoid default metric).
  mvee:bool = false;
}

table TeagResult {
  posterior_impossibility:[double];
  rescaled_impossibility:[double];
  normalization_shift:double;
  // -1 history-governed, 0 the active front, +1 evidence-governed.
  zones:[byte];
  // Concatenated alpha-cut index lists and their start offsets.
  alpha_cuts:[uint];
  alpha_cut_offsets:[uint];
  // Possibility and necessity of each event on the rescaled posterior field
  // (on the prior field when no surprisal is given).
  event_possibility:[double];
  event_necessity:[double];
  choquet_surprisal:double;
  information:double;
  basin_radius:double;
  basin_threshold:double;
  basin_unit_survivors:uint;
  pcrb_floor:double;
  mvee_center:[double];
  mvee_shape:[double];
  mvee_iterations:uint;
  mvee_gap:double;
  mvee_log_volume:double;
  medoid:int = -1;
  medoid_radius:double;
  smolyak_points:[double];
  minkowski_shape:[double];
  entropy:double;
  support_entropy:double;
  entropy_alpha:double;
}
