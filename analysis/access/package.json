{
  "name": "space-data-network-plugin-access",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "src/",
    "index.js",
    "flowHandlers.js",
    "manifest.js",
    "plugin-manifest.json"
  ],
  "sdn-module": "./dist/isomorphic/module.wasm",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/accessAnalyzer.test.mjs tests/*.test.mjs",
    "test:sdk-compat": "node --test tests/sdk_compat.test.mjs",
    "check:compliance": "node check-compliance.mjs",
    "test:parity": "node tests/parity.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "flatbuffers": "25.9.23",
    "flatc-wasm": "26.1.32",
    "space-data-module-sdk": "0.8.18",
    "spacedatastandards.org": "^1.219.0"
  }
}
