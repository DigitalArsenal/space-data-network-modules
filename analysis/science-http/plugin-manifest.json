{
  "pluginId": "com.digitalarsenal.analysis.science-http",
  "name": "Science HTTP envelope adapter",
  "version": "0.1.0",
  "description": "Typed HTTP transport for CQR screening. Numerical work is performed by the connected science module.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "route",
      "displayName": "Decode science HTTP request",
      "inputPorts": [
        {
          "portId": "http",
          "acceptedTypeSets": [
            {
              "setId": "http-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "CQR.fbs",
                  "fileIdentifier": "$CQR",
                  "rootTypeName": "CQR"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "respond",
      "displayName": "Encode science HTTP response",
      "inputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "result-typed",
              "allowedTypes": [
                {
                  "schemaName": "CQR.fbs",
                  "fileIdentifier": "$CQR",
                  "rootTypeName": "CQR"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 64,
      "drainPolicy": "drain-to-empty"
    }
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Copies one bounded CQR payload into or out of an HTTP envelope; no computation or worker creation."
  }
}
