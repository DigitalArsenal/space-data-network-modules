{
  "pluginId": "com.digitalarsenal.analysis.density-calibration",
  "name": "Thermospheric density calibration",
  "version": "0.6.0",
  "description": "JB2008 thermospheric mass density at points (propagator/ffm's JB2008, driven by SET SOLFSMY/DTCFILE rows as ffm reads them) with an exospheric-temperature correction added to JB2008's DSTDTC: spherical harmonics in latitude and local solar time per time bin, or values at time nodes, optionally linear in altitude. Estimates the correction from observed densities (Gauss-Newton on log-density residuals per bin) or from the orbital decay of catalogued objects (element-set histories propagated by Vallado SGP4; Gauss-Newton on the sets' mean semi-major axes with each object's ballistic coefficient): public, simplified analogues of the Dynamic Calibration of the Atmosphere in HASDM; the orbital energy of states in Earth-fixed axes (the Jacobi integral of the EGM2008 geopotential, with its gradient) and the work done by JB2008 drag along them. Typed contracts 1.0: every method takes one SDS $DCL (Density Calibration) record and answers with one $DCL: the model in ATMOSPHERE ($ATM JB08 or NRLMSIS00E), the JB2008 drivers as $PRW PRWJB2008IndicesTable rows or NRLMSISE-00's daily $SPW rows, element-set histories as $OMM, states as an $OEM ephemeris block, times in Unix milliseconds (UTC). calibrate_log_density ports the E13 single-fleet random-walk common mode to WASM for NRLMSISE-00, with explicit 48-hour forecast nodes and SDS PVN.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Deterministic density evaluation, SGP4 propagation and least squares over caller-supplied points, element sets, drivers and observations. No host calls, threads or network access."
  },
  "schemasUsed": [
    {
      "schemaName": "DCL.fbs",
      "fileIdentifier": "$DCL",
      "rootTypeName": "DCL",
      "wireFormat": "flatbuffer"
    },
    {
      "schemaName": "PRW.fbs",
      "fileIdentifier": "$PRW",
      "rootTypeName": "PRW",
      "wireFormat": "flatbuffer"
    },
    {
      "schemaName": "OEM.fbs",
      "fileIdentifier": "$OEM",
      "rootTypeName": "OEM",
      "wireFormat": "flatbuffer"
    }
  ],
  "methods": [
    {
      "methodId": "evaluate",
      "displayName": "Evaluate JB2008 with a temperature correction",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "dcl-evaluate-request",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "POINTS (TIME_MS, LATITUDE_DEG, LONGITUDE_DEG, ALTITUDE_KM; or with SUN_RIGHT_ASCENSION_DEG, SUN_DECLINATION_DEG and MODEL_DRIVERS, the arguments of SET's JB2008 subroutine), ATMOSPHERE with its drivers (JB2008_DRIVERS or SPACE_WEATHER), CORRECTION (Harmonic or Nodes; JB2008 only), SETTINGS WANT_DERIVATIVE and WANT_SUN_DIAGNOSTICS."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "$DCL evaluation request."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "dcl-evaluate-result",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "PRODUCT DensityEvaluation: POINTS with DENSITY_KG_M3 (NaN = refused), DELTA_T_K, LOCAL_SOLAR_TIME_H, DLN_DENSITY_DT_PER_K and SUN_LONGITUDE/LATITUDE_DEG when asked, REFUSED."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Density per point ($DCL)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "calibrate",
      "displayName": "Estimate temperature corrections from observed densities",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "dcl-calibrate-request",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "POINTS with OBSERVED_DENSITY_KG_M3 (and WEIGHT), JB2008_DRIVERS (or MODEL_DRIVERS), SETTINGS FROM_MS, TO_MS, DEGREE, BIN_S, LOG_DENSITY_SIGMA, PRIOR_SIGMA_K, MIN_POINTS, MAX_ITERATIONS, EDIT_SIGMA (< 0: no editing)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "$DCL density-calibration request."
        }
      ],
      "outputPorts": [
        {
          "portId": "calibration",
          "acceptedTypeSets": [
            {
              "setId": "dcl-calibrate-calibration",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "PRODUCT DensityCalibration: CORRECTION Harmonic, one segment per bin with COEFFICIENTS_K, SIGMAS_K and its FIT; SETTINGS as applied."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The harmonic correction per bin ($DCL)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "decay",
      "displayName": "Orbital decay of element sets under JB2008",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "dcl-decay-request",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "JB2008_DRIVERS, OBJECTS [{ID, ELEMENT_SETS ($OMM: EPOCH, MEAN_MOTION, ECCENTRICITY, INCLINATION, RA_OF_ASC_NODE, ARG_OF_PERICENTER, MEAN_ANOMALY, BSTAR), BALLISTIC_COEFFICIENT_M2_KG, SPAN_S}], CORRECTION (Nodes), SETTINGS STEP_S, MAX_GAP_S, WANT_SAMPLES."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "$DCL orbital-decay request."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "dcl-decay-result",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "PRODUCT OrbitalDecay: per object the sets' mean semi-major axes, perigee heights, cumulative drag decay, per segment the decay and mean altitude, and SAMPLE_* when asked."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Drag decay per object ($DCL)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "calibrate_decay",
      "displayName": "Estimate temperature corrections and ballistic coefficients from element-set histories",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "dcl-calibrate-decay-request",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "JB2008_DRIVERS, OBJECTS [{ID, ELEMENT_SETS ($OMM), LN_B_PRIOR_MEAN, LN_B_PRIOR_SIGMA}], SETTINGS FROM_MS, TO_MS, NODE_STEP_S, NODE_ALTITUDES_KM, RANDOM_WALK_K_PER_SQRT_DAY, MEAN_LEVEL_K, ALTITUDE_DIFFERENCE_K, STEP_S, MAX_GAP_S, RESIDUAL_FLOOR_M, EDIT_SIGMA, MAX_ITERATIONS, REWEIGHT_ITERATIONS, TOLERANCE_K/LN_B/OFFSET_M, MIN_SETS, WANT_RESIDUALS."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "$DCL decay-calibration request."
        }
      ],
      "outputPorts": [
        {
          "portId": "calibration",
          "acceptedTypeSets": [
            {
              "setId": "dcl-calibrate-decay-calibration",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "PRODUCT DecayCalibration: CORRECTION Nodes (values and sigmas), per object ln B, its sigma, B, residual scale and fit, skipped objects with SKIPPED_REASON, FIT, LEVELS, HISTORY, LEVEL_LN_B_CORRELATION, MEAN_LEVEL_SIGMA_K."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The node correction and ballistic coefficients ($DCL)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "energy",
      "displayName": "Specific orbital energy in Earth-fixed axes (EGM2008 Jacobi integral)",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "dcl-energy-request",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "STATES (EPHEMERIS: an $OEM ephemeris block, GCRF km and km/s; DUT1_S, POLAR_MOTION_X/Y_ARCSEC), GRAVITY_DEGREE (2-70; 0 = 36), GRAVITY_ORDER (0 = the degree), GM_M3_S2, EARTH_ROTATION_RAD_S, SETTINGS WANT_GRADIENT."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "$DCL orbital-energy request."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "dcl-energy-result",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "PRODUCT OrbitalEnergy: STATES ENERGY_J_KG, KINETIC/POTENTIAL/ROTATIONAL_J_KG, RELATIVE_SPEED_M_S, the WGS84 geodetic point, ENERGY_GRADIENT when asked, REFUSED."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The Jacobi integral per state ($DCL)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "drag_work",
      "displayName": "Drag power and work along states (JB2008 with a temperature correction)",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "dcl-drag-work-request",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "STATES (EPHEMERIS), ATMOSPHERE with its drivers, CORRECTION (JB2008 only), BALLISTIC_COEFFICIENT_M2_KG, EARTH_ROTATION_RAD_S."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "$DCL drag-work request."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "dcl-drag-work-result",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "PRODUCT DragWork: STATES DENSITY_KG_M3, RELATIVE_SPEED_M_S, DRAG_POWER_W_KG, DRAG_WORK_J_KG, CUMULATIVE_DRAG_WORK_J_KG, REFUSED."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Drag power and work per state ($DCL)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "calibrate_log_density",
      "displayName": "E13 NRLMSISE-00 fleet log-density correction",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "dcl-log-density-request",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Private E13 NRLMSISE-00 energy-arc fits in OBJECTS (ID, FIRST_MS, LAST_MS, LN_B, LN_B_SIGMA, BALLISTIC_COEFFICIENT_M2_KG, OK), ATMOSPHERE NRLMSIS00E, CREATED_AT_MS issue time. Causal 30-day window, six-hour latency."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "$DCL density-calibration request."
        }
      ],
      "outputPorts": [
        {
          "portId": "calibration",
          "acceptedTypeSets": [
            {
              "setId": "dcl-log-density-result",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Aggregate LogDensityNodes correction only, SETTINGS.TO_MS last solve, hourly decay nodes through 48 hours, PVN. No operator states or object fits."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The harmonic correction per bin ($DCL)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "fit_energy_arcs",
      "displayName": "Fit private E13 NRLMSISE-00 energy arcs",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "required": true,
          "minStreams": 1,
          "maxStreams": 36
        },
        {
          "portId": "kernel",
          "acceptedTypeSets": [
            {
              "setId": "kernel-typed",
              "allowedTypes": [
                {
                  "schemaName": "PRW.fbs",
                  "fileIdentifier": "$PRW",
                  "rootTypeName": "PRW",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "required": true,
          "minStreams": 1,
          "maxStreams": 1
        },
        {
          "portId": "earth_orientation",
          "acceptedTypeSets": [
            {
              "setId": "earth_orientation-typed",
              "allowedTypes": [
                {
                  "schemaName": "PRW.fbs",
                  "fileIdentifier": "$PRW",
                  "rootTypeName": "PRW",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "required": true,
          "minStreams": 1,
          "maxStreams": 1
        },
        {
          "portId": "space_weather",
          "acceptedTypeSets": [
            {
              "setId": "space_weather-typed",
              "allowedTypes": [
                {
                  "schemaName": "PRW.fbs",
                  "fileIdentifier": "$PRW",
                  "rootTypeName": "PRW",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "required": true,
          "minStreams": 1,
          "maxStreams": 1
        }
      ],
      "outputPorts": [
        {
          "portId": "arcs",
          "acceptedTypeSets": [
            {
              "setId": "arcs-typed",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "required": true,
          "minStreams": 1,
          "maxStreams": 1
        }
      ],
      "maxBatch": 36,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "prepare_operator_states",
      "displayName": "Convert private operator TT / EME2000 states",
      "inputPorts": [
        {
          "portId": "operator_states",
          "acceptedTypeSets": [
            {
              "setId": "operator_states-typed",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "required": true,
          "minStreams": 1,
          "maxStreams": 1
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "DCL.fbs",
                  "fileIdentifier": "$DCL",
                  "rootTypeName": "DCL",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "required": true,
          "minStreams": 1,
          "maxStreams": 36
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
