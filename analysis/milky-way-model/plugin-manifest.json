{
  "pluginId": "com.digitalarsenal.analysis.milky-way-model",
  "name": "Milky Way volumetric model",
  "version": "0.5.0",
  "description": "Deterministic C++ shared-memory Milky Way emissivity, extinction and statistical model products: luminosity-weighted discs, spiral arm light, bar and bulge, Drimmel & Spergel 2001 dust and an optional local 3D dust map delivered as SDS rows (load_dust_map); BP/RP extinction ratios, an absolute radiance scale and face-on metrics; SDS PCE typed parameters and arena layouts.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
