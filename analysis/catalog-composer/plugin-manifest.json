{
  "pluginId": "com.digitalarsenal.analysis.catalog-composer",
  "name": "Catalog Editor",
  "version": "0.4.0",
  "description": "Compose immutable CAT snapshots with explicit source precedence, identifier conflict review and per-object orbital-state source selection; integrate the composed catalog with every source's products: identity links tested on trajectories, the product chosen by measured error, its covariance and label, merged maneuvers. Recipes, requests and reports are SDS $XMT (Catalog Cross-Match).",
  "pluginFamily": "analysis",
  "capabilities": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "compose",
      "displayName": "Compose catalogs",
      "inputPorts": [
        {
          "portId": "recipe",
          "acceptedTypeSets": [
            {
              "setId": "xmt-compose-recipe",
              "allowedTypes": [
                {
                  "schemaName": "XMT.fbs",
                  "fileIdentifier": "$XMT",
                  "rootTypeName": "XMT",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "One size-prefixed $XMT with COMPOSE_RECIPE set."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One size-prefixed $XMT with COMPOSE_RECIPE set."
        },
        {
          "portId": "catalogs",
          "acceptedTypeSets": [
            {
              "setId": "catalogs-v1",
              "allowedTypes": [
                {
                  "schemaName": "CAT.fbs",
                  "fileIdentifier": "$CAT",
                  "rootTypeName": "CAT",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical size-prefixed CAT streams, one per recipe layer in the same order."
            }
          ],
          "minStreams": 1,
          "maxStreams": 16,
          "required": true,
          "description": "Canonical size-prefixed CAT streams, one per recipe layer in the same order."
        }
      ],
      "outputPorts": [
        {
          "portId": "catalog",
          "acceptedTypeSets": [
            {
              "setId": "catalog-v1",
              "allowedTypes": [
                {
                  "schemaName": "CAT.fbs",
                  "fileIdentifier": "$CAT",
                  "rootTypeName": "CAT",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Selected CAT records with original bytes preserved; unresolved identifier conflicts are excluded."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Selected CAT records with original bytes preserved; unresolved identifier conflicts are excluded."
        },
        {
          "portId": "report",
          "acceptedTypeSets": [
            {
              "setId": "xmt-compose-report",
              "allowedTypes": [
                {
                  "schemaName": "XMT.fbs",
                  "fileIdentifier": "$XMT",
                  "rootTypeName": "XMT",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "One size-prefixed $XMT with COMPOSE_REPORT set."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One size-prefixed $XMT with COMPOSE_REPORT set."
        }
      ],
      "maxBatch": 17,
      "drainPolicy": "single-shot"
    },
