        },
        {
          "portId": "seed",
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "acceptedTypeSets": [
            {
              "setId": "seed",
              "allowedTypes": [
                {
                  "schemaName": "OPM.fbs",
                  "fileIdentifier": "$OPM",
                  "rootTypeName": "OPM"
                }
              ]
            }
          ]
        },
        {
