{
  "pluginId": "com.digitalarsenal.analysis.body-appearance",
  "name": "Body appearance",
  "version": "0.1.0",
  "description": "Cited body parameters, deterministic surface populations, asteroid photometry, and solar differential rotation. Incomplete planetary calibration is refused.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Each invocation is a bounded deterministic transform of its typed input; the module owns no background workers or mutable simulation state."
  },
  "schemasUsed": [
