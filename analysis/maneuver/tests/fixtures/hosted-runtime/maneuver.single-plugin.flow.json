{
  "programId": "com.digitalarsenal.examples.maneuver-single-plugin-flow",
  "name": "Maneuver Single Plugin Flow",
  "version": "0.1.0",
  "nodes": [
    {
      "nodeId": "maneuver",
      "pluginId": "maneuver-planner",
      "methodId": "invoke",
      "kind": "transform",
      "drainPolicy": "drain-to-empty"
    }
  ],
  "edges": [],
  "triggers": [
    {
      "triggerId": "manual-request",
      "kind": "manual",
      "source": "user"
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "manual-request",
      "targetNodeId": "maneuver",
      "targetPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 16
    }
  ],
  "requiredPlugins": ["maneuver-planner"],
  "description": "Minimal hosted-runtime example invoking the maneuver plugin through the canonical command bridge."
}
