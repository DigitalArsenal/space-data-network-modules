{
  "name": "@spacedatanetwork/client-decrypt",
  "version": "0.1.0",
  "description": "SDN client decryption module — decrypts X25519 ECIES artifact envelopes using Crypto++",
  "private": true,
  "type": "module",
  "main": "index.js",
  "sdn-module": "./dist/isomorphic/module.wasm",
  "exports": {
    ".": "./index.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "index.js",
    "build.mjs",
    "src/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:clean": "rm -rf .build dist && node build.mjs",
    "test": "node test/api.test.mjs && node test/decrypt.test.mjs && node test/e2e-roundtrip.test.mjs && node test/protected-publication-trailer.test.mjs"
  },
  "devDependencies": {
    "blockstore-core": "^6.1.2",
    "datastore-core": "^11.0.2",
    "@helia/unixfs": "^7.1.0",
    "helia": "^6.0.22",
    "flatc-wasm": "^26.1.32",
    "space-data-module-sdk": "0.8.23"
  },
  "keywords": ["sdn", "wasm", "decryption", "x25519", "ecies", "aes-gcm"],
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalArsenal/space-data-network-plugin-client-decrypt"
  }
}
