{
  "programId": "com.digitalarsenal.examples.atmosphere-single-plugin-flow",
  "name": "Atmosphere Single Plugin Flow",
  "version": "0.1.0",
  "nodes": [
    {
      "nodeId": "atmosphere",
      "pluginId": "atmosphere-model",
      "methodId": "query_atmosphere_state_batch",
      "kind": "transform",
      "drainPolicy": "drain-to-empty"
    }
  ],
  "edges": [],
  "triggers": [
    {
      "triggerId": "manual-request",
      "kind": "manual",
      "source": "user"
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "manual-request",
      "targetNodeId": "atmosphere",
      "targetPortId": "atmosphere",
      "backpressurePolicy": "queue",
      "queueDepth": 16
    }
  ],
  "requiredPlugins": [
    "atmosphere-model"
  ],
  "description": "Minimal hosted-runtime example sending an SDS $HFC atmosphere query to the atmosphere plugin."
}
