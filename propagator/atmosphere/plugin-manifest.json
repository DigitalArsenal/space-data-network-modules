{
  "pluginId": "atmosphere-model",
  "name": "Atmosphere Plugin",
  "version": "0.1.0",
  "description": "Atmospheric model queries exposed through a canonical SDK command bridge.",
  "pluginFamily": "analysis",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": ["direct", "command"],
  "runtimeTargets": ["browser", "wasi", "wasmedge"],
  "methods": [
    {
      "methodId": "invoke",
      "displayName": "Invoke Atmosphere Operation",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "any-flatbuffer",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }],
              "wildcardJustification": {
                "kind": "foreign-wire-format",
                "detail": "Legacy command bridge: the frame is a UTF-8 JSON operation envelope, not an SDS record.",
                "mediaType": "application/json"
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "any-flatbuffer",
              "allowedTypes": [{ "acceptsAnyFlatbuffer": true }],
              "wildcardJustification": {
                "kind": "foreign-wire-format",
                "detail": "Legacy command bridge: the frame is a UTF-8 JSON operation envelope, not an SDS record.",
                "mediaType": "application/json"
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "query_atmosphere_state_batch",
      "displayName": "Query Atmosphere State Batch",
      "inputPorts": [
        {
          "portId": "atmosphere",
          "acceptedTypeSets": [
            {
              "setId": "hfc-atmosphere-query",
              "allowedTypes": [
                { "schemaName": "HFC.fbs", "fileIdentifier": "$HFC", "rootTypeName": "HFC" },
                {
                  "schemaName": "HFC.fbs",
                  "fileIdentifier": "$HFC",
                  "rootTypeName": "HFC",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "space_weather",
          "acceptedTypeSets": [
            {
              "setId": "spw-space-weather",
              "allowedTypes": [
                { "schemaName": "SPW.fbs", "fileIdentifier": "$SPW", "rootTypeName": "SPW" },
                {
                  "schemaName": "SPW.fbs",
                  "fileIdentifier": "$SPW",
                  "rootTypeName": "SPW",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 64,
          "required": false
        }
      ],
      "outputPorts": [
        {
          "portId": "states",
          "acceptedTypeSets": [
            {
              "setId": "hfc-states",
              "allowedTypes": [
                { "schemaName": "HFC.fbs", "fileIdentifier": "$HFC", "rootTypeName": "HFC" },
                {
                  "schemaName": "HFC.fbs",
                  "fileIdentifier": "$HFC",
                  "rootTypeName": "HFC",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "ocm_state_to_drag_acceleration_oem",
      "displayName": "OCM State To Atmospheric Drag Acceleration OEM",
      "inputPorts": [
        {
          "portId": "vector_state",
          "acceptedTypeSets": [
            {
              "setId": "ocm-vector-state",
              "allowedTypes": [
                { "schemaName": "OCM.fbs", "fileIdentifier": "$OCM", "rootTypeName": "OCM" },
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "drag_acceleration",
          "acceptedTypeSets": [
            {
              "setId": "oem-drag-acceleration",
              "allowedTypes": [
                { "schemaName": "OEM.fbs", "fileIdentifier": "$OEM", "rootTypeName": "OEM" },
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "aligned-binary",
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
