{
  "programId": "com.digitalarsenal.examples.ffm-single-plugin-flow",
  "name": "FFM Single Plugin Flow",
  "version": "0.1.0",
  "nodes": [
    {
      "nodeId": "ffm",
      "pluginId": "ffm-propagator",
      "methodId": "invoke",
      "kind": "transform",
      "drainPolicy": "drain-to-empty"
    }
  ],
  "edges": [],
  "triggers": [
    {
      "triggerId": "manual-request",
      "kind": "manual",
      "source": "user"
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "manual-request",
      "targetNodeId": "ffm",
      "targetPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 16
    }
  ],
  "requiredPlugins": ["ffm-propagator"],
  "description": "Minimal hosted-runtime example invoking the FFM propagator plugin through the canonical command bridge."
}
