{
  "name": "@orbpro/plugin-ffm",
  "version": "2.0.3",
  "description": "OrbPro FFM (Full Force Model) propagator",
  "type": "module",
  "sdn-module": "./dist/isomorphic/module.wasm",
  "scripts": {
    "test": "node scripts/e2e-ffm.mjs",
    "test:sdk-compat": "node --test tests/sdk_compat.test.mjs",
    "test:orekit": "node --test tests/orekit_reference.test.mjs",
    "test:xval": "node --test tests/xval_reference.test.mjs",
    "orekit:summary": "node tests/orekit-summary.mjs",
    "xval:summary": "node tests/xval-summary.mjs",
    "test:stm": "node --test tests/force_partials.test.mjs tests/variational.test.mjs tests/variational_controls.test.mjs tests/variational_invoke.test.mjs",
    "test:stm-parity": "node tests/variational-parity.mjs",
    "bench:stm": "node tests/variational-benchmark.mjs",
    "check:sdk-build": "node build.mjs",
    "test:finite": "node --test tests/finite_burn.test.mjs tests/finite_burn_invoke.test.mjs",
    "test:finite-parity": "node tests/finite-burn-parity.mjs",
    "build": "node build.mjs",
    "check:compliance": "node check-compliance.mjs",
    "generate:bindings": "node generate-sds-bindings.mjs"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./dist/*": "./dist/*",
    "./catalog-configuration": "./catalog-configuration.mjs"
  },
  "files": [
    "dist/",
    "src/",
    "index.js",
    "catalog.mjs",
    "catalog-configuration.mjs"
  ],
  "devDependencies": {
    "esbuild": "0.28.0",
    "flatbuffers": "^25.9.23",
    "flatc-wasm": "^26.1.32",
    "playwright": "1.61.1",
    "space-data-module-sdk": "0.9.12",
    "spacedatastandards.org": "1.271.0"
  },
  "keywords": [
    "orbpro",
    "wasm",
    "ffm",
    "plugin",
    "propagator",
    "orbital-mechanics",
    "high-precision"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalArsenal/space-data-network-plugin-ffm"
  },
  "license": "Apache-2.0",
  "overrides": {
    "hd-wallet-wasm": "2.1.2"
  }
}
