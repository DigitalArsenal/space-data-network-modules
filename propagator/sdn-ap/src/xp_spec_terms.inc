        + (A * ipow<2>(B)) * coef[35]
        + (ipow<3>(B)) * coef[36]
        + (ipow<2>(A) * Cw) * coef[37]
        + (A * B * Cw) * coef[38]
        + (ipow<2>(B) * Cw) * coef[39]
        + (A) * coef[40]
        + (B) * coef[41]
        + (Cw) * coef[42]);
  six[4] += C2 * (
        (A * Cw) * coef[43]
        + (B * Cw) * coef[44])
    + C3 * (
        (ipow<2>(A) * Cw) * coef[45]
        + (A * B * Cw) * coef[46]
        + (ipow<2>(B) * Cw) * coef[47]
        + (Cw) * coef[48]);
  six[5] += C2 * (
        (ipow<2>(A)) * coef[49]
        + (A * B) * coef[50]
        + (ipow<2>(B)) * coef[51]
        + (A * Cw) * coef[52]
        + (B * Cw) * coef[53]
        + (1.0) * coef[54])
    + C3 * (
        (ipow<3>(A)) * coef[55]
        + (ipow<2>(A) * B) * coef[56]
        + (A * ipow<2>(B)) * coef[57]
        + (ipow<3>(B)) * coef[58]
        + (ipow<2>(A) * Cw) * coef[59]
        + (A * B * Cw) * coef[60]
        + (ipow<2>(B) * Cw) * coef[61]
        + (A) * coef[62]
        + (B) * coef[63]
        + (Cw) * coef[64]);
}

