        + (A) * coef[8]
        + (B) * coef[9]);
  six[1] += C2 * (
        (ipow<2>(A)) * coef[10]
        + (A * B) * coef[11]
        + (ipow<2>(B)) * coef[12]
        + (1.0) * coef[13])
    + C3 * (
        (ipow<3>(A)) * coef[14]
        + (ipow<2>(A) * B) * coef[15]
        + (A * ipow<2>(B)) * coef[16]
        + (ipow<3>(B)) * coef[17]
        + (ipow<2>(B)) * coef[18]
        + (A) * coef[19]
        + (B) * coef[20]);
  six[2] += C2 * (
        (A * Cw) * coef[21]
        + (B * Cw) * coef[22])
    + C3 * (
        (ipow<2>(A) * Cw) * coef[23]
        + (A * B * Cw) * coef[24]
