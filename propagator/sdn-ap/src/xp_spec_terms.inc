inline void output_six(const double* coef, double A, double B, double Cw, double C2, double C3, double* six) {
  six[0] += C2 * (
        (ipow<2>(A)) * coef[0]
        + (A * B) * coef[1]
        + (ipow<2>(B)) * coef[2]
        + (1.0) * coef[3])
    + C3 * (
        (ipow<3>(A)) * coef[4]
        + (ipow<2>(A) * B) * coef[5]
        + (A * ipow<2>(B)) * coef[6]
