  d[5] = 0.0;
  d[2] = Fs * (
        (Cw) * (3.0 * e * std::sin(O + w) / (2.0 * a * eta * n * (cinc1 + 1.0))));
  d[3] = Fs * (
        (Cw) * (3.0 * e * std::cos(O + w) / (2.0 * a * eta * n * (cinc1 + 1.0))));
  d[0] = Fs * (
        (A) * ((-3.0) * eta * std::sin(O + w) / (2.0 * a * n))
        + (B) * ((-3.0) * eta * std::cos(O + w) / (2.0 * a * n))
        + (Cw) * ((-3.0) * ipow<2>(e) * sinc1 * sw1 * std::sin(O + w) / (2.0 * a * eta * n * (cinc1 + 1.0))));
  d[1] = Fs * (
        (A) * (3.0 * eta * std::cos(O + w) / (2.0 * a * n))
        + (B) * ((-3.0) * eta * std::sin(O + w) / (2.0 * a * n))
        + (Cw) * (3.0 * ipow<2>(e) * sinc1 * sw1 * std::cos(O + w) / (2.0 * a * eta * n * (cinc1 + 1.0))));
}

