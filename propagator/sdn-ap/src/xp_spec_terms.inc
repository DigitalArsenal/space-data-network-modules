// SPEC 4 averaged SRP rates, wholly sunlit orbit: d[0] a_f, d[1] a_g, d[2] chi, d[3] psi, d[4] lambda, d[5] n.
inline void srp_rates_sunlit(double e, double eta, double w, double O, double inc, double a, double n, double A, double B, double Cw, double Fs, double* d) {
  double cinc1, sinc1;
  fm::sincos(inc, sinc1, cinc1);
  double cw1, sw1;
  fm::sincos(w, sw1, cw1);
  d[4] = Fs * (
        (A) * ((-3.0) * e * (2.0 * ipow<2>(e) - 3.0 * eta - 2.0) / (2.0 * a * n * (ipow<2>(e) - eta - 1.0)))
