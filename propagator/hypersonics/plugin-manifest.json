{
  "pluginId": "hypersonics-propagator",
  "name": "Hypersonics Propagator",
  "version": "0.1.1",
  "description": "Evaluates hypersonic flight conditions from trajectory samples. Supported atmosphere models: US76 (US Standard Atmosphere 1976, geopotential formulation, 0-86 km) and US76_EXPONENTIAL_EXTENSION (crude isothermal extension above 86 km). NRLMSISE00 requests fail hard \u2014 use the atmosphere or hpop modules for real NRLMSISE-00.",
  "pluginFamily": "propagator",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "evaluate_hypersonic_state_batch",
      "displayName": "Evaluate Hypersonic State Batch",
      "inputPorts": [
        {
          "portId": "trajectory",
          "acceptedTypeSets": [
            {
              "setId": "trajectory-state",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "conditions",
          "acceptedTypeSets": [
            {
              "setId": "hypersonic-flight-conditions",
              "allowedTypes": [
                {
                  "schemaName": "HFC.fbs",
                  "fileIdentifier": "$HFC",
                  "rootTypeName": "HFC"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
