{
  "programId": "com.digitalarsenal.flows.weathernext-cyclones-ingest",
  "name": "Global Ensemble Forecast Cyclone Track Ingest Flow",
  "version": "0.2.0",
  "engineLinkage": "bridge",
  "description": "Per-provider ingest flow for the tropical-cyclone tracks of a machine-learned global ensemble weather forecast (typed contracts 1.0): the host cron TimerTick enters at weathernext-source:cyclone_request, which (only when node CONFIG sets weathernext_live_access and weathernext_cyclone_url) emits the track CSV HttpRequest GET carrying its parse job in CONTEXT as a size-prefixed $TCT header record (model, ensemble size, wind averaging period, origin, dataset, source URL, licence); hostcap/http-request fetches it and echoes the CONTEXT; weathernext-parser:parse_cyclone_tracks emits one $TCT per (storm, member), the batch's IngestRequest (batch = sha256 of the CSV bytes, ARCHIVE weathernext / cyclone-tracks.csv) and the HttpResponse itself on raw; hostcap/storage-ingest persists the batch (IngestRequest on meta, the stream on tct_records, the HttpResponse on raw, whose BODY it archives) through the policy-mediated storage.ingest_with_source hostcall. IngestResults and Skipped FlowNotices land on the egress sink. After each store, weathernext-source:publish_request joins the IngestResult with the IngestRequest and (only when node CONFIG carries weathernext_publish_url, and not for a REFUSED batch) emits the loopback dataset-publication POST that a second hostcap/http-request node drives; its HttpResponse also lands on egress. Every edge carries one concrete FlatBuffer type; no JSON frames between nodes.",
  "nodes": [
    {
      "nodeId": "req",
      "pluginId": "com.digitalarsenal.data-source.weathernext-source",
      "methodId": "cyclone_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.weathernext-parser",
      "methodId": "parse_cyclone_tracks",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_tct",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_tct",
      "pluginId": "com.digitalarsenal.data-source.weathernext-source",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_http_tct",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "req-http",
      "fromNodeId": "req",
      "fromPortId": "request",
      "toNodeId": "http",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "http-parse",
      "fromNodeId": "http",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "response",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "parse-tct-meta",
      "fromNodeId": "parse",
      "fromPortId": "tct_meta",
      "toNodeId": "ingest_tct",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "parse-tct-records",
      "fromNodeId": "parse",
      "fromPortId": "tct_records",
      "toNodeId": "ingest_tct",
      "toPortId": "tct_records",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "parse-tct-raw",
      "fromNodeId": "parse",
      "fromPortId": "raw",
      "toNodeId": "ingest_tct",
      "toPortId": "raw",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "ingest-tct-egress",
      "fromNodeId": "ingest_tct",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "ingest-tct-publish",
      "fromNodeId": "ingest_tct",
      "fromPortId": "result",
      "toNodeId": "publish_tct",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "parse-tct-meta-publish",
      "fromNodeId": "parse",
      "fromPortId": "tct_meta",
      "toNodeId": "publish_tct",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "publish-tct-http",
      "fromNodeId": "publish_tct",
      "fromPortId": "request",
      "toNodeId": "publish_http_tct",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "publish-tct-egress",
      "fromNodeId": "publish_http_tct",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "req-status-egress",
      "fromNodeId": "req",
      "fromPortId": "status",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    }
  ],
  "triggers": [
    {
      "triggerId": "timer-wx-cyclones",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 21600000,
      "description": "Cyclone track sync timer (synoptic cycle cadence, 6 h)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-wx-cyclones",
      "targetNodeId": "req",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.weathernext-source",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.data-source.weathernext-parser",
    "com.digitalarsenal.hostcap.storage-ingest"
  ]
}
