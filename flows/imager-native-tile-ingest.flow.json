{
  "programId": "com.digitalarsenal.flows.imager-native-tile-ingest",
  "name": "Geostationary Imager Native Tile Ingest Flow",
  "version": "0.1.0",
  "engineLinkage": "bridge",
  "description": "Hourly ingest of geostationary imager observations at the imager's own resolution (owner 2026-10-23: the satellites' own resolution on the node, its own module set beside imager-observation-ingest): GOES-East and GOES-West ABI L1b/L2 NetCDF4 from NOAA Open Data Dissemination's anonymous public buckets as raw per-satellite level-5 $WXF tiles (5.625 degrees, 320 x 320 cells of ~2 km; the 0.64 um reflectance 640 x 640 of ~1 km), the layout of DigitalArsenal/Cesium_Weather tools/raw_satellite.py native_tiles that the world-clouds detail regions read, on typed contracts 1.0 (no JSON frames). timer (TimerTick) -> plan (one S3 listing HttpRequest per satellite and product folder of the frame hour) -> http -> select_files (the hour's first full-disk scan of each wanted field; byte ranges above imager_max_part_bytes; ONE PART PER INVOCATION, the rest yielded) -> http -> parse (once a file is whole, its field read and held, ONE TILE ROW AN INVOCATION - one IngestRequest and record stream, source <bucket>-tiles5 - the rest yielded) -> storage-ingest (wxf_records) -> publish_request -> http (dataset publication, only when imager_publish_url is set). Skips and missing files are FlowNotices at the egress. Memory: the parser holds one file (a daytime 0.5 km band ~430 MB) while its field (the 1 km reflectance, 10848^2 float32, ~470 MB) is read, then the field alone; run the service with memory_pages 24576.",
  "nodes": [
    {
      "nodeId": "plan",
      "pluginId": "com.digitalarsenal.data-source.imager-native-tile-source",
      "methodId": "plan",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http_list",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "select",
      "pluginId": "com.digitalarsenal.data-source.imager-native-tile-source",
      "methodId": "select_files",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "http_files",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.imager-native-tile-parser",
      "methodId": "parse",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "ingest_wxf",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_wxf",
      "pluginId": "com.digitalarsenal.data-source.imager-native-tile-source",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_http_wxf",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "plan-http-list",
      "fromNodeId": "plan",
      "fromPortId": "requests",
      "toNodeId": "http_list",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 64
    },
    {
      "edgeId": "http-list-select",
      "fromNodeId": "http_list",
      "fromPortId": "response",
      "toNodeId": "select",
      "toPortId": "listings",
      "backpressurePolicy": "queue",
      "queueDepth": 64
    },
    {
      "edgeId": "select-http-files",
      "fromNodeId": "select",
      "fromPortId": "requests",
      "toNodeId": "http_files",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 32
    },
    {
      "edgeId": "http-files-parse",
      "fromNodeId": "http_files",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "responses",
      "backpressurePolicy": "queue",
      "queueDepth": 32
    },
    {
      "edgeId": "parse-wxf-meta",
      "fromNodeId": "parse",
      "fromPortId": "wxf_meta",
      "toNodeId": "ingest_wxf",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-wxf-records",
      "fromNodeId": "parse",
      "fromPortId": "wxf_records",
      "toNodeId": "ingest_wxf",
      "toPortId": "wxf_records",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-wxf-egress",
      "fromNodeId": "ingest_wxf",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-wxf-publish",
      "fromNodeId": "ingest_wxf",
      "fromPortId": "result",
      "toNodeId": "publish_wxf",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-wxf-meta-publish",
      "fromNodeId": "parse",
      "fromPortId": "wxf_meta",
      "toNodeId": "publish_wxf",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "publish-wxf-http",
      "fromNodeId": "publish_wxf",
      "fromPortId": "request",
      "toNodeId": "publish_http_wxf",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "publish-wxf-egress",
      "fromNodeId": "publish_http_wxf",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "plan-status-egress",
      "fromNodeId": "plan",
      "fromPortId": "status",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "select-status-egress",
      "fromNodeId": "select",
      "fromPortId": "status",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "triggers": [
    {
      "triggerId": "timer-imager-tiles",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 3600000,
      "description": "Native tile timer (hourly: the hour's first full-disk scan and its L2 products, imager_lag_minutes after the hour)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-imager-tiles",
      "targetNodeId": "plan",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.imager-native-tile-source",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.data-source.imager-native-tile-parser",
    "com.digitalarsenal.hostcap.storage-ingest"
  ]
}
