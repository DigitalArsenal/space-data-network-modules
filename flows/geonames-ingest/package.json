{
  "name": "@digitalarsenal/sdn-flow-geonames-ingest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ./node_modules/space-data-module-sdk/bin/space-data-module.js flow check ../geonames-ingest.flow.json --deps ./deps.json",
    "build": "export SPACE_DATA_STANDARDS_ROOT=\"${SPACE_DATA_STANDARDS_ROOT:-$(cd ../../../spacedatastandards.org && pwd)}\"; node ./node_modules/space-data-module-sdk/bin/space-data-module.js flow compile ../geonames-ingest.flow.json --deps ./deps.json --out ./dist",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "space-data-module-sdk": "0.9.5"
  }
}
