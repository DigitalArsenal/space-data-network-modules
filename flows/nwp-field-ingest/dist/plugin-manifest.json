{
  "pluginId": "com.digitalarsenal.flows.nwp-field-ingest",
  "name": "Numerical Weather Prediction Field Ingest Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "description": "Six-hourly ingest of numerical-weather-prediction model fields from NOAA Open Data Dissemination's anonymous public buckets (NCEP GFS and GEFS GRIB2, message by message through each file's .idx inventory) as $WXF records carrying the GRIB2 packing integers exactly - the fields the world-clouds display reads: GFS 1 deg winds (and early heights) at 1000-200 hPa, GEFS 0.5 deg wind spread at every other point and GFS 0.5 deg cloud cover with 2 m temperature and dew point, 10 m wind, boundary-layer height, CAPE and surface height, each lead 0..384 h by 3, GFS 0.25 deg surface and profile fields at leads 0 and 3, and (asked for by name) the GFS 0.25 deg sea product cut into 11.25 deg tiles (owner 2026-10-02: SDN carries raw feeds; the display derives). Typed contracts 1.0 (FlatBuffers only, no JSON): timer (TimerTick) -> plan (the run's inventory HttpRequests, 16 an invocation, backlog) -> http (HttpResponse) -> select_messages (each lead-file's wanted messages as merged byte-range HttpRequests, a batch of at most 16 ranges an invocation, backlog) -> http -> parse ($WXF record stream + IngestRequest) -> storage-ingest (IngestResult) -> publish_request -> http (dataset publication, its body the IngestResult; only when nwp_publish_url is set). Job state travels as HttpRequest.CONTEXT - one size-prefixed $WXF header record per (product, lead), echoed in the HttpResponse - so the requests and their jobs are never paired by position. Egress: result (IngestResult), notice (FlowNotice: skipped, unchanged - already-planned / inventory-304 - and missing leads), publication (the publication HttpResponse). Nodes are listed in pipeline order: the runtime's fair ready-node cursor carries each batch through parse and storage-ingest before the source resumes, so storage-ingest receives one meta and one record stream at a time. Memory: measured 252 MiB of linear memory for a full GFS 0.25 deg physics lead (140 fields, 119 MB of ranges in five batches, 4.4 s) - run the service with memory_pages 8192 (512 MiB). Cadence: every 6 h (GFS cycles). Volume: the records carry delta-coded integers, uncompressed - a physics lead is 292 MB of records, a motion lead about 4 MB.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.nwp-field-source",
      "minVersion": "0.3.1",
      "maxVersion": "0.3.1"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.nwp-grib2-parser",
      "minVersion": "0.3.0",
      "maxVersion": "0.3.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.3.0",
      "maxVersion": "0.3.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_nwp",
      "displayName": "Flow trigger timer-nwp",
      "description": "Compiled-flow ingress for trigger \"timer-nwp\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK) from the flow's timer trigger."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick (fields not read: any tick plans)."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-result",
              "allowedTypes": [
                {
                  "schemaName": "IngestResult.fbs",
                  "fileIdentifier": "INGR",
                  "rootTypeName": "IngestResult",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "IngestResult (module-sdk runtime type INGR): SCHEMA, PROVIDER_ID, SOURCE_NAME, BATCH_ID, INSERTED, RECONCILED_DUPLICATES, RECONCILED_OLD_BATCHES, ARCHIVED; or REFUSED saying why the batch was not stored (a value over its aligned bound, or a host refusal)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "EXACTLY ONE IngestResult per invocation."
        },
        {
          "portId": "publication",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-http-response",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponse.fbs",
                  "fileIdentifier": "HRSP",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "HttpResponse (module-sdk runtime type HRSP): URL answered, STATUS (0 when the request failed, ERROR says why), HEADERS sorted by lower-case NAME, BODY verbatim, the request's CONTEXT, RETRIEVED_MS."
            }
          ],
          "minStreams": 1,
          "maxStreams": 100000,
          "required": true,
          "description": "EXACTLY ONE HttpResponse per request frame, pushed in input order, so response k answers request k. A request that could not be performed still answers, with STATUS 0 and ERROR; a consumer drops it as it would a 500 while the positional slot stays aligned."
        },
        {
          "portId": "notice",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-flow-notice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (module-sdk runtime type FNTC): Skipped (REASON live-access-disabled / nothing-to-fetch), Unchanged (REASON already-planned, or inventory-304 with COUNT), Missing (REASON missing-leads, ITEMS the inventories the run lacks with their HTTP status, or the lead-files with no wanted message)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Why a cycle emitted nothing."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "WXF.fbs",
      "fileIdentifier": "$WXF",
      "rootTypeName": "WXF"
    }
  ],
