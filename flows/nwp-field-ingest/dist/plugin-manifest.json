{
  "pluginId": "com.digitalarsenal.flows.nwp-field-ingest",
  "name": "Numerical Weather Prediction Field Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Six-hourly ingest of numerical-weather-prediction model fields from NOAA Open Data Dissemination's anonymous public buckets (NCEP GFS and GEFS GRIB2, message by message through each file's .idx inventory) as $WXF records carrying the GRIB2 packing integers exactly - the fields the world-clouds display reads: GFS 1 deg winds (and early heights) at 1000-200 hPa, GEFS 0.5 deg wind spread at every other point and GFS 0.5 deg cloud cover, each lead 0..384 h by 3, and GFS 0.25 deg surface and profile fields at leads 0 and 3 (owner 2026-10-02: SDN carries raw feeds; the display derives). timer -> plan (the run's inventories, 16 an invocation, backlog) -> http -> select_messages (each lead-file's wanted messages as merged byte ranges, a batch of at most 16 ranges an invocation, backlog) -> http -> parse -> storage-ingest -> publish_request -> http (dataset publication, only when nwp_publish_url is set). Nodes are listed in pipeline order: the runtime's fair ready-node cursor carries each batch through parse and storage-ingest before the source resumes, so storage-ingest receives one meta and one record stream at a time. Memory: measured 252 MiB of linear memory for a full GFS 0.25 deg physics lead (140 fields, 119 MB of ranges in five batches, 4.4 s) - run the service with memory_pages 8192 (512 MiB). Cadence: every 6 h (GFS cycles). Volume: the records carry delta-coded integers, uncompressed - a physics lead is 292 MB of records, a motion lead about 4 MB.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.nwp-field-source",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.nwp-grib2-parser",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 100 MiB response ceiling lowered per request by max_bytes (exceeding the effective bound is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_nwp",
      "displayName": "Flow trigger timer-nwp",
      "description": "Compiled-flow ingress for trigger \"timer-nwp\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Timer tick frame (content ignored).",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Cron timer tick frame produced by the flow runtime and consumed inside this flow only; it carries no payload of its own, so there is no SDS record to name."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-ingest-result-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "UTF-8 JSON host result: {\"schema\",\"inserted\",\"batch_id\",\"reconciled_duplicates\"?,\"reconciled_old_batches\"?,\"archived\"?,\"provenance\"?}."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Ingest result summary."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "WXF.fbs",
      "fileIdentifier": "$WXF",
