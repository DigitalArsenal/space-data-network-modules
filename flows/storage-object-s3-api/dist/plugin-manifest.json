{
  "pluginId": "com.digitalarsenal.flows.storage-object-s3-api",
  "name": "S3-Compatible Object Store API",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Mounted at /api/v1/storage/objects (typed contracts 1.0: FlatBuffers only; every answer is the $APR result record, whose BODY is the object bytes for GET and a $FIL listing for a list). The ONE http trigger delivers the $HTQ request to storage/object-s3 serve, which routes PUT|GET|HEAD|DELETE /objects/<store>/<bucket>/<key> and GET /objects/<store>/<bucket> (list) into an $APR task for sign; sign builds the SigV4-signed request, hostcap/http-request performs it, finish reads the response, and foundation/http-respond answers. A put above multipartThreshold (16 MiB) runs the multipart stages (sign emits CreateMultipartUpload and forwards the task on held; split emits one signed UploadPart per partSize slice; assemble emits CompleteMultipartUpload, or AbortMultipartUpload and a refusal when any part failed; a third http-request node and a second finish node read the completion). Exactly one of the result, refusal and failure emitters answers per exchange, so two bodies can never race into the responder. Every route is NOT anonymous (an admin session): the endpoint is caller-chosen, so an anonymous caller could point a stored credential at any host. object-s3 holds only the secrets READ grant and the clock, http-request holds only http, and the credential lanes are written by the separate storage-credentials flow. The host owns no store list and no schedule - it mounts a route and moves bytes; zero new capabilities.",
  "capabilities": [
    "clock",
    "http",
    "secrets:storage_b2",
    "secrets:storage_custom",
    "secrets:storage_gcs",
    "secrets:storage_minio",
    "secrets:storage_r2",
    "secrets:storage_s3",
    "secrets:storage_wasabi"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.storage.object-s3",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.3.1",
      "maxVersion": "0.3.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "The SDK's WASM-served HTTP request envelope ($HTQ): METHOD, PATH, QUERY, HEADERS, BODY (the object bytes on PUT)."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "The HTTP request for /objects/<store>/<bucket>[/<key>]."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one $HTR per HTTP exchange."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
