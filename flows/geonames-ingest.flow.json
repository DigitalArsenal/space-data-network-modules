  "triggers": [
    {
      "triggerId": "timer-geonames-ingest",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 86400000,
      "description": "Epoch tick, at the gazetteer's own publication cadence. One tick is one bounded unit of work - the seed on the first, one day's modifications and deletes on every later one - and the durable resume mark advances only from a verified store, so a restart resumes at the day it left off and an overrun tick is naturally skipped because the next one re-derives the same date and finds it already marked."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-geonames-ingest",
      "targetNodeId": "mark_read_q",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "triggerId": "timer-geonames-ingest",
      "targetNodeId": "plan",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
