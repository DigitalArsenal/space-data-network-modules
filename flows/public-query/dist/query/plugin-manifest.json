{
  "pluginId": "com.digitalarsenal.flows.public-query",
  "name": "SDN Public Query Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "description": "Gateway public query flow (mount /api/v1/query, loop G.5): foundation/http-route route_public_query decides the $HTQ request as a $QRP - POST -> \"query\" (SQL + typed PARAMETERS, or a named TIME_PROFILE over the unified OMM view, with sort / limit / representation), GET/HEAD -> \"surface\", anything else or an unservable body -> \"refusal\" (a $QRP Error straight to the responder); hostcap/flatsql-query sandbox_query (records delivered out of band by host body reference unless JSON is asked for) composes the effective SQL and runs it through the policy-mediated READ-ONLY storage.query_sandboxed hostcall (typed $PIV, capability storage_query; the engine enforces the sandbox in-wasm), or lists storage.query_surface, and answers the $QRP request beside its $QRP page (or a $QRP Error); foundation/http-respond respond_query renders the $HTR: the page stream verbatim as FlatBuffers by default, JSON on request, 304 on the page ETAG, the HTTP status of a refusal from its ERROR_CODE. foundation/omm-json is retired. Typed contracts 1.0: every edge carries one SDS FlatBuffers type; no JSON travels between nodes (JSON exists only as the client representation http-respond renders on request).",
  "capabilities": [
    "clock",
    "storage_query"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "minVersion": "0.8.0",
      "maxVersion": "0.8.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.flatsql-query",
      "minVersion": "0.3.1",
      "maxVersion": "0.3.1"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.3.1",
      "maxVersion": "0.3.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "flatsql-query-stream",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_query",
      "resource": "storage://flatsql",
      "description": "Host FlatSQL engine queries as SDS $PIV hostcalls: storage.flatsql_query_stream (operator surface, unsandboxed, auth-gated at the wall), storage.query_sandboxed and storage.query_surface (the public read-only surface).",
      "properties": {
        "hostOps": [
          "storage.flatsql_query_stream",
          "storage.query_sandboxed",
          "storage.query_surface"
        ]
      }
    },
    {
      "interfaceId": "host-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "description": "clock.now defaults a profile query's epoch to now (Go node built-in; capability-gated on the SDK hosts).",
      "properties": {
        "hostOps": [
          "clock.now"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP request envelope ($HTQ, module-sdk schemas/HttpRequestAbi.fbs): METHOD, PATH (no query string), QUERY (raw, URL-encoded), HEADERS (sorted, lower-cased names), BODY, REMOTE."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The HTTP request to route."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one $HTR per HTTP exchange."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
