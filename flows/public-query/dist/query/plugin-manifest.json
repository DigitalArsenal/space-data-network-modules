{
  "pluginId": "com.digitalarsenal.flows.public-query",
  "name": "SDN Public Query Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Sandboxed public query flow (gateway loop G.5, mount /api/v1/query). A $HTQ HttpRequest enters on the http-request trigger, foundation/http-route route_public_query parses it (POST = raw SELECT body {sql,params,format,limit,sort,profile,epoch,source} or bare SQL text; GET/HEAD = the queryable-surface listing), hostcap/flatsql-query sandbox_query composes the effective SQL IN-WASM (validated sort/limit wrapping, or a named epoch profile nearest|as_of|forward over the unified OMM view with default epoch=now) and issues the policy-mediated READ-ONLY storage.query_sandboxed hostcall. The ENGINE enforces the sandbox in-wasm: a SQLite authorizer restricted to the record tables / per-source shadow tables / unified views (control tables and sqlite_* are invisible), single-statement SELECT-only validation, a statement timeout, and row/byte caps that REJECT oversized results (host config gateway.query; defaults 5 s / 200K rows / 128 MiB). flatbuffer path: all-BLOB projections (e.g. SELECT _data ...) stream as aligned size-prefixed frames via a host body reference; projections answer 406. json path: full-record streams ride through foundation/omm-json (bare-array, schema-exact keys per hard rule json-schema-capitalization-rule); tabular projections are engine-assembled bare-array JSON whose keys are the SQL column names verbatim. Sandbox rejections map to honest statuses: validation 400, projection-as-flatbuffer 406, timeout/row-cap/byte-cap 422 (+machine-readable code in the body). foundation/http-respond assembles the final $HTR envelope (200/304/4xx/5xx) delivered to the host-model egress sink. Bridge linkage: the only host crossings are the declared storage_query hostcalls (and clock.now for default profile epochs).",
  "capabilities": [
    "storage_query"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "minVersion": "0.7.0",
      "maxVersion": "0.7.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.flatsql-query",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.omm-json",
      "minVersion": "0.1.1",
      "maxVersion": "0.1.1"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.2.1",
      "maxVersion": "0.2.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "flatsql-query-stream",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_query",
      "resource": "storage://flatsql",
      "description": "Host FlatSQL engine-native query streaming (storage.flatsql_query_stream). Served by the Go node today; browser-side flatsql stream ops are not exposed by the SDK BrowserHost storage adapter (server-only until flatsql ships as an in-wasm component dependency).",
      "properties": {
        "hostOps": [
          "storage.flatsql_query_stream",
          "storage.query_sandboxed",
          "storage.query_surface"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest"
                }
              ],
              "description": "One $HTQ HttpRequest envelope."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The HTTP request to route."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one HTTP response envelope per invoke."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "HttpRequestAbi.fbs",
      "fileIdentifier": "$HTQ",
      "rootTypeName": "HttpRequest"
    },
    {
      "schemaName": "OMM.fbs",
      "fileIdentifier": "$OMM",
      "rootTypeName": "OMM"
    },
    {
      "schemaName": "HttpResponseAbi.fbs",
      "fileIdentifier": "$HTR",
      "rootTypeName": "HttpResponse"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_public_query-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "route",
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "methodId": "route_public_query",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "q",
      "pluginId": "com.digitalarsenal.hostcap.flatsql-query",
      "methodId": "sandbox_query",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "tojson",
      "pluginId": "com.digitalarsenal.foundation.omm-json",
      "methodId": "encode",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "respond",
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "methodId": "respond",
      "kind": "responder",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "dispatchModel": "host-capability",
      "uiX": 0,
      "uiY": 0
    }
  ],
  "flowEdges": [
    {
      "edgeId": "route-decision",
      "fromNodeId": "route",
      "fromPortId": "decision",
      "toNodeId": "q",
      "toPortId": "decision",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "q-decision",
      "fromNodeId": "q",
      "fromPortId": "decision",
      "toNodeId": "respond",
      "toPortId": "decision",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "q-body",
      "fromNodeId": "q",
      "fromPortId": "body",
      "toNodeId": "respond",
      "toPortId": "body",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "q-etag",
      "fromNodeId": "q",
      "fromPortId": "etag",
      "toNodeId": "respond",
      "toPortId": "etag",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "q-stream",
      "fromNodeId": "q",
      "fromPortId": "stream",
      "toNodeId": "tojson",
      "toPortId": "stream",
      "contract": {
        "canonicalType": {
          "schemaName": "OMM.fbs",
          "fileIdentifier": "$OMM",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "OMM",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": {
          "schemaName": "OMM.fbs",
          "fileIdentifier": "$OMM",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "aligned-binary",
          "rootTypeName": "OMM",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 8
        },
        "canonicalFallbackAvailable": true,
        "alignedEligible": true,
        "opaque": false,
        "routePolicy": "aligned-shared-arena-or-canonical"
      }
    },
    {
      "edgeId": "tojson-body",
      "fromNodeId": "tojson",
      "fromPortId": "json",
      "toNodeId": "respond",
      "toPortId": "body",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "respond-egress",
      "fromNodeId": "respond",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "response",
      "contract": {
        "canonicalType": {
          "schemaName": "HttpResponseAbi.fbs",
          "fileIdentifier": "$HTR",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "HttpResponse",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": false,
        "routePolicy": "canonical-only"
      }
    }
  ],
  "flowTriggers": [
    {
      "triggerId": "http-request",
      "kind": "http-request",
      "source": "host-http",
      "defaultIntervalMs": 0,
      "httpPath": null
    }
  ],
  "flowTriggerBindings": [
    {
      "triggerId": "http-request",
      "targetNodeId": "route",
      "targetPortId": "request"
    }
  ],
  "abiVersion": 1
}
