{
  "pluginId": "com.digitalarsenal.flows.celestrak-gp-groups-ingest",
  "name": "CelesTrak GP Groups Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Per-provider ingest flow for the CelesTrak GP group queries (47 GROUP tokens plus the gpz / gpz-plus SPECIAL queries): a module cron TIMER tick enters at celestrak-reference:gp_groups, which emits one hostcap/http-request frame per group and ONE job frame carrying the ordered group list; the http node answers one response per request in order; celestrak-reference:parse_gp_groups pairs them by ordinal and emits one $EGP (Entity Group, QUERY_SNAPSHOT membership over the group's OMM rows) per group, with batch = sha256 of the concatenated payloads and reconcile 'current' for a complete snapshot ('duplicates' when some groups answered 304); hostcap/storage-ingest persists through the policy-mediated storage.ingest_with_source cap op. Groups that answered Not Modified land on the egress sink as an 'unchanged' notice. The optional OMM re-emission lane (node CONFIG celestrak_gp_groups_emit_omm) stores the group rows as OMM when enabled. All decisions live in-wasm.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.celestrak-reference",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 100 MiB response ceiling lowered per request by max_bytes (exceeding the effective bound is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_gp_groups",
      "displayName": "Flow trigger timer-gp-groups",
      "description": "Compiled-flow ingress for trigger \"timer-gp-groups\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Timer tick frame (content ignored).",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Cron timer tick frame produced by the flow runtime and consumed inside this flow only; it carries no payload of its own, so there is no SDS record to name."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "celestrak-unchanged-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "UTF-8 JSON {\"status\":304,\"unchanged\":true,\"source_name\",\"source_url\",\"dataset_id\",\"origin_id\",\"groups\":[tokens],\"changed_count\"} when at least one group answered Not Modified.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Not-Modified notice delivered to the flow's egress sink so an operator can see which groups were unchanged this cycle; flow bookkeeping, never persisted as a record."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Not-Modified notice."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "EGP.fbs",
      "fileIdentifier": "$EGP",
      "rootTypeName": "EGP"
    },
    {
      "schemaName": "OMM.fbs",
      "fileIdentifier": "$OMM",
      "rootTypeName": "OMM"
    },
    {
      "schemaName": "SIT.fbs",
      "fileIdentifier": "$SIT",
      "rootTypeName": "SIT"
    },
    {
      "schemaName": "LCC.fbs",
      "fileIdentifier": "$LCC",
      "rootTypeName": "LCC"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_celestrak_gp_groups_ingest-flow-runtime",
      "kind": "wasm",
