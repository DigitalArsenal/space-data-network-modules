{
  "pluginId": "com.digitalarsenal.flows.celestrak-satcat-reference-ingest",
  "name": "CelesTrak SATCAT Reference Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Per-provider ingest flow for the CelesTrak SATCAT reference tables: a module cron TIMER tick enters at celestrak-reference:satcat_reference, which emits BOTH table fetches (launch sites and owners/sources); two hostcap/http-request nodes fetch, two celestrak-reference:parse_satcat_reference nodes read the HTML tables into $SIT (launch sites) and $LCC (legacy owner codes) record streams (batch = sha256 of each page, reconcile 'current' since only the newest table is meaningful), and two hostcap/storage-ingest nodes persist through the policy-mediated storage.ingest_with_source cap op. Results and Not-Modified notices land on the egress sink. All decisions live in-wasm.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.celestrak-reference",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 100 MiB response ceiling lowered per request by max_bytes (exceeding the effective bound is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_satcat_reference",
      "displayName": "Flow trigger timer-satcat-reference",
      "description": "Compiled-flow ingress for trigger \"timer-satcat-reference\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Timer tick frame (content ignored).",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Cron timer tick frame produced by the flow runtime and consumed inside this flow only; it carries no payload of its own, so there is no SDS record to name."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "celestrak-unchanged-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "UTF-8 JSON {\"status\":304,\"unchanged\":true,\"source_name\",\"source_url\",\"dataset_id\",\"origin_id\"} when the page answered Not Modified.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Not-Modified notice delivered to the flow's egress sink so an operator can see that the page was unchanged this cycle; flow bookkeeping, never persisted as a record."
              }
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Not-Modified notice."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "EGP.fbs",
      "fileIdentifier": "$EGP",
      "rootTypeName": "EGP"
    },
    {
      "schemaName": "OMM.fbs",
      "fileIdentifier": "$OMM",
      "rootTypeName": "OMM"
    },
    {
      "schemaName": "SIT.fbs",
      "fileIdentifier": "$SIT",
      "rootTypeName": "SIT"
    },
    {
      "schemaName": "LCC.fbs",
      "fileIdentifier": "$LCC",
      "rootTypeName": "LCC"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_celestrak_satcat_reference_ingest-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
