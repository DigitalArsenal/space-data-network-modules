      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish",
      "pluginId": "com.digitalarsenal.data-source.cell-tower-ingest",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
