  "triggers": [
    {
      "triggerId": "timer-cell-ingest",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 300000,
      "description": "Chunk tick (TimerTick). One tick fetches and stores ONE ranged chunk and advances the mark, so the interval sets ingest pace and a restart resumes from the durable $IRM mark, not from zero."
    }
  ],
  "triggerBindings": [
