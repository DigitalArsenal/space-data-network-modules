      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.cell-tower-source",
      "methodId": "parse",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "merge",
      "pluginId": "com.digitalarsenal.data-source.cell-tower-source",
      "methodId": "deconflict",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "meta",
      "pluginId": "com.digitalarsenal.data-source.cell-tower-ingest",
      "methodId": "ingest_meta",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
