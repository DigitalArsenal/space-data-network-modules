{
  "pluginId": "com.digitalarsenal.flows.node-status",
  "name": "SDN Node Status Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "M1 node-status flow (mount GET /api/v1/node/status): a $HTQ HttpRequest enters on the http-request trigger, foundation/http-route route_node_status classifies it (GET/HEAD -> route=status; anything else -> route=error status=405 — PATH is not inspected, the mount carries exactly one resource), hostcap/node-status status forwards an EMPTY payload to the policy-mediated READ-ONLY node_status_read.status hostcall (capability node_status_read; the host's capPrefixFromName has no mapping for it, so the capability name itself is the op prefix) and emits the raw hostcall result OBJECT verbatim on \"body\" (a live status snapshot — uptime, storage totals, disk, service state, bandwidth counters/history — NOT an SDS record collection, so the bare-array json convention used by the other gateway flows does not apply), and foundation/http-respond assembles the final $HTR envelope (200/405/503) delivered to the host-model egress sink. JSON-ONLY for v1: there is no SDS schema for node status (checked spacedatastandards.org/schema — no STA/HLT/NOD/SVC-style match), so a flatbuffer presentation is blocked on a future SDS schema addition rather than a hand-written table (generated-types-only rule). No ETag/conditional-GET: the snapshot changes on every call (uptime, bandwidth counters), so a conditional-GET contract would be pointless. Anonymity: the $HTQ envelope (module-sdk schemas/HttpRequestAbi.fbs — METHOD/PATH/QUERY/HEADERS/BODY/REMOTE) carries no caller-trust field a flow can read, so the route is declared anonymous:false (operator-gated at the host's auth wall, mirroring flows/data-retrieval's POST /api/v1/data/query precedent) until the envelope carries trust information a shape node could read to serve a reduced anonymous subset.",
  "capabilities": [
    "node_status_read"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "minVersion": "0.7.0",
      "maxVersion": "0.7.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.node-status",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.2.1",
      "maxVersion": "0.2.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "sdn-host-node-status",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "node_status_read",
      "resource": "sdn://node/status",
      "description": "Policy-mediated read-only host node-status snapshot (uptime, storage totals, disk, service state, bandwidth counters/history).",
      "properties": {
        "hostOps": [
          "node_status_read.status"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest"
                }
              ],
              "description": "One $HTQ HttpRequest envelope."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The HTTP request to route."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one HTTP response envelope per invoke."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "HttpRequestAbi.fbs",
      "fileIdentifier": "$HTQ",
      "rootTypeName": "HttpRequest"
    },
    {
      "schemaName": "HttpResponseAbi.fbs",
      "fileIdentifier": "$HTR",
      "rootTypeName": "HttpResponse"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_node_status-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "route",
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "methodId": "route_node_status",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "status",
      "pluginId": "com.digitalarsenal.hostcap.node-status",
      "methodId": "status",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "respond",
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "methodId": "respond",
      "kind": "responder",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "dispatchModel": "host-capability",
      "uiX": 0,
      "uiY": 0
    }
  ],
  "flowEdges": [
    {
      "edgeId": "route-decision",
      "fromNodeId": "route",
      "fromPortId": "decision",
      "toNodeId": "status",
      "toPortId": "decision",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "status-decision",
      "fromNodeId": "status",
      "fromPortId": "decision",
      "toNodeId": "respond",
      "toPortId": "decision",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "status-body",
      "fromNodeId": "status",
      "fromPortId": "body",
      "toNodeId": "respond",
      "toPortId": "body",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "respond-egress",
      "fromNodeId": "respond",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "response",
      "contract": {
        "canonicalType": {
          "schemaName": "HttpResponseAbi.fbs",
          "fileIdentifier": "$HTR",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "HttpResponse",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": false,
        "routePolicy": "canonical-only"
      }
    }
  ],
  "flowTriggers": [
    {
      "triggerId": "http-request",
      "kind": "http-request",
      "source": "host-http",
      "defaultIntervalMs": 0,
      "httpPath": null
    }
  ],
  "flowTriggerBindings": [
    {
      "triggerId": "http-request",
      "targetNodeId": "route",
      "targetPortId": "request"
    }
  ],
  "abiVersion": 1
}
