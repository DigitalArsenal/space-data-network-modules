{
  "pluginId": "com.digitalarsenal.flows.node-status",
  "name": "SDN Node Status Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "description": "M1 node-status flow (mount GET /api/v1/node/status): a $HTQ HttpRequest enters on the http-request trigger; foundation/http-route route_node_status decides it as an $APR (GET/HEAD -> route status, anything else STATUS 405); hostcap/node-status reads the node through the policy-mediated READ-ONLY node_status_read.status hostcall (typed $PIV, capability node_status_read; node.peerId and clock.now stamp NODE_ID / GENERATED_AT_MS) and answers an $NHS beside the $APR (or the $APR with STATUS 503 when the host fails); foundation/http-respond respond renders the $HTR (200 / 405 / 503): the $NHS verbatim as FlatBuffers by default, or as JSON when the request asks for it. No ETag: the snapshot changes on every call. Typed contracts 1.0: every edge carries one SDS FlatBuffers type; no JSON travels between nodes (JSON exists only as the client representation http-respond renders on request).",
  "capabilities": [
    "clock",
    "node_status_read"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "minVersion": "0.8.0",
      "maxVersion": "0.8.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.node-status",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.3.0",
      "maxVersion": "0.3.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "sdn-host-node-status",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "node_status_read",
      "resource": "sdn://node/status",
      "description": "Policy-mediated read-only host node-status snapshot as SDS $PIV hostcalls (node_status_read.status -> NodeStatusReport + list bandwidth_history); node.peerId (ungated) names the node.",
      "properties": {
        "hostOps": [
          "node_status_read.status",
          "node.peerId"
        ]
      }
    },
    {
      "interfaceId": "host-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "description": "clock.now (SDS $PIV, TimeValue) stamps NHS.GENERATED_AT_MS.",
      "properties": {
        "hostOps": [
          "clock.now"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP request envelope ($HTQ, module-sdk schemas/HttpRequestAbi.fbs): METHOD, PATH (no query string), QUERY (raw, URL-encoded), HEADERS (sorted, lower-cased names), BODY, REMOTE."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The HTTP request to route."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one $HTR per HTTP exchange."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "HttpRequestAbi.fbs",
      "fileIdentifier": "$HTQ",
      "rootTypeName": "HttpRequest",
      "wireFormat": "flatbuffer"
    },
