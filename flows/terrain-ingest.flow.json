  "triggers": [
    {
      "triggerId": "timer-terrain-ingest",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 15000,
      "description": "One tick is ONE GRANULE CELL: eight ranged fetches and every tile of one level whose corner lies in the cell. The runtime re-invokes until the enumeration drains (granule_plan reports the remainder through the backlog counter), and because the mark advances only from a verified store, an overrun tick is naturally idempotent - the next one re-derives the same cell and finds it already marked."
    }
  ],
