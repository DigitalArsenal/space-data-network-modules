{
  "programId": "com.digitalarsenal.flows.nwp-field-ingest",
  "name": "Numerical Weather Prediction Field Ingest Flow",
  "version": "0.1.0",
  "engineLinkage": "bridge",
  "description": "Six-hourly ingest of numerical-weather-prediction model fields from NOAA Open Data Dissemination's anonymous public buckets (NCEP GFS and GEFS GRIB2, message by message through each file's .idx inventory) as $WXF records carrying the GRIB2 packing integers exactly - the fields the world-clouds display reads: GFS 1 deg winds (and early heights) at 1000-200 hPa, GEFS 0.5 deg wind spread at every other point and GFS 0.5 deg cloud cover, each lead 0..384 h by 3, and GFS 0.25 deg surface and profile fields at leads 0 and 3 (owner 2026-10-02: SDN carries raw feeds; the display derives). timer -> plan (the run's inventories, 16 an invocation, backlog) -> http -> select_messages (each lead-file's wanted messages as merged byte ranges, a batch of at most 16 ranges an invocation, backlog) -> http -> parse -> storage-ingest -> publish_request -> http (dataset publication, only when nwp_publish_url is set). Nodes are listed in pipeline order: the runtime's fair ready-node cursor carries each batch through parse and storage-ingest before the source resumes, so storage-ingest receives one meta and one record stream at a time. Memory: measured 252 MiB of linear memory for a full GFS 0.25 deg physics lead (140 fields, 119 MB of ranges in five batches, 4.4 s) - run the service with memory_pages 8192 (512 MiB). Cadence: every 6 h (GFS cycles). Volume: the records carry delta-coded integers, uncompressed - a physics lead is 292 MB of records, a motion lead about 4 MB.",
  "nodes": [
    {
      "nodeId": "plan",
      "pluginId": "com.digitalarsenal.data-source.nwp-field-source",
      "methodId": "plan",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "http_idx",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "select",
      "pluginId": "com.digitalarsenal.data-source.nwp-field-source",
      "methodId": "select_messages",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "http_grib",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.nwp-grib2-parser",
      "methodId": "parse",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "ingest_wxf",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_wxf",
      "pluginId": "com.digitalarsenal.data-source.nwp-field-source",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_http_wxf",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "plan-http-idx",
      "fromNodeId": "plan",
      "fromPortId": "requests",
      "toNodeId": "http_idx",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 64,
      "opaque": true
    },
    {
      "edgeId": "plan-select-jobs",
      "fromNodeId": "plan",
      "fromPortId": "jobs",
      "toNodeId": "select",
      "toPortId": "idx_jobs",
      "backpressurePolicy": "queue",
      "queueDepth": 64,
      "opaque": true
    },
    {
      "edgeId": "http-idx-select",
      "fromNodeId": "http_idx",
      "fromPortId": "response",
      "toNodeId": "select",
      "toPortId": "inventories",
      "backpressurePolicy": "queue",
      "queueDepth": 64,
      "opaque": true
    },
    {
      "edgeId": "select-http-grib",
      "fromNodeId": "select",
      "fromPortId": "requests",
      "toNodeId": "http_grib",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 32,
      "opaque": true
    },
    {
      "edgeId": "select-parse-jobs",
      "fromNodeId": "select",
      "fromPortId": "jobs",
      "toNodeId": "parse",
      "toPortId": "jobs",
      "backpressurePolicy": "queue",
      "queueDepth": 32,
      "opaque": true
    },
    {
      "edgeId": "http-grib-parse",
      "fromNodeId": "http_grib",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "responses",
      "backpressurePolicy": "queue",
      "queueDepth": 32,
      "opaque": true
    },
    {
      "edgeId": "parse-wxf-meta",
      "fromNodeId": "parse",
      "fromPortId": "wxf_meta",
      "toNodeId": "ingest_wxf",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-wxf-records",
      "fromNodeId": "parse",
      "fromPortId": "wxf_records",
      "toNodeId": "ingest_wxf",
      "toPortId": "records",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false,
      "_comment": "NOT opaque: both ports resolve the concrete $WXF identity, so the record type is declared on the wire rather than signed away."
    },
    {
      "edgeId": "ingest-wxf-egress",
      "fromNodeId": "ingest_wxf",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "ingest-wxf-publish",
      "fromNodeId": "ingest_wxf",
      "fromPortId": "result",
      "toNodeId": "publish_wxf",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-wxf-meta-publish",
      "fromNodeId": "parse",
      "fromPortId": "wxf_meta",
      "toNodeId": "publish_wxf",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "publish-wxf-http",
      "fromNodeId": "publish_wxf",
      "fromPortId": "request",
      "toNodeId": "publish_http_wxf",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "publish-wxf-egress",
      "fromNodeId": "publish_http_wxf",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "plan-status-egress",
      "fromNodeId": "plan",
      "fromPortId": "status",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "select-status-egress",
      "fromNodeId": "select",
      "fromPortId": "status",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    }
  ],
  "triggers": [
    {
      "triggerId": "timer-nwp",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 21600000,
      "description": "NWP field timer (every 6 h: one GFS/GEFS cycle, nwp_lag_hours after it)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-nwp",
      "targetNodeId": "plan",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.nwp-field-source",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.data-source.nwp-grib2-parser",
    "com.digitalarsenal.hostcap.storage-ingest"
  ]
}
