  "api": {
    "tag": "cellular",
    "tagDescription": "Terrestrial cellular base-station aggregation across open provider registries.",
    "routes": [
      {
        "path": "aggregate",
        "method": "POST",
        "operationId": "aggregateCellularSites",
        "summary": "Aggregate and deconflict cellular base-station sites across providers",
        "description": "Takes a provider set and a tbsMergeMethod and answers with a size-prefixed $TBS record stream. ANONYMOUS is requested deliberately: every provider reachable without a credential publishes open data under an attribution licence, the answer carries that attribution in $TBS.SOURCES, and this is a public read that changes no node state. The host still decides; gateway.anonymous.deny overrides this request.",
        "anonymous": true
      },
      {
        "path": "providers",
        "method": "GET",
        "operationId": "listCellularProviders",
        "summary": "The provider catalog this node's module can reach",
        "description": "Provider ids, access posture and whether a credential is currently held. Anonymous for the same reason as aggregate: it is a public read of open-data source metadata and reveals no secret. Credential VALUES are never exposed by any route.",
        "anonymous": true
      },
      {
        "path": "credentials/{providerId}",
        "method": "PUT",
        "operationId": "storeCellularProviderCredential",
        "summary": "Store a browser-sealed provider credential in the node's credential store",
        "description": "Takes the node's own keyslot envelope ({slotId, ephemeralPublicKey, nonce, ciphertext}), asks the host to open it, and writes the result to the machine-bound credential store under the lane cell_<providerId>. The value is never echoed, logged or readable back through any route. NOT ANONYMOUS, and deliberately so: an anonymous visitor overwriting this node's provider credentials would change what every other viewer's run does. There is no plaintext branch \u2014 a caller who cannot seal cannot store.",
        "anonymous": false,
        "params": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "A provider id from GET /providers. The lane written is cell_<providerId>, derived by the module from its own compiled registry \u2014 never a lane name the caller supplies.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "credentials/{providerId}",
        "method": "DELETE",
        "operationId": "clearCellularProviderCredential",
        "summary": "Clear a stored provider credential",
        "description": "Removes the cell_<providerId> lane from the node's credential store. Answers the same way whether or not anything was there, so a write grant does not become a presence oracle. NOT ANONYMOUS, for the same reason as the PUT.",
        "anonymous": false,
        "params": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "A provider id from GET /providers. The lane written is cell_<providerId>, derived by the module from its own compiled registry \u2014 never a lane name the caller supplies.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "tiles/meta",
        "method": "GET",
        "operationId": "getCellularTileMeta",
        "summary": "The density-tile layer's capability envelope",
        "description": "Scheme (xyz), zoom range, the points/sample/density thresholds, the density grid size and the store's own honesty block (cacheState, records, epoch, stale). The client fetches this once and fails hard if it drifts, so it is the server's binding declaration of the contract every tile then honours. Anonymous for the same reason as /aggregate: a public read of open-data metadata that changes no node state.",
        "anonymous": true
      },
      {
        "path": "tiles/{z}/{x}/{y}",
        "method": "GET",
        "operationId": "getCellularDensityTile",
        "summary": "One bounded, pre-deconflicted Web Mercator XYZ tile",
        "description": "Answers from the node store only. The MODE IS THE SERVER'S: a tile holding at most 2048 sites ships every site, at most 4096 ships a deterministic stride sample, and above that ships a 16x16 density grid; `count` is always the tile's true population, never the number of points shipped. z outside [0,18] or x/y outside [0,2^z) is refused 400 rather than clamped. An empty store answers an empty tile and says so in the dataset block; it never fabricates sites. Anonymous, same reasoning as /aggregate.",
        "anonymous": true,
        "params": [
          {
            "name": "z",
            "in": "path",
            "required": true,
            "description": "Zoom level, 0-18 inclusive. Refused, never clamped.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "x",
            "in": "path",
            "required": true,
            "description": "Tile column, 0 <= x < 2^z. Refused, never clamped.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "y",
            "in": "path",
            "required": true,
            "description": "Tile row, 0 <= y < 2^z, north to south with the Web Mercator latitude clamp at +-85.05112878 degrees. Refused, never clamped.",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    ]
  }
}
