{
  "pluginId": "com.digitalarsenal.flows.catalog-builder.chain",
  "name": "Catalog exact-W chain",
  "version": "0.1.0",
  "description": "Runs the unchanged propagator methods with full usable bounds and reports a typed outcome beside the SGP4 fallback.",
  "pluginFamily": "propagator",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "threadModel": "emscripten-pthreads",
  "methods": [
    {
      "methodId": "run_chain",
      "displayName": "Build catalog candidate",
      "inputPorts": [
        {
          "portId": "omm",
          "acceptedTypeSets": [
            {
              "setId": "omm-typed",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "flight_config",
          "acceptedTypeSets": [
            {
              "setId": "flight_config-typed",
              "allowedTypes": [
                {
                  "schemaName": "PCF.fbs",
                  "fileIdentifier": "$PCF",
                  "rootTypeName": "PCF",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "fit_config",
          "acceptedTypeSets": [
            {
              "setId": "fit_config-typed",
              "allowedTypes": [
                {
                  "schemaName": "PCF.fbs",
                  "fileIdentifier": "$PCF",
                  "rootTypeName": "PCF",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        },
        {
          "portId": "weather",
          "acceptedTypeSets": [
            {
              "setId": "weather-typed",
              "allowedTypes": [
                {
                  "schemaName": "SPW.fbs",
                  "fileIdentifier": "$SPW",
                  "rootTypeName": "SPW",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "outputPorts": [
        {
          "portId": "fallback",
          "acceptedTypeSets": [
            {
              "setId": "fallback-typed",
              "allowedTypes": [
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "elements",
          "acceptedTypeSets": [
            {
              "setId": "elements-typed",
              "allowedTypes": [
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "decision",
          "acceptedTypeSets": [
            {
              "setId": "decision-typed",
              "allowedTypes": [
                {
                  "schemaName": "QRP.fbs",
                  "fileIdentifier": "$QRP",
                  "rootTypeName": "QRP",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "ingest_seed",
      "displayName": "Ingest a seed for policy fallback",
      "inputPorts": [
        {
          "portId": "omm",
          "acceptedTypeSets": [
            {
              "setId": "omm-typed",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "fallback",
          "acceptedTypeSets": [
            {
              "setId": "fallback-typed",
              "allowedTypes": [
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "decision",
          "acceptedTypeSets": [
            {
              "setId": "decision-typed",
              "allowedTypes": [
                {
                  "schemaName": "QRP.fbs",
                  "fileIdentifier": "$QRP",
                  "rootTypeName": "QRP",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [],
  "buildArtifacts": [
    {
      "artifactId": "catalog-chain-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1
}
