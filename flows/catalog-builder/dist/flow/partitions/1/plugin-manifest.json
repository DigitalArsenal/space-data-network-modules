{
  "pluginId": "com.digitalarsenal.flows.catalog-builder.partition-1",
  "name": "Catalog builder partition 1",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Timer-driven reconciliation over complete storage pages; exact-W AP selection with SGP4 fallback and independently timestamped population covariance.",
  "capabilities": [
    "clock",
    "storage_ingest",
    "storage_query"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.flows.catalog-builder.control",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.flatsql-query",
      "minVersion": "0.3.1",
      "maxVersion": "0.3.1"
    },
    {
      "pluginId": "com.digitalarsenal.flows.catalog-builder.chain",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.analysis.gp-error-model",
      "minVersion": "0.16.0",
      "maxVersion": "0.16.0"
    },
    {
      "pluginId": "com.digitalarsenal.analysis.catalog-composer",
      "minVersion": "0.7.0",
      "maxVersion": "0.7.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.6.1",
      "maxVersion": "0.6.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "flatsql-query-stream",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_query",
      "resource": "storage://flatsql",
      "description": "Host FlatSQL engine queries as SDS $PIV hostcalls: storage.flatsql_query_stream (operator surface, unsandboxed, auth-gated at the wall), storage.query_sandboxed and storage.query_surface (the public read-only surface). storage.index_page reads durable snapshot pages under the same storage_query grant.",
      "properties": {
        "hostOps": [
          "storage.flatsql_query_stream",
          "storage.query_sandboxed",
          "storage.query_surface",
          "storage.index_page"
        ]
      }
    },
    {
      "interfaceId": "host-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "description": "clock.now defaults a profile query's epoch to now (Go node built-in; capability-gated on the SDK hosts).",
      "properties": {
        "hostOps": [
          "clock.now"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "refresh",
      "displayName": "Flow trigger refresh",
      "description": "Compiled-flow ingress for trigger \"refresh\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "tick-typed",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "outputPorts": [
        {
          "portId": "notice",
          "acceptedTypeSets": [
            {
              "setId": "notice-typed",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
