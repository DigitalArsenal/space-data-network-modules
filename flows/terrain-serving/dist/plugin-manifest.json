{
  "pluginId": "com.digitalarsenal.flows.terrain-serving",
  "name": "Terrain Tile Serving Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "WASM-served quantized-mesh terrain (mount /api/v1/terrain/, config-mounted on the sdn-server lane). A $HTQ HttpRequest enters on the http-request trigger; terrain-source:route strips the mount up to and including the last \"/terrain/\" segment and takes exactly one of three paths. \"layer.json\" => a layer_plan frame for terrain-source:layer_json, which renders the complete tilejson-2.1.0 body (format quantized-mesh-1.0, scheme tms, EPSG:4326, extensions [watermask], availability VERBATIM from the flow config key terrain_available - the availability index is the ingest orchestrator's knowledge and is configured, not aggregated per request at first light) inside the canonical $HTR envelope. \"{z}/{x}/{y}.terrain\" => a {sql,params} frame for hostcap/flatsql-query:query (SELECT _data FROM DTT WHERE TILESET_ID/LEVEL/X/Y ORDER BY rowid DESC LIMIT 1 - the newest stored record for the address wins) plus a context frame carrying the address and the client's If-None-Match; terrain-source:respond walks the returned aligned size-prefixed $DTT stream and serves the record's payload BYTES VERBATIM (they are gzip-compressed at encode time) with content-type and content-encoding FROM THE RECORD, cache-control public max-age=86400 and a strong ETag (record ETAG, else payload DIGEST, else a weak address+size tag); an If-None-Match match answers 304 and an EMPTY stream answers a cheap CACHEABLE 404 (public, max-age=300) because a miss below the published pyramid is normal traffic - the client's own upsampling relies on layer.json availability. Any other path is a direct cacheable 404 from route; non-GET/HEAD answers 405. Bridge linkage: the only host crossings are the declared storage.flatsql_query_stream hostcall and plugin.getConfig.",
  "capabilities": [
    "storage_query"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.terrain-source",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.flatsql-query",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "flatsql-query-stream",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_query",
      "resource": "storage://flatsql",
      "description": "Host FlatSQL engine-native query streaming (storage.flatsql_query_stream). Served by the Go node today; browser-side flatsql stream ops are not exposed by the SDK BrowserHost storage adapter (server-only until flatsql ships as an in-wasm component dependency).",
      "properties": {
        "hostOps": [
          "storage.flatsql_query_stream",
          "storage.query_sandboxed",
          "storage.query_surface"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest"
                }
              ],
              "description": "One $HTQ HttpRequest envelope (module-sdk schemas/HttpRequestAbi.fbs)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The HTTP request to route."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR). The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": false,
          "description": "Direct $HTR for requests no other node should see: cacheable 404 for unknown paths, 405 for non-GET/HEAD."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_terrain_serving-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "route",
      "pluginId": "com.digitalarsenal.data-source.terrain-source",
      "methodId": "route",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
