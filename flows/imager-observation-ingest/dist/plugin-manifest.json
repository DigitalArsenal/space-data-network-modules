{
  "pluginId": "com.digitalarsenal.flows.imager-observation-ingest",
  "name": "Geostationary Imager Observation Ingest Flow",
  "version": "0.2.3",
  "pluginFamily": "flow",
  "description": "Hourly ingest of imager observations as raw per-satellite $WXF world products (owner 2026-10-07: SDN carries raw per-satellite fields; the world-clouds display derives the rest), kept for the node's retention window: GOES-East/West ABI (NOAA Open Data Dissemination's noaa-goes19/18), Himawari-9 AHI (noaa-himawari9: ISatSS tiles and the L2 cloud HDF5 files) and EUMETSAT's public view service (Meteosat-12 FCI, Meteosat-9 SEVIRI IODC, Metop-B/C AVHRR). timer -> plan (per satellite the frame hours of the window not yet landed: S3 listings, or view work jobs) -> http -> select_files (one work job per file or band of tiles) -> parse (the fetch engine: ONE job at a time; landed-mark probes first for GOES and Himawari, then the job's bytes through http_fetch, a sanctioned feedback cycle; one field's world product at 4096/2048/1024 wide per batch, 64-row band records quantized at the instrument's precision, SDS 1.238 encodings) -> storage-ingest -> publish_request (the field's landed mark, a one-byte GET the node's HTTP validator ledger remembers, so a restart does not fetch the window again; the dataset publication when imager_publish_url is set). Memory: one GOES-19 daytime 0.64 um full disc is ~430 MB (2026-10-14); the job holds it once (parts appended as they come) - run the service with memory_pages 24576 (1.5 GiB). Version 0.1.0 joined the parts beside the part frames and needed ~1.1 GiB, past its 16384 pages: the grow failed mid-run and the service landed nothing after. Cadence: hourly (retrieval_interval 1h); a tick drains at most 1000 invocations, so a fresh window's backfill takes several ticks.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.imager-observation-source",
      "minVersion": "0.2.3",
      "maxVersion": "0.2.3"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.imager-observation-parser",
      "minVersion": "0.2.3",
      "maxVersion": "0.2.3"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 100 MiB response ceiling lowered per request by max_bytes (exceeding the effective bound is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_imager",
      "displayName": "Flow trigger timer-imager",
      "description": "Compiled-flow ingress for trigger \"timer-imager\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Timer tick frame (content ignored).",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Cron timer tick frame produced by the flow runtime and consumed inside this flow only; it carries no payload of its own, so there is no SDS record to name."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-ingest-result-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "UTF-8 JSON host result: {\"schema\",\"inserted\",\"batch_id\",\"reconciled_duplicates\"?,\"reconciled_old_batches\"?,\"archived\"?,\"provenance\"?}."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Ingest result summary."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "WXF.fbs",
      "fileIdentifier": "$WXF",
      "rootTypeName": "WXF"
    }
  ],
  "runtimeTargets": [
