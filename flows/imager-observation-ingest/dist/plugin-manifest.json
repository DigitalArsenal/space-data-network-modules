{
  "pluginId": "com.digitalarsenal.flows.imager-observation-ingest",
  "name": "Geostationary Imager Observation Ingest Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Every linked guest is wasi-sequential; the flow dispatches them serially and delegates external concurrency to its host."
  },
  "description": "Hourly ingest of geostationary imager observations from NOAA Open Data Dissemination's anonymous public buckets (GOES-East and GOES-West ABI L1b/L2 NetCDF4) as raw per-satellite $WXF world products (owner 2026-10-07: SDN carries raw per-satellite fields; the world-clouds display derives the rest), on typed contracts 1.0 (no JSON frames). timer (TimerTick) -> plan (one S3 listing HttpRequest per satellite and product folder of the frame hour, its list job in HREQ.CONTEXT as a $WXF header record) -> http -> select_files (the listing HttpResponses echo their jobs; the hour's first full-disk scan of each wanted field; byte ranges above 64 MiB; each part's file job in CONTEXT; ONE FILE PER INVOCATION, the rest yielded as backlog) -> http -> parse (the field's world product at the imager_widths widths, 64-row band records, quantized at the instrument's precision, SDS 1.238 encodings; an IngestRequest per batch) -> storage-ingest (wxf_records) -> publish_request -> http (dataset publication, only when imager_publish_url is set; its body is the stored batch's IngestResult (INGR)). Skips and missing files are FlowNotices at the egress. Nodes are listed in pipeline order: the runtime's fair ready-node cursor then carries each file through parse and storage-ingest before select_files resumes with the next, so the parser holds one file and storage-ingest receives one meta and one record stream at a time. Memory: measured 566 MiB of linear memory for a cycle with the full-disk 0.5 km band (143 MB, three ranges) - run the service with memory_pages 16384 (1 GiB); the default 1024 (64 MiB) cannot hold one full-disk file. Cadence: hourly (set retrieval_interval to 1h; the host's default window is 3 h).",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.imager-observation-source",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.imager-observation-parser",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.6.0",
      "maxVersion": "0.6.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_imager",
      "displayName": "Flow trigger timer-imager",
      "description": "Compiled-flow ingress for trigger \"timer-imager\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK); its payload is not read."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-result",
              "allowedTypes": [
                {
                  "schemaName": "IngestResult.fbs",
                  "fileIdentifier": "INGR",
                  "rootTypeName": "IngestResult",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "IngestResult (module-sdk runtime type INGR): SCHEMA, PROVIDER_ID, SOURCE_NAME, BATCH_ID, INSERTED, RECONCILED_DUPLICATES, RECONCILED_OLD_BATCHES, ARCHIVED; or REFUSED saying why the batch was not stored (a value over its aligned bound, or a host refusal)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "EXACTLY ONE IngestResult per invocation."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "WXF.fbs",
      "fileIdentifier": "$WXF",
      "rootTypeName": "WXF"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
