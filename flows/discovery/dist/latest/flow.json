      "kind": "http-request",
      "source": "host-http",
      "description": "One $HTQ HttpRequest envelope per invocation, pumped by the host at the flow ingress."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "http-request",
      "targetNodeId": "route",
      "targetPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 16
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.foundation.http-route",
    "com.digitalarsenal.hostcap.p2p-discovery",
    "com.digitalarsenal.foundation.http-respond"
  ],
  "api": {
    "basePath": "/api/v1/peers/{peerId}/{standard}/latest",
    "tag": "data",
    "tagDescription": "Provider-scoped dataset retrieval (gateway loop G.4): any node serves any provider's newest published dataset it has OPT-IN pinned (gateway.pin), plus its own publications.",
    "routes": [
      {
        "path": "",
        "method": "GET",
        "operationId": "getPeerStandardLatest",
        "summary": "Provider's newest published dataset for a standard",
        "description": "The provider's newest published dataset of one standard, when this node serves it (pinned by the operator, or the node's own publication, and fully held): FlatBuffers by default as one size-prefixed stream - the $DAV (SDS Dataset Availability: batch, counts, publication notice and whether it verified, freshness, ETAG) followed by the dataset's records verbatim; ?format=json renders the records as a bare JSON array ($OMM only). A known but unservable dataset answers 503 with its $DAV (the newest notice's pointer: PNM_CID / PNM_FILE_ID / PNM_PUBLISHED_AT_MS) - never a silent proxy fetch; an unknown one 404 with its $DAV. If-None-Match equal to the $DAV ETAG answers 304.",
        "anonymous": true,
        "params": [
          {
            "name": "peerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "libp2p peer ID of the PUBLISHING provider (e.g. 16Uiu2HAm…)."
          },
          {
            "name": "standard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Space-data standard name (omm, cat, spw, …), case-insensitive."
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "flatbuffer",
                "json"
              ],
              "default": "flatbuffer"
            },
            "description": "Response encoding: flatbuffer = the aligned size-prefixed record stream of the published batch, VERBATIM (default). json = bare JSON array presentation (OMM only; other standards answer 406)."
          }
        ],
        "responses": {
          "200": {
            "description": "The dataset.",
            "content": {
              "application/vnd.sdn.flatbuffers.stream": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "Size-prefixed stream: the $DAV, then the dataset's records of the requested standard (x-sdn-record-count)."
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The dataset's records as a bare array ($OMM only)."
                }
              }
            }
          },
          "304": {
            "description": "Not modified: If-None-Match equals the $DAV ETAG."
          },
          "404": {
            "description": "No publication of the lane is known (not-published, with the $DAV), no route, or a standard this flow does not serve (not-served).",
            "content": {
              "application/x-flatbuffers": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "$DAV (SDS DAV.fbs): the availability record (KNOWN false)"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The $DAV, or {error, code}."
                }
              }
            }
          },
          "406": {
            "description": "JSON requested for a standard other than $OMM.",
            "content": {
              "application/x-flatbuffers": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "$APR (SDS APR.fbs): the refusal record (STATUS / ERROR_CODE / ERROR_MESSAGE)"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Known but not servable here (not pinned, not held, stale, unverified): dataset-unavailable.",
            "content": {
              "application/x-flatbuffers": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "$DAV (SDS DAV.fbs): the availability record with UNAVAILABLE_REASON and the newest notice's pointer"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The $DAV as JSON."
                }
              }
            }
          },
          "502": {
            "description": "The p2p.latest_dataset hostcall failed (host-failed).",
            "content": {
              "application/x-flatbuffers": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "$APR (SDS APR.fbs): the refusal record (STATUS / ERROR_CODE / ERROR_MESSAGE)"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    ]
  }
}
