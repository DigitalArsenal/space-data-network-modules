{
  "pluginId": "com.digitalarsenal.flows.latest-dataset",
  "name": "SDN Provider Latest Dataset Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Every linked guest is wasi-sequential; the flow dispatches them serially and delegates external concurrency to its host."
  },
  "description": "Gateway provider-latest-dataset flow (mount GET /api/v1/peers/{peerId}/{standard}/latest, loop G.4): foundation/http-route discover decides the request as an $APR (latest_dataset + peerId + standard); hostcap/p2p-discovery latest_dataset reads p2p.latest_dataset (typed $PIV, capability p2p_read; delivered out of band by host body reference - DAV BODY_REF_TOKEN -> $HTR BODY_REF - unless JSON is asked for, then inline) and answers a $DAV beside the $APR, with the batch's records on its standard's <code>_records port when the node serves it (STATUS 404 not-published / not-served, 503 dataset-unavailable with the $DAV); foundation/http-respond respond renders the $HTR: [$DAV][records] as one FlatBuffers stream by default, the records as JSON on request ($OMM), 304 on the $DAV ETAG. foundation/discovery-shape and foundation/omm-json are retired. Typed contracts 1.0: every edge carries one SDS FlatBuffers type; no JSON travels between nodes (JSON exists only as the client representation http-respond renders on request).",
  "capabilities": [
    "clock",
    "p2p_read"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "minVersion": "0.8.0",
      "maxVersion": "0.8.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.p2p-discovery",
      "minVersion": "0.4.0",
      "maxVersion": "0.4.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.3.1",
      "maxVersion": "0.3.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "sdn-host-p2p-discovery",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "p2p_read",
      "resource": "sdn://p2p/discovery",
      "description": "Policy-mediated read-only host discovery snapshots (peerstore + DHT + EPM registry + stored PNMs) as SDS $PIV hostcalls; node.peerId (ungated) names the verifier.",
      "properties": {
        "hostOps": [
          "p2p.peers_snapshot",
          "p2p.standards_snapshot",
          "p2p.pnm_history",
          "p2p.latest_dataset",
          "node.peerId"
        ]
      }
    },
    {
      "interfaceId": "host-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "description": "clock.now stamps NST.GENERATED_AT / PNV.GENERATED_AT_MS (0 when the clock is refused). Built-in on the Go node; capability-gated on the SDK hosts.",
      "properties": {
        "hostOps": [
          "clock.now"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP request envelope ($HTQ, module-sdk schemas/HttpRequestAbi.fbs): METHOD, PATH (no query string), QUERY (raw, URL-encoded), HEADERS (sorted, lower-cased names), BODY, REMOTE."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One $HTQ HttpRequest envelope as delivered verbatim by the host pipe."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one $HTR per HTTP exchange."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
