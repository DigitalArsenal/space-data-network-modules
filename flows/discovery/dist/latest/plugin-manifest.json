{
  "pluginId": "com.digitalarsenal.flows.latest-dataset",
  "name": "SDN Provider Latest Dataset Flow",
  "version": "0.1.2",
  "pluginFamily": "flow",
  "description": "HTTP provider-scoped latest-dataset flow (gateway loop G.4): a $HTQ HttpRequest enters on the http-request trigger, foundation/http-route discover emits the routing decision (latest_dataset with peerId + standard | not_found), hostcap/p2p-discovery latest_dataset issues the policy-mediated p2p.latest_dataset hostcall (the provider's newest signature-attributed publication batch when the host's OPT-IN gateway.pin covers the pair — or the peer is the node itself — AND the batch's shard content is fully materialized locally; stream delivery is a host body reference except on the json path), foundation/discovery-shape shape_latest turns the materials into the response decision (200 batch stream verbatim / body-reference descriptor; format=json routes the raw $OMM stream through foundation/omm-json for the bare-array presentation, non-OMM standards answer 406; unknown provider/standard answers an honest 404; known-but-unpinned or not-yet-materialized answers 503 with the newest signed-PNM pointer in the body — NO silent proxy fetch), and foundation/http-respond assembles the final $HTR envelope (200/304/404/406/503) delivered to the host-model egress sink. Bridge linkage: the only host crossing is the declared p2p_read hostcall.",
  "capabilities": [
    "p2p_read"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "minVersion": "0.7.0",
      "maxVersion": "0.7.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.p2p-discovery",
      "minVersion": "0.3.0",
      "maxVersion": "0.3.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.discovery-shape",
      "minVersion": "0.3.2",
      "maxVersion": "0.3.2"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.omm-json",
      "minVersion": "0.1.1",
      "maxVersion": "0.1.1"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.2.1",
      "maxVersion": "0.2.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "sdn-host-p2p-discovery",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "p2p_read",
      "resource": "sdn://p2p/discovery",
      "description": "Policy-mediated read-only host discovery snapshots (peerstore + DHT + EPM registry + stored PNMs).",
      "properties": {
        "hostOps": [
          "p2p.peers_snapshot",
          "p2p.standards_snapshot",
          "p2p.pnm_history",
          "p2p.latest_dataset"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest"
                }
              ],
              "description": "Canonical WASM-served HTTP request envelope ($HTQ, module-sdk schemas/HttpRequestAbi.fbs)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One HTTP request envelope as delivered verbatim by the host pipe."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one HTTP response envelope per invoke."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "HttpRequestAbi.fbs",
      "fileIdentifier": "$HTQ",
      "rootTypeName": "HttpRequest"
    },
    {
      "schemaName": "EPM.fbs",
      "fileIdentifier": "$EPM",
      "rootTypeName": "EPM"
    },
    {
      "schemaName": "PNM.fbs",
      "fileIdentifier": "$PNM",
      "rootTypeName": "PNM"
    },
    {
      "schemaName": "OMM.fbs",
      "fileIdentifier": "$OMM",
      "rootTypeName": "OMM"
    },
    {
      "schemaName": "HttpResponseAbi.fbs",
      "fileIdentifier": "$HTR",
      "rootTypeName": "HttpResponse"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_latest_dataset-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "route",
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "methodId": "discover",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "disc",
      "pluginId": "com.digitalarsenal.hostcap.p2p-discovery",
      "methodId": "latest_dataset",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "shape",
      "pluginId": "com.digitalarsenal.foundation.discovery-shape",
      "methodId": "shape_latest",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "tojson",
      "pluginId": "com.digitalarsenal.foundation.omm-json",
      "methodId": "encode",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "respond",
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "methodId": "respond",
      "kind": "responder",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "dispatchModel": "host-capability",
      "uiX": 0,
      "uiY": 0
    }
  ],
  "flowEdges": [
