{
  "programId": "com.digitalarsenal.flows.storage-object-s3",
  "name": "S3-Compatible Object Store",
  "version": "0.1.0",
  "description": "Object-store operations over any S3-compatible store (typed contracts 1.0: FlatBuffers only). One manual trigger delivers $APR operation tasks (ROUTE put | get | head | delete | list; PARAMETERS store, endpoint, region, bucket, key, ...) to storage/object-s3 sign, which turns each into a SigV4-signed HttpRequest for hostcap/http-request; the response is read by finish into a $APR result (and a $FIL listing for list). A put above multipartThreshold (16 MiB) runs the multipart stages: sign emits CreateMultipartUpload and forwards the task on held, http-request answers, split reads the UploadId and emits one signed UploadPart per partSize slice, a second http-request node answers the parts, assemble emits CompleteMultipartUpload (or AbortMultipartUpload and a refusal when any part failed), a third answers it, and a second finish node reads that response as the put's result. The credential never leaves the node: object-s3 holds only the secrets read grant and the clock, http-request holds only http, and the credential lane is written by storage/credentials, a separate artifact with the separate write grant.",
  "nodes": [
    { "nodeId": "sign", "pluginId": "com.digitalarsenal.storage.object-s3", "methodId": "sign", "kind": "transform", "capabilities": ["clock", "secrets:storage_r2", "secrets:storage_s3", "secrets:storage_b2", "secrets:storage_wasabi", "secrets:storage_minio", "secrets:storage_gcs", "secrets:storage_custom"], "drainPolicy": "single-shot" },
    { "nodeId": "http_first", "pluginId": "com.digitalarsenal.hostcap.http-request", "methodId": "request", "kind": "transform", "capabilities": ["http"], "drainPolicy": "single-shot" },
    { "nodeId": "split", "pluginId": "com.digitalarsenal.storage.object-s3", "methodId": "split", "kind": "transform", "capabilities": ["clock", "secrets:storage_r2", "secrets:storage_s3", "secrets:storage_b2", "secrets:storage_wasabi", "secrets:storage_minio", "secrets:storage_gcs", "secrets:storage_custom"], "drainPolicy": "single-shot" },
    { "nodeId": "http_parts", "pluginId": "com.digitalarsenal.hostcap.http-request", "methodId": "request", "kind": "transform", "capabilities": ["http"], "drainPolicy": "single-shot" },
    { "nodeId": "assemble", "pluginId": "com.digitalarsenal.storage.object-s3", "methodId": "assemble", "kind": "transform", "capabilities": ["clock", "secrets:storage_r2", "secrets:storage_s3", "secrets:storage_b2", "secrets:storage_wasabi", "secrets:storage_minio", "secrets:storage_gcs", "secrets:storage_custom"], "drainPolicy": "single-shot" },
    { "nodeId": "http_complete", "pluginId": "com.digitalarsenal.hostcap.http-request", "methodId": "request", "kind": "transform", "capabilities": ["http"], "drainPolicy": "single-shot" },
    { "nodeId": "finish_first", "pluginId": "com.digitalarsenal.storage.object-s3", "methodId": "finish", "kind": "transform", "capabilities": [], "drainPolicy": "single-shot" },
    { "nodeId": "finish_multipart", "pluginId": "com.digitalarsenal.storage.object-s3", "methodId": "finish", "kind": "transform", "capabilities": [], "drainPolicy": "single-shot" },
    { "nodeId": "egress", "pluginId": "sdn.flow.egress", "methodId": "emit", "kind": "sink", "drainPolicy": "single-shot" }
  ],
  "edges": [
    { "edgeId": "sign-requests-http_first-request", "fromNodeId": "sign", "fromPortId": "requests", "toNodeId": "http_first", "toPortId": "request", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "sign-result-egress-response", "fromNodeId": "sign", "fromPortId": "result", "toNodeId": "egress", "toPortId": "response", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "sign-held-split-object", "fromNodeId": "sign", "fromPortId": "held", "toNodeId": "split", "toPortId": "object", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "http_first-response-split-created", "fromNodeId": "http_first", "fromPortId": "response", "toNodeId": "split", "toPortId": "created", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "http_first-response-finish_first-responses", "fromNodeId": "http_first", "fromPortId": "response", "toNodeId": "finish_first", "toPortId": "responses", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "split-requests-http_parts-request", "fromNodeId": "split", "fromPortId": "requests", "toNodeId": "http_parts", "toPortId": "request", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "split-result-egress-response", "fromNodeId": "split", "fromPortId": "result", "toNodeId": "egress", "toPortId": "response", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "http_parts-response-assemble-parts", "fromNodeId": "http_parts", "fromPortId": "response", "toNodeId": "assemble", "toPortId": "parts", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "assemble-requests-http_complete-request", "fromNodeId": "assemble", "fromPortId": "requests", "toNodeId": "http_complete", "toPortId": "request", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "assemble-result-egress-response", "fromNodeId": "assemble", "fromPortId": "result", "toNodeId": "egress", "toPortId": "response", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "http_complete-response-finish_multipart-responses", "fromNodeId": "http_complete", "fromPortId": "response", "toNodeId": "finish_multipart", "toPortId": "responses", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "finish_first-result-egress-response", "fromNodeId": "finish_first", "fromPortId": "result", "toNodeId": "egress", "toPortId": "response", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "finish_first-listing-egress-response", "fromNodeId": "finish_first", "fromPortId": "listing", "toNodeId": "egress", "toPortId": "response", "backpressurePolicy": "queue", "queueDepth": 16 },
    { "edgeId": "finish_multipart-result-egress-response", "fromNodeId": "finish_multipart", "fromPortId": "result", "toNodeId": "egress", "toPortId": "response", "backpressurePolicy": "queue", "queueDepth": 16 }
  ],
  "triggers": [
    { "triggerId": "task", "kind": "manual", "source": "operator", "description": "One or more $APR operation tasks per run." }
  ],
  "triggerBindings": [
    { "triggerId": "task", "targetNodeId": "sign", "targetPortId": "task", "backpressurePolicy": "queue", "queueDepth": 16 }
  ],
  "requiredPlugins": ["com.digitalarsenal.storage.object-s3", "com.digitalarsenal.hostcap.http-request"]
}
