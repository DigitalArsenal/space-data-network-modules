{
  "pluginId": "com.digitalarsenal.flows.storage-object-s3",
  "name": "S3-Compatible Object Store",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Every linked guest is wasi-sequential; the flow dispatches them serially and delegates external concurrency to its host."
  },
  "description": "Object-store operations over any S3-compatible store (typed contracts 1.0: FlatBuffers only). One manual trigger delivers $APR operation tasks (ROUTE put | get | head | delete | list; PARAMETERS store, endpoint, region, bucket, key, ...) to storage/object-s3 sign, which turns each into a SigV4-signed HttpRequest for hostcap/http-request; the response is read by finish into a $APR result (and a $FIL listing for list). A put above multipartThreshold (16 MiB) runs the multipart stages: sign emits CreateMultipartUpload and forwards the task on held, http-request answers, split reads the UploadId and emits one signed UploadPart per partSize slice, a second http-request node answers the parts, assemble emits CompleteMultipartUpload (or AbortMultipartUpload and a refusal when any part failed), a third answers it, and a second finish node reads that response as the put's result. The credential never leaves the node: object-s3 holds only the secrets read grant and the clock, http-request holds only http, and the credential lane is written by storage/credentials, a separate artifact with the separate write grant.",
  "capabilities": [
    "clock",
    "http",
    "secrets:storage_b2",
    "secrets:storage_custom",
    "secrets:storage_gcs",
    "secrets:storage_minio",
    "secrets:storage_r2",
    "secrets:storage_s3",
    "secrets:storage_wasabi"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.storage.object-s3",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "task",
      "displayName": "Flow trigger task",
      "description": "Compiled-flow ingress for trigger \"task\" (manual).",
      "inputPorts": [
        {
          "portId": "task",
          "acceptedTypeSets": [
            {
              "setId": "sdn-api-request",
              "allowedTypes": [
                {
                  "schemaName": "APR.fbs",
                  "fileIdentifier": "$APR",
                  "rootTypeName": "APR",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "SDS $APR operation task: ROUTE, PARAMETERS (store, endpoint, region, bucket, key, ...), BODY for put."
            }
          ],
          "minStreams": 0,
          "maxStreams": 64,
          "required": false,
          "description": "The operation tasks."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-api-request",
              "allowedTypes": [
                {
                  "schemaName": "APR.fbs",
                  "fileIdentifier": "$APR",
                  "rootTypeName": "APR",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "SDS $APR result: REQUEST_ID and ROUTE echoed, STATUS the HTTP status (502 when the exchange failed), ERROR_CODE / ERROR_MESSAGE from the store, BODY the object bytes for get (a $FIL listing for list), PARAMETERS store / bucket / key, the store's headers (etag, content-length, content-type, last-modified, content-range) and uploadId / parts / size, keyCount / isTruncated / nextContinuationToken."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1024,
          "required": false,
          "description": "One result per task (or per refused task). Never a credential value."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
