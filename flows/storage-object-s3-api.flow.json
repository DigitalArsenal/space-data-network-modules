  "triggers": [
    {
      "triggerId": "http-request",
      "kind": "http-request",
      "source": "host-http",
      "httpPath": "/api/v1/storage/objects/",
      "description": "The ONE http trigger: one $HTQ HttpRequest envelope per exchange; PATH dispatch happens in-wasm (serve)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "http-request",
      "targetNodeId": "serve",
      "targetPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 16
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.storage.object-s3",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.foundation.http-respond"
  ],
  "api": {
    "tag": "storage-objects",
    "tagDescription": "S3-compatible object-store operations from this node's storage modules (R2, S3, B2, MinIO, Wasabi, GCS interoperability).",
    "routes": [
      {
        "path": "{store}/{bucket}/{key}",
        "method": "PUT",
        "operationId": "putStorageObject",
        "summary": "Put an object (multipart above 16 MiB)",
        "description": "The request body is the object. endpoint (https://host[:port]), region (default auto), style (path|virtual), contentType, cacheControl, partSize (>= 5 MiB, default 16 MiB), multipartThreshold (default 16 MiB), payload=signed|unsigned (unsigned over https by default) ride the query string. The signature uses the credential held on the lane storage_<store>. Answers the $APR result: STATUS, PARAMETERS (etag), PARAMETERS (uploadId, parts, size for a multipart put). NOT ANONYMOUS.",
        "anonymous": false,
        "params": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "description": "The store's endpoint, https://host[:port] (http only for loopback).",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "{store}/{bucket}/{key}",
        "method": "GET",
        "operationId": "getStorageObject",
        "summary": "Get an object or a byte range",
        "description": "Answers the $APR result whose BODY is the object bytes (Range header or range query for a slice; maxBytes bounds the body, 96 MiB by default). NOT ANONYMOUS.",
        "anonymous": false,
        "params": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "description": "The store's endpoint.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "{store}/{bucket}/{key}",
        "method": "HEAD",
        "operationId": "headStorageObject",
        "summary": "Object metadata",
        "description": "STATUS 200 with etag, content-length, content-type and last-modified in PARAMETERS, or 404 NotFound. NOT ANONYMOUS.",
        "anonymous": false,
        "params": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "description": "The store's endpoint.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "{store}/{bucket}/{key}",
        "method": "DELETE",
        "operationId": "deleteStorageObject",
        "summary": "Delete an object",
        "description": "STATUS 204 on success. NOT ANONYMOUS.",
        "anonymous": false,
        "params": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "description": "The store's endpoint.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "{store}/{bucket}",
        "method": "GET",
        "operationId": "listStorageObjects",
        "summary": "List objects under a prefix",
        "description": "ListObjectsV2: prefix, delimiter, maxKeys, continuationToken, startAfter. The $APR result's BODY is a $FIL Directory listing (ENTRIES: key, size, last-modified; common prefixes as directories); PARAMETERS carry keyCount, isTruncated and nextContinuationToken. NOT ANONYMOUS.",
        "anonymous": false,
        "params": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "description": "The store's endpoint.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    ]
  }
}
