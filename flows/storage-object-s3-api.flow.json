      "methodId": "assemble",
      "kind": "transform",
      "capabilities": [
        "clock",
        "secrets:storage_r2",
        "secrets:storage_s3",
        "secrets:storage_b2",
        "secrets:storage_wasabi",
        "secrets:storage_minio",
        "secrets:storage_gcs",
        "secrets:storage_custom"
      ],
      "drainPolicy": "single-shot"
    },
    {
