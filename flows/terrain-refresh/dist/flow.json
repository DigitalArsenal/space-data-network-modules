      "capabilities": [
        "clock"
      ],
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "sign_put",
      "pluginId": "com.digitalarsenal.storage.object-s3",
      "methodId": "sign",
      "kind": "transform",
      "capabilities": [
        "clock",
        "secrets:storage_r2"
      ],
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http_put",
