      "methodId": "request",
      "kind": "transform",
      "capabilities": [
        "http"
      ],
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "finish_put",
      "pluginId": "com.digitalarsenal.storage.object-s3",
      "methodId": "finish",
      "kind": "transform",
      "capabilities": [],
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "capabilities": [],
      "drainPolicy": "single-shot"
    }
  ],
