{
  "pluginId": "com.digitalarsenal.flows.terrain-refresh",
  "name": "Terrain Refresh: monthly source check",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "The monthly source check of the terrain refresh (owner 2026-10-21: terrain updates run on SDN nodes as modules and flows, not as Mac scripts). One timer tick (config body: moon | mars; one service instance per body) reaches data-source/terrain-source-watch plan, which asks every source file the terrain walk reads for its first byte through hostcap/http-request (the ETag, Last-Modified and total size of the publisher's file) and asks storage/object-s3 to list the raw/<naif>/ mirror in R2 (SigV4 with the credential on the node's storage_r2 lane, read grant only). diff compares the two against the ETags the walk is pinned to and answers a $QRP page - per source file: current, source-changed, source-newer, size-changed, not-mirrored or probe-failed, with the product's levels - which a second object-s3 sign stores at watch/<naif>/<yyyy-mm-dd>.qrp beside the mirror, plus one FlowNotice (Unchanged when nothing needs a refresh). A mirror the node cannot read (no credential, the store refusing) still yields the source half as a FlowNotice and stores nothing. This flow only OBSERVES: it fetches one byte per source and writes one small report object; the quarterly re-encode of the changed units is a separate flow that consumes the report. Capabilities: clock, http, and the READ grant on secrets:storage_r2 - no write grant, no storage, no wallet.",
  "capabilities": [
    "clock",
    "http",
    "secrets:storage_r2"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.terrain-source-watch",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.storage.object-s3",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "terrain_refresh_watch",
      "displayName": "Flow trigger terrain-refresh-watch",
      "description": "Compiled-flow ingress for trigger \"terrain-refresh-watch\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (TICK); its payload is not read."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "The timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-flow-notice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (FNTC): Info with the per-state counts and the changed files, Unchanged when nothing needs a refresh, Missing when the check is unconfigured or has no clock."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "The check's summary."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
