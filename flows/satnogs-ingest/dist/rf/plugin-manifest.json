{
  "pluginId": "com.digitalarsenal.flows.satnogs-rf-ingest",
  "name": "SatNOGS RF Ingest Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Every linked guest is wasi-sequential; the flow dispatches them serially and delegates external concurrency to its host."
  },
  "description": "Per-provider ingest flow, RF spectrum (typed contracts 1.0: every edge carries one FlatBuffer type, no JSON and no base64 between nodes): a cron TIMER (TimerTick) enters at satnogs-source:request, which emits ONE whole-table HttpRequest GET of the SatNOGS DB transmitters API (bulk, never a pagination walk) carrying the identifying User-Agent the source-policy.json fetch discipline mandates, its parse job in CONTEXT (one size-prefixed IngestRequest: schema, provider, source name and URL, reconcile None, archive naming). hostcap/http-request answers one HttpResponse (the BODY verbatim, the CONTEXT echoed); satnogs-source:parse reads the job from it, decodes ~4,994 transmitter rows into a size-prefixed $RFB record stream (batch = sha256 of the payload; Hz -> MHz per the normative RFB units rule; one record per LINK_DIRECTION so a Transceiver/Transponder becomes an UPLINK+DOWNLINK pair sharing ID_TRANSMITTER) with its IngestRequest and the HttpResponse as the raw document, and hostcap/storage-ingest persists it through the policy-mediated storage.ingest_with_source hostcall (IngestResult on egress 'result'). SatNOGS DB is CC-BY-SA-4.0: every record carries the attribution in CITATION and the batch's source tags carry LICENSE, LICENSE_URL, CITATION and SHARE_ALIKE, keeping the share-alike obligation contained to its own licence-marked batch. HTTP 304 Not Modified is a successful run with nothing new: parse emits one FlowNotice (Unchanged, not-modified) straight to egress 'notice' and no meta/records/raw frames, so storage-ingest never fires. All decisions live in-wasm; the host supplies only the http and storage connectors.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.satnogs-source",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.6.0",
      "maxVersion": "0.6.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_satnogs_rf",
      "displayName": "Flow trigger timer-satnogs-rf",
      "description": "Compiled-flow ingress for trigger \"timer-satnogs-rf\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK) from the flow's timer trigger."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick (its fields are not read)."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-result",
              "allowedTypes": [
                {
                  "schemaName": "IngestResult.fbs",
                  "fileIdentifier": "INGR",
                  "rootTypeName": "IngestResult",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "IngestResult (module-sdk runtime type INGR): SCHEMA, PROVIDER_ID, SOURCE_NAME, BATCH_ID, INSERTED, RECONCILED_DUPLICATES, RECONCILED_OLD_BATCHES, ARCHIVED; or REFUSED saying why the batch was not stored (a value over its aligned bound, or a host refusal)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "EXACTLY ONE IngestResult per invocation."
        },
        {
          "portId": "notice",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-flow-notice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (FNTC): KIND Unchanged, SCHEMA RFB.fbs, PROVIDER_ID, SOURCE_NAME, REASON not-modified, ITEMS the source URL, AT_MS the host's retrieval time."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Emitted ONLY when the fetch answered HTTP 304 Not Modified (the host sent the recorded ETag / Last-Modified validators): one notice frame and no meta/records/raw frames, so the ingest node never becomes ready and nothing is stored or announced."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "RFB.fbs",
      "fileIdentifier": "$RFB",
      "rootTypeName": "RFB"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_satnogs_rf_ingest-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "flowNodes": [
