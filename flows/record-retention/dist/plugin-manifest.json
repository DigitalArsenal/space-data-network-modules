{
  "pluginId": "com.digitalarsenal.flows.record-retention",
  "name": "SDN Record Retention Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Every linked guest is wasi-sequential; the flow dispatches them serially and delegates external concurrency to its host."
  },
  "description": "Hourly rolling-window retention (typed contracts 1.0): the host-cron timer's TimerTick enters data-source/record-retention expire, which asks the node (storage.expire, an SDS $PIV hostcall) to delete each configured lane's records that arrived on the node more than window_hours ago (node config; default 72 h over WXF from provider noaa-ncep), through the store's record index. Owner 2026-10-12, the weather node: a rolling 3-day window, configurable, never an archive. Each lane pass's FlowNotice (FNTC: Expired / Missing / Skipped) ends at the flow egress. No JSON.",
  "capabilities": [
    "storage_write"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.record-retention",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "record-expiry",
      "kind": "host-service",
      "direction": "output",
      "capability": "storage_write",
      "resource": "storage://records",
      "description": "storage.expire: delete one lane's records older than a cutoff, through the store's record index (sdn-server internal/storage/record_expiry.go).",
      "properties": {
        "hostOps": [
          "storage.expire"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_retention",
      "displayName": "Flow trigger timer-retention",
      "description": "Compiled-flow ingress for trigger \"timer-retention\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK); its payload is not read."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Cron timer tick (flows/record-retention.flow.json); a direct invoke needs none."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "required": false,
          "minStreams": 0,
          "maxStreams": 1024,
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-flow-notice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (module-sdk runtime type FNTC)."
            }
          ],
          "description": "One FlowNotice per lane pass: Expired (COUNT records deleted, SCHEMA / PROVIDER_ID / SOURCE_NAME the lane, AT_MS the cutoff, REASON the window and whether max_deletes capped it); Missing (COUNT records the index listed that were no longer stored, only when any); Skipped (a lane not visited because the pass's max_deletes was spent)."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "WXF.fbs",
      "fileIdentifier": "$WXF",
      "rootTypeName": "WXF"
    }
  ],
  "runtimeTargets": [
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_record_retention-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "expire",
      "pluginId": "com.digitalarsenal.data-source.record-retention",
      "methodId": "expire",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "dispatchModel": "host-capability",
      "uiX": 0,
      "uiY": 0
    }
  ],
  "flowEdges": [
    {
      "edgeId": "expire-report",
      "fromNodeId": "expire",
      "fromPortId": "report",
      "toNodeId": "egress",
      "toPortId": "response",
      "contract": {
        "canonicalType": {
          "schemaName": "FlowNotice.fbs",
          "fileIdentifier": "FNTC",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "FlowNotice",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": false,
        "routePolicy": "canonical-only"
      }
    }
  ],
  "flowTriggers": [
    {
      "triggerId": "timer-retention",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 3600000,
      "httpPath": null
    }
  ],
  "flowTriggerBindings": [
    {
      "triggerId": "timer-retention",
      "targetNodeId": "expire",
      "targetPortId": "tick"
    }
  ],
  "abiVersion": 1
}
