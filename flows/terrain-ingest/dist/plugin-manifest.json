  "externalInterfaces": [
    {
      "interfaceId": "flatsql-query-stream",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_query",
      "resource": "storage://flatsql",
      "description": "Host FlatSQL engine-native query streaming (storage.flatsql_query_stream). Served by the Go node today; browser-side flatsql stream ops are not exposed by the SDK BrowserHost storage adapter (server-only until flatsql ships as an in-wasm component dependency).",
      "properties": {
        "hostOps": [
          "storage.flatsql_query_stream",
          "storage.query_sandboxed",
          "storage.query_surface"
        ]
      }
    },
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 100 MiB response ceiling lowered per request by max_bytes (exceeding the effective bound is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    },
    {
      "interfaceId": "host-storage-write",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_write",
      "resource": "sdn://storage/write",
      "description": "Schema-typed single-record write through the host storage.write hostcall (kubo/sdn/sdnservices/storage_cap.go).",
      "properties": {
        "hostOps": [
          "storage.write"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_terrain_ingest",
      "displayName": "Flow trigger timer-terrain-ingest",
      "description": "Compiled-flow ingress for trigger \"timer-terrain-ingest\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Cron timer tick (content ignored).",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Intra-flow control frame produced and consumed inside this flow; its shape is defined by the host op or the sibling node it feeds, not by SDS."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick (content ignored)."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "terrain-mark-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "The advanced resume mark: next_tile_index = first_tile_index + tiles_planned, plus the upstream ETag that rides out on the next batch's plan entries.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Intra-flow control frame produced and consumed inside this flow; its shape is defined by the host op or the sibling node it feeds, not by SDS."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": false,
          "description": "The advanced resume mark."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
