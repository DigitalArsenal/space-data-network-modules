  "externalInterfaces": [
    {
      "interfaceId": "flatsql-query-stream",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_query",
      "resource": "storage://flatsql",
      "description": "Host FlatSQL engine queries as SDS $PIV hostcalls: storage.flatsql_query_stream (operator surface, unsandboxed, auth-gated at the wall), storage.query_sandboxed and storage.query_surface (the public read-only surface).",
      "properties": {
        "hostOps": [
          "storage.flatsql_query_stream",
          "storage.query_sandboxed",
          "storage.query_surface"
        ]
      }
    },
    {
      "interfaceId": "host-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "description": "clock.now defaults a profile query's epoch to now (Go node built-in; capability-gated on the SDK hosts).",
      "properties": {
        "hostOps": [
          "clock.now"
        ]
      }
    },
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    },
    {
      "interfaceId": "host-storage-write",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_write",
      "resource": "sdn://storage/write",
      "description": "Schema-typed single-record write through the host storage.write hostcall, sent as an SDS $PIV invocation (StorageWriteParams + raw data -> StorageWriteResult CID).",
      "properties": {
        "hostOps": [
          "storage.write"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_terrain_ingest",
      "displayName": "Flow trigger timer-terrain-ingest",
      "description": "Compiled-flow ingress for trigger \"timer-terrain-ingest\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (TICK) from the flow's timer trigger; its fields are not read."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick (content ignored)."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sds-fso-status",
              "allowedTypes": [
                {
                  "schemaName": "FSO.fbs",
                  "fileIdentifier": "$FSO",
                  "rootTypeName": "FSO",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "$FSO (SDS FSO): OPERATION QUERY_RECORDS, REQUEST_ID, STATUS COMPLETE (AFFECTED_RECORDS rows, RESULT_BYTES) or INVALID_ARGUMENT / RESOURCE_EXHAUSTED / INTERNAL_ERROR with ERROR_CODE (invalid-control-frame, unsupported-parameter, query-failed) and MESSAGE."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one status frame per invocation."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
