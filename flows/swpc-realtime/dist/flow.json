    {
      "nodeId": "parse-sws",
      "pluginId": "com.digitalarsenal.data-source.swpc-realtime",
      "methodId": "parse_sws",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest-sws",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress-sws",
