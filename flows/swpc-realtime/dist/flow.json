{
  "programId": "com.digitalarsenal.flows.swpc-realtime",
  "name": "NOAA SWPC real-time",
  "version": "0.2.0",
  "engineLinkage": "bridge",
  "description": "NOAA public-domain SWS, SWA and lossless SFE flares (SDS 1.274.0).",
