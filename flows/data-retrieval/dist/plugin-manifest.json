{
  "pluginId": "com.digitalarsenal.flows.data-retrieval",
  "name": "SDN Data Retrieval Flow",
  "version": "0.3.0",
  "pluginFamily": "flow",
  "description": "HTTP data-retrieval flow (mount /api/v1/data): foundation/http-route route decides the $HTQ request as a $QRP - \"/<code>/bulk\" -> \"bulk\" (any SDS standard: SCHEMA_NAME, SOURCE_NAME, TIME_PROFILE, PROFILE_EPOCH_MS, LIMIT, representation, If-None-Match), \"/query\" -> \"query\" (SQL + typed PARAMETERS), anything else -> \"refusal\" (a $QRP Error straight to the responder); data-source/retrieval omm_bulk resolves the epoch profile (request > config > defaults) and reads storage.flatsql_epoch_stream, data_query runs storage.flatsql_query_stream (typed $PIV hostcalls, capability storage_query; ?profile=all reads every record of the lane through storage.flatsql_query_stream; records are delivered out of band by host body reference - QRP BODY_REF_TOKEN -> $HTR BODY_REF - unless JSON is asked for, then inline), each answering the $QRP request beside a $QRP page (the page header with RECORD_COUNT and the FNV-1a entity tag, then the records verbatim); foundation/http-respond respond_query renders the $HTR (200 / 304 / refusal status): the page stream verbatim as FlatBuffers by default, the records as JSON on request ($OMM). engineLinkage bridge: the retrieval node reaches the store over the storage hostcall bridge; FlatSQL is an independently signed node, never linked into this artifact. foundation/decision-gate and foundation/omm-json are no longer in the graph: the router's typed ports dispatch and the responder renders. Typed contracts 1.0: every edge carries one SDS FlatBuffers type; no JSON travels between nodes (JSON exists only as the client representation http-respond renders on request).",
  "capabilities": [
    "clock",
    "storage_query"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.foundation.http-route",
      "minVersion": "0.8.0",
      "maxVersion": "0.8.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.retrieval",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.3.0",
      "maxVersion": "0.3.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "flatsql-retrieval",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_query",
      "resource": "storage://flatsql",
      "description": "Host FlatSQL engine-native retrieval ops as SDS $PIV hostcalls: storage.flatsql_epoch_stream (EpochStreamParams -> StreamResult + raw stream) and storage.flatsql_query_stream (SqlStreamParams + raw sql + list sql_params -> StreamResult + raw stream).",
      "properties": {
        "hostOps": [
          "storage.flatsql_epoch_stream",
          "storage.flatsql_query_stream"
        ]
      }
    },
    {
      "interfaceId": "host-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "description": "clock.now defaults omm_bulk's epoch when neither the request nor the config states one; plugin.getConfig (ungated) supplies the per-standard profile defaults.",
      "properties": {
        "hostOps": [
          "clock.now",
          "plugin.getConfig"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequestAbi.fbs",
                  "fileIdentifier": "$HTQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP request envelope ($HTQ, module-sdk schemas/HttpRequestAbi.fbs): METHOD, PATH (no query string), QUERY (raw, URL-encoded), HEADERS (sorted, lower-cased names), BODY, REMOTE."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "One $HTQ HttpRequest envelope as delivered verbatim by the host pipe."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one $HTR per HTTP exchange."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
