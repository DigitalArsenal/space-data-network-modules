{
  "name": "@digitalarsenal/sdn-flow-data-retrieval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sdn-module": "./dist/isomorphic/module.wasm",
  "scripts": {
    "build": "node ../../node_modules/space-data-module-sdk/bin/space-data-module.js flow compile ../data-retrieval.flow.json --deps ../data-retrieval.deps.json --out ./dist",
    "check": "node ../../node_modules/space-data-module-sdk/bin/space-data-module.js flow check ../data-retrieval.flow.json --deps ../data-retrieval.deps.json",
    "test": "node --test tests/*.test.mjs",
    "sign": "node scripts/publish-sign.mjs"
  },
  "devDependencies": {
    "space-data-module-sdk": "0.8.24"
  }
}
