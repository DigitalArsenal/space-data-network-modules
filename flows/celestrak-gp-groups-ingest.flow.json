{
  "programId": "com.digitalarsenal.flows.celestrak-gp-groups-ingest",
  "name": "CelesTrak GP Groups Ingest Flow",
  "version": "0.2.0",
  "engineLinkage": "bridge",
  "description": "Per-provider ingest flow for the CelesTrak GP group queries (47 GROUP tokens plus the gpz / gpz-plus SPECIAL queries, overridable via node CONFIG celestrak_gp_groups). Typed contracts 1.0 (FlatBuffers only, no JSON and no base64): the timer's TimerTick enters the request builder; each HttpRequest carries its job - one size-prefixed $ICN (Ingest Connector) record naming the lane, the URL, the origin, the dataset and the usage terms - in CONTEXT, which hostcap/http-request echoes in the HttpResponse, so the parser reads its job from the response itself and nothing is paired by position. celestrak-reference:gp_groups emits one HttpRequest per group, each carrying its own $ICN (CONNECTOR_ID celestrak-gp-groups/<TOKEN>, the group URL); hostcap/http-request answers one HttpResponse per request; celestrak-reference:parse_gp_groups reads each response's group from its CONTEXT, re-resolves the group plan from the same node CONFIG and refuses the snapshot unless exactly one response per planned group arrived (any order; output and batch in plan order), then emits one $EGP (Entity Group, QUERY_SNAPSHOT membership over the group's OMM rows) per group with its IngestRequest (batch = sha256 of the concatenated payloads, reconcile Current for a complete snapshot, Duplicates when some groups answered 304; the concatenation archived as celestrak/gp-groups.csv through a raw HttpResponse); hostcap/storage-ingest persists through the policy-mediated storage.ingest_with_source hostcall. The optional OMM re-emission lane (node CONFIG celestrak_gp_groups_emit_omm) stores the group rows as $OMM when enabled. Egress: result (IngestResults), notice (FlowNotice Unchanged naming the groups that answered 304). All decisions live in-wasm.",
  "nodes": [
    {
      "nodeId": "req",
      "pluginId": "com.digitalarsenal.data-source.celestrak-reference",
      "methodId": "gp_groups",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.celestrak-reference",
      "methodId": "parse_gp_groups",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_egp",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_omm",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "req-http",
      "fromNodeId": "req",
      "fromPortId": "request",
      "toNodeId": "http",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 64
    },
    {
      "edgeId": "http-parse",
      "fromNodeId": "http",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "response",
      "backpressurePolicy": "queue",
      "queueDepth": 64
    },
    {
      "edgeId": "parse-egp-meta",
      "fromNodeId": "parse",
      "fromPortId": "egp_meta",
      "toNodeId": "ingest_egp",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-egp-records",
      "fromNodeId": "parse",
      "fromPortId": "egp_records",
      "toNodeId": "ingest_egp",
      "toPortId": "egp_records",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-egp-raw",
      "fromNodeId": "parse",
      "fromPortId": "raw",
      "toNodeId": "ingest_egp",
      "toPortId": "raw",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-omm-meta",
      "fromNodeId": "parse",
      "fromPortId": "omm_meta",
      "toNodeId": "ingest_omm",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-omm-records",
      "fromNodeId": "parse",
      "fromPortId": "omm_records",
      "toNodeId": "ingest_omm",
      "toPortId": "omm_records",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-unchanged-egress",
      "fromNodeId": "parse",
      "fromPortId": "unchanged",
      "toNodeId": "egress",
      "toPortId": "notice",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-egp-egress",
      "fromNodeId": "ingest_egp",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-omm-egress",
      "fromNodeId": "ingest_omm",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "triggers": [
    {
      "triggerId": "timer-gp-groups",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 86400000,
      "description": "GP group snapshot timer (24 h)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-gp-groups",
      "targetNodeId": "req",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 1
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.celestrak-reference",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.hostcap.storage-ingest"
  ]
}
