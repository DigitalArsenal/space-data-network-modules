  "triggers": [
    {
      "triggerId": "element_sets",
      "kind": "manual",
      "source": "host",
      "description": "A source's element-set history ($OMM, newest and older sets of each object) in one frame."
    },
    {
      "triggerId": "element_sets_mpe",
      "kind": "manual",
      "source": "host",
      "description": "An element-set history as the GP history archive stores it ($MPE, one frame): the same lane as element_sets after epoch-state omm_from_mpe."
    },
    {
      "triggerId": "models",
      "kind": "manual",
      "source": "host",
      "description": "The orbit error models of rules 3 and 4 ($ERM MODEL records, size-prefixed, any number in one frame): analysis/gp-error-model data/e14-s3-kc.erm with the sources it is the own model of and POOLED set (recipe.mjs modelsFor)."
    },
    {
      "triggerId": "fit_omm",
      "kind": "manual",
      "source": "host",
      "description": "The SGP4 element set fitted to an ephemeris or to an estimated arc ($OMM; analysis/od fit, aligned or canonical): the product's element set."
    },
    {
      "triggerId": "ephemeris",
      "kind": "manual",
      "source": "host",
      "description": "An operator ephemeris ($OEM, one object): its covariance lines, when it has them, are rule 1. It is also the ephemeris the fit was made to."
    },
    {
      "triggerId": "ephemeris_versions",
      "kind": "manual",
      "source": "host",
      "description": "The ephemeris versions of the same object ($OEM, one per version, issue time in CREATION_DATE) for planned-against-executed maneuver detection."
    },
    {
      "triggerId": "planned_maneuvers",
      "kind": "manual",
      "source": "host",
      "description": "The operator's planned maneuvers ($MNV)."
    },
    {
      "triggerId": "fit",
      "kind": "manual",
      "source": "host",
      "description": "The state and formal covariance of the observation fit ($OCM): rule 2."
    }
  ],
