  "refused": [
    {
      "module": "data-source/celestrak-supgp",
      "registry": [],
      "check": "no-orbit-output",
      "reason": "Pull-only: it parses CelesTrak's supplemental GP of SES, Planet, Iridium, Telesat, Kuiper, AST and the China Space Station inside `pull` and stores each object. No method gives the $OMM records to a flow.",
