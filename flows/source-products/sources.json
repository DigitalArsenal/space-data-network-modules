    },
    {
      "module": "data-source/gps-source",
      "registry": [],
      "check": "no-orbit-output",
      "reason": "Pull-only, and its $OMM sets are GPS almanac elements (theory GPS-LNAV-ALMANAC), not SGP4: epoch-state and the SGP4 error model refuse them. GPS precise orbits are the ephemeris source.",
      "task": "modules-sp3-precise-source-20261011"
    },
    {
