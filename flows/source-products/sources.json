{
  "version": 1,
  "flow": "com.digitalarsenal.flows.source-products",
  "about": "Every orbit data-source module of this repository and where it enters the flow. `sources` lists the ones that give products, with the recipe facts of each source; `refused` the ones that cannot, with the reason; `support` the ones that describe sources or identify objects; `missing` the sources that have no module yet, with the graph task that builds it. tests/sources.test.mjs holds the file to the modules' manifests and to the flow.",
  "licence": {
    "audit": "orbit-accuracy-experiments data/licenses.json, checked 2026-10-10; `id` is the audit's source id, `class` its `reproduce` field",
    "classes": {
      "reproducible": "reproduce: yes. The records may be republished with the credit the terms ask.",
      "cite-only": "reproduce: no. The records are computed on and cited, never republished.",
      "share-alike": "reproduce: share-alike.",
      "non-commercial": "reproduce: non-commercial."
    }
  },
  "model": {
    "file": "../../analysis/gp-error-model/data/e14-s3-kc.json",
    "about": "The model of rule 3 for the sources marked `ownModel` (E14 measured it on their element sets); every other source gets it pooled (rule 4). Rows are labelled CALIBRATED only where the model's cell was REALISTIC on the held-out window and the source's lineage is one the model was measured on."
  },
  "lanes": {
    "element-set": {
      "ingress": [
        "element_sets or element_sets_mpe",
        "element_set_recipe"
      ],
      "products": "The newest set of each object: its epoch states and a covariance by rule (3, else 4). The history: maneuvers by the detector's two passes with SGP4 answering the propagator query port."
    },
    "ephemeris": {
      "ingress": [
        "fit_omm",
        "ephemeris",
        "ephemeris_versions",
        "planned_maneuvers",
        "fit_recipe"
      ],
      "products": "The newest fitted set and its states with a covariance by rule (1 when the operator's ephemeris carries covariance lines, else 3 or 4). Maneuvers from the history of fitted sets, and from the versions against the planned maneuvers."
    },
    "observation": {
      "ingress": [
        "fit_omm",
        "fit",
        "fit_recipe"
      ],
      "estimator": {
        "module": "analysis/estimation",
        "method": "run_estimation",
        "inputs": [
          "laser_tracking",
          "tracking_data"
        ],
        "output": "ocm",
        "into": {
          "trigger": "fit",
          "port": "fit"
        }
      },
      "products": "The fitted set and the estimate's formal covariance times the realism factor measured for the source and fit class (rule 2).",
      "sources": []
    }
  },
  "sources": [
    {
      "id": "celestrak-gp",
      "registry": [],
      "kind": "element-set",
      "originator": "CelesTrak",
      "lineage": "space-track-gp",
      "licence": {
        "class": "cite-only",
        "id": "celestrak"
      },
      "ownModel": true,
      "via": [
        {
          "module": "data-source/celestrak-reference",
          "method": "parse_gp_groups",
          "port": "omm_records",
          "type": "$OMM",
          "into": [
            {
              "trigger": "element_sets",
              "port": "omm"
            }
          ]
        },
        {
          "module": "data-source/celestrak-parser",
          "method": "parse_gp",
          "port": "omm_records",
          "wildcard": true,
          "type": "$OMM",
          "into": [
            {
              "trigger": "element_sets",
              "port": "omm"
            }
          ]
        }
      ],
      "limits": [
        "celestrak-parser types its record ports with a wildcard; the records on omm_records are $OMM."
      ]
    },
    {
      "id": "space-track-gp",
      "registry": [
        "space-track"
      ],
      "kind": "element-set",
      "originator": "Space-Track.org",
      "lineage": "space-track-gp",
      "licence": {
        "class": "cite-only",
        "id": "space-track"
      },
      "ownModel": true,
      "via": [
        {
          "module": "data-source/gp-archive-records",
          "method": "build_mpe",
          "port": "records",
          "type": "$MPE",
          "into": [
            {
              "trigger": "element_sets_mpe",
              "port": "mpe"
            }
          ]
        },
        {
          "module": "data-source/retrieval",
          "method": "omm_bulk",
          "port": "stream",
          "type": "$OMM",
          "into": [
            {
              "trigger": "element_sets",
              "port": "omm"
            }
          ]
        },
        {
          "module": "data-source/spacetrack-source",
          "method": "parse_gp",
          "port": "omm",
          "type": "$OMM",
          "into": [
            {
              "trigger": "element_sets",
              "port": "omm"
            }
          ]
        }
      ],
      "limits": [
        "spacetrack-source reads the REST API's gp and gp_history JSON, up to 256 MiB a response; its parse_satcat gives the $CAT of the SATCAT, which the $CAT integrator's identity step reads and this flow does not take.",
        "gp-archive-records builds the $MPE the node's bulk import stores (`sdn import-gp-archive`); retrieval returns what the node's store holds: the request names the dataset, and the recipe must name the source that dataset came from.",
        "A stream whose records are separated by zero-length padding prefixes is read by epoch-state and gp-error-model but refused by detect_maneuvers; pass the stream without padding."
      ]
    },
    {
      "id": "spacex-starlink",
      "registry": [
        "spacex-starlink"
      ],
      "kind": "ephemeris",
      "originator": "SpaceX",
      "lineage": "spacex-starlink-meme",
      "licence": {
        "class": "reproducible",
        "id": "spacex-starlink"
      },
      "ownModel": false,
      "via": [
        {
          "module": "data-source/spacex-starlink-source",
          "method": "emit",
          "port": "oem",
          "type": "$OEM",
          "into": [
            {
              "trigger": "ephemeris",
              "port": "operator"
            },
            {
              "trigger": "ephemeris_versions",
              "port": "versions"
            }
          ]
        }
      ],
      "fit": {
        "module": "flows/supplemental-omm/nodes/od",
        "method": "fit",
        "input": "starlink",
        "output": "omm",
        "unwrap": "$FSB",
        "into": {
          "trigger": "fit_omm",
          "port": "omm"
        }
      },
      "limits": [
        "SpaceX publishes a 21-element UVW covariance with every state. The source parses it past and does not carry it into the OEM, so rule 1 does not apply to Starlink until it does (modules-starlink-meme-covariance-20261011)."
      ]
    },
