      "fromNodeId": "parse_txt",
      "fromPortId": "raw",
      "toNodeId": "ingest_txt",
      "toPortId": "raw",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-csv-meta",
      "fromNodeId": "parse_csv",
      "fromPortId": "cat_meta",
      "toNodeId": "ingest_csv",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-csv-records",
      "fromNodeId": "parse_csv",
      "fromPortId": "cat_records",
      "toNodeId": "ingest_csv",
      "toPortId": "records",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-csv-raw",
      "fromNodeId": "parse_csv",
      "fromPortId": "raw",
