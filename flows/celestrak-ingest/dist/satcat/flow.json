  "triggers": [
    {
      "triggerId": "timer-satcat",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 86400000,
      "description": "SATCAT snapshot sync timer (runner SatcatInterval default, 24 h)."
    }
  ],
  "triggerBindings": [
