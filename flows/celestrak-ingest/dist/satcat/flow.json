{
  "programId": "com.digitalarsenal.flows.celestrak-satcat-ingest",
  "name": "CelesTrak SATCAT Ingest Flow",
  "version": "0.2.0",
  "engineLinkage": "bridge",
  "description": "Per-provider ingest flow, SATCAT snapshot. Typed contracts 1.0 (FlatBuffers only, no JSON and no base64): the timer's TimerTick enters the request builder; each HttpRequest carries its job - one size-prefixed $ICN (Ingest Connector) record naming the lane, the URL, the origin, the dataset and the usage terms - in CONTEXT, which hostcap/http-request echoes in the HttpResponse, so the parser reads its job from the response itself and nothing is paired by position. celestrak-request:satcat emits BOTH source fetches (legacy fixed-width satcat.txt and satcat.csv - runner dual-source parity, 32 MiB budget each); two hostcap/http-request nodes fetch, two celestrak-parser:parse_satcat nodes normalize into $CAT record streams with IngestRequests (batch = sha256 of each payload, reconcile Current since only the newest snapshot batch is meaningful, archived as celestrak/satcat.txt and celestrak/satcat.csv), and two hostcap/storage-ingest nodes persist through the policy-mediated storage.ingest_with_source hostcall. After each store celestrak-request:publish_request joins the IngestResult with the parser's IngestRequest and (only when node CONFIG carries celestrak_publish_url) emits the loopback dataset-publication POST, its body the IngestResult. Egress: result (IngestResult), notice (FlowNotice Unchanged on HTTP 304), publication (the publication HttpResponses). All decisions live in-wasm.",
  "nodes": [
    {
      "nodeId": "req",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "satcat",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http_txt",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http_csv",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse_txt",
      "pluginId": "com.digitalarsenal.data-source.celestrak-parser",
      "methodId": "parse_satcat",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse_csv",
      "pluginId": "com.digitalarsenal.data-source.celestrak-parser",
      "methodId": "parse_satcat",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_txt",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
