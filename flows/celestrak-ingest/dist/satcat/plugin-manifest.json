{
  "pluginId": "com.digitalarsenal.flows.celestrak-satcat-ingest",
  "name": "CelesTrak SATCAT Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Per-provider ingest flow (loop C.8a), SATCAT snapshot: a module cron TIMER tick enters at celestrak-request:satcat which emits BOTH source fetches (legacy fixed-width satcat.txt and satcat.csv — runner dual-source parity); two hostcap/http-request nodes fetch, two celestrak-parser:parse_satcat nodes normalize into CAT record streams (batch = sha256 of each payload, reconcile mode 'current' since only the newest snapshot batch is meaningful), and two hostcap/storage-ingest nodes persist through the policy-mediated storage.ingest_with_source cap op. Results land on the egress sink. After each store, celestrak-request:publish_request joins that ingest result with the parser meta and (only when node CONFIG carries celestrak_publish_url) emits the loopback dataset-publication POST that a second hostcap/http-request node drives per lane; the publication responses also land on the egress sink. All decisions live in-wasm.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.celestrak-parser",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 4 MiB response cap, 30 s default timeout. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_satcat",
      "displayName": "Flow trigger timer-satcat",
      "description": "Compiled-flow ingress for trigger \"timer-satcat\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Timer tick frame (content ignored)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-ingest-result-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "UTF-8 JSON host result: {\"schema\",\"inserted\",\"batch_id\",\"reconciled_duplicates\"?,\"reconciled_old_batches\"?,\"archived\"?,\"provenance\"?}."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Ingest result summary."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_celestrak_satcat_ingest-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
