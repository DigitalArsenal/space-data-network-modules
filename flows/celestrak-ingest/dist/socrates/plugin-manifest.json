{
  "pluginId": "com.digitalarsenal.flows.celestrak-socrates-ingest",
  "name": "CelesTrak SOCRATES Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Per-provider ingest flow, SOCRATES conjunctions: a module cron TIMER tick enters at celestrak-request:socrates, which fans out to BOTH sort files (sort-minRange.csv and sort-maxProb.csv; URLs, byte budget and usage terms from node CONFIG / the origin registry); two hostcap/http-request nodes fetch them with the recorded ETag / Last-Modified validators, two celestrak-parser:parse_socrates nodes normalize each into a $CSM record stream (nested CAT identities with the status suffix split into OPS_STATUS_CODE, TCA as unix seconds with the published fraction; batch = sha256 of the payload; HTTP 304 emits one unchanged notice to the egress sink and stores nothing), and two hostcap/storage-ingest nodes persist them under their own source tags with reconcile \"current\" (each sort file is a snapshot of the current conjunction list). Results land on the egress sink. After each store, celestrak-request:publish_request joins that ingest result with the parser meta and (only when node CONFIG carries celestrak_publish_url) emits the loopback dataset-publication POST that a second hostcap/http-request node drives; the publication responses also land on the egress sink. All decisions live in-wasm.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.celestrak-parser",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 100 MiB response ceiling lowered per request by max_bytes (exceeding the effective bound is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_socrates",
      "displayName": "Flow trigger timer-socrates",
      "description": "Compiled-flow ingress for trigger \"timer-socrates\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Timer tick frame (content ignored).",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Host cron timer tick frame ({firedAt}) delivered by the flow trigger binding; its content is ignored and it is never persisted."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-ingest-result-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "UTF-8 JSON host result: {\"schema\",\"inserted\",\"batch_id\",\"reconciled_duplicates\"?,\"reconciled_old_batches\"?,\"archived\"?,\"provenance\"?}."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Ingest result summary."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
