{
  "programId": "com.digitalarsenal.flows.celestrak-eop-ingest",
  "name": "CelesTrak Earth Orientation Ingest Flow",
  "version": "0.1.0",
  "engineLinkage": "bridge",
  "description": "Per-provider ingest flow, Earth orientation: a module cron TIMER tick enters at celestrak-request:eop (URL, byte budget and usage terms from node CONFIG / the origin registry), hostcap/http-request fetches EOP-All.csv with the recorded ETag / Last-Modified validators, celestrak-parser:parse_eop normalizes it into an EOP record stream (arcsecond columns to radians in the double-precision _HP fields with float32 copies, DAT to TAI_MINUS_UTC_SECONDS, DATA_TYPE O/P, series FINALS2000A, IAU_2000A; batch = sha256 of the payload; the 7-day stale gate on the newest OBSERVED row fails the batch in-wasm; HTTP 304 emits one unchanged notice to the egress sink and stores nothing), and hostcap/storage-ingest persists it through the policy-mediated storage.ingest_with_source cap op with reconcile \"current\" (each whole-history snapshot supersedes the previous one). Results land on the egress sink. After the store, celestrak-request:publish_request joins that ingest result with the parser meta and (only when node CONFIG carries celestrak_publish_url) emits the loopback dataset-publication POST that a second hostcap/http-request node drives; the publication response also lands on the egress sink. All decisions live in-wasm.",
  "nodes": [
    {
      "nodeId": "req",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "eop",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.celestrak-parser",
      "methodId": "parse_eop",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_eop",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_eop",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_http_eop",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "req-http",
      "fromNodeId": "req",
      "fromPortId": "request",
      "toNodeId": "http",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "req-parse-job",
      "fromNodeId": "req",
      "fromPortId": "job",
      "toNodeId": "parse",
      "toPortId": "job",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "http-parse",
      "fromNodeId": "http",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "response",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-eop-meta",
      "fromNodeId": "parse",
      "fromPortId": "eop_meta",
      "toNodeId": "ingest_eop",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-eop-records",
      "fromNodeId": "parse",
      "fromPortId": "eop_records",
      "toNodeId": "ingest_eop",
      "toPortId": "records",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": false
    },
    {
      "edgeId": "parse-eop-raw",
      "fromNodeId": "parse",
      "fromPortId": "raw",
      "toNodeId": "ingest_eop",
      "toPortId": "raw",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "ingest-eop-egress",
      "fromNodeId": "ingest_eop",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "ingest-eop-publish",
      "fromNodeId": "ingest_eop",
      "fromPortId": "result",
      "toNodeId": "publish_eop",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-eop-meta-publish",
      "fromNodeId": "parse",
      "fromPortId": "eop_meta",
      "toNodeId": "publish_eop",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "publish-eop-http",
      "fromNodeId": "publish_eop",
      "fromPortId": "request",
      "toNodeId": "publish_http_eop",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "publish-eop-egress",
      "fromNodeId": "publish_http_eop",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-unchanged-egress",
      "fromNodeId": "parse",
      "fromPortId": "unchanged",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 1,
      "opaque": true
    }
  ],
  "triggers": [
    {
      "triggerId": "timer-eop",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 86400000,
      "description": "Earth orientation sync timer (EOP-All.csv updates once per day)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-eop",
      "targetNodeId": "req",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.celestrak-request",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.data-source.celestrak-parser",
    "com.digitalarsenal.hostcap.storage-ingest"
  ]
}
