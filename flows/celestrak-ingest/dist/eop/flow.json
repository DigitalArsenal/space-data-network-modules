{
  "programId": "com.digitalarsenal.flows.celestrak-eop-ingest",
  "name": "CelesTrak Earth Orientation Ingest Flow",
  "version": "0.2.0",
  "engineLinkage": "bridge",
  "description": "Per-provider ingest flow, Earth orientation. Typed contracts 1.0 (FlatBuffers only, no JSON and no base64): the timer's TimerTick enters the request builder; each HttpRequest carries its job - one size-prefixed $ICN (Ingest Connector) record naming the lane, the URL, the origin, the dataset and the usage terms - in CONTEXT, which hostcap/http-request echoes in the HttpResponse, so the parser reads its job from the response itself and nothing is paired by position. celestrak-request:eop emits the EOP-All.csv HttpRequest (4 MiB budget; the host presents its recorded ETag / Last-Modified validators); celestrak-parser:parse_eop normalizes it into an $EOP record stream (arcsecond columns to radians in the double-precision _HP fields with float32 copies, DAT to TAI_MINUS_UTC_SECONDS, DATA_TYPE O/P, series FINALS2000A, IAU_2000A; batch = sha256 of the payload; the 7-day stale gate on the newest OBSERVED row fails the batch in-wasm) with its IngestRequest (reconcile Current: each whole-history snapshot supersedes the previous one; archived as celestrak/EOP-All.csv), and hostcap/storage-ingest persists it through the policy-mediated storage.ingest_with_source hostcall. After the store celestrak-request:publish_request joins the IngestResult with the parser's IngestRequest and (only when node CONFIG carries celestrak_publish_url) emits the loopback dataset-publication POST, its body the IngestResult. Egress: result (IngestResult), notice (FlowNotice Unchanged on HTTP 304: nothing stored), publication (the publication HttpResponse). All decisions live in-wasm.",
  "nodes": [
    {
      "nodeId": "req",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "eop",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.celestrak-parser",
      "methodId": "parse_eop",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_eop",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_eop",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_http_eop",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "req-http",
      "fromNodeId": "req",
      "fromPortId": "request",
      "toNodeId": "http",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "http-parse",
      "fromNodeId": "http",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "response",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-eop-meta",
      "fromNodeId": "parse",
      "fromPortId": "eop_meta",
      "toNodeId": "ingest_eop",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-eop-records",
      "fromNodeId": "parse",
      "fromPortId": "eop_records",
      "toNodeId": "ingest_eop",
      "toPortId": "eop_records",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-eop-raw",
      "fromNodeId": "parse",
      "fromPortId": "raw",
      "toNodeId": "ingest_eop",
      "toPortId": "raw",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-eop-egress",
      "fromNodeId": "ingest_eop",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-eop-publish",
      "fromNodeId": "ingest_eop",
      "fromPortId": "result",
      "toNodeId": "publish_eop",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-eop-meta-publish",
      "fromNodeId": "parse",
      "fromPortId": "eop_meta",
      "toNodeId": "publish_eop",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "publish-eop-http",
      "fromNodeId": "publish_eop",
      "fromPortId": "request",
      "toNodeId": "publish_http_eop",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "publish-eop-egress",
      "fromNodeId": "publish_http_eop",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "publication",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-unchanged-egress",
      "fromNodeId": "parse",
      "fromPortId": "unchanged",
      "toNodeId": "egress",
      "toPortId": "notice",
      "backpressurePolicy": "queue",
      "queueDepth": 1
    }
  ],
  "triggers": [
    {
      "triggerId": "timer-eop",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 86400000,
      "description": "Earth orientation sync timer (EOP-All.csv updates once per day)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-eop",
      "targetNodeId": "req",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.celestrak-request",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.data-source.celestrak-parser",
    "com.digitalarsenal.hostcap.storage-ingest"
  ]
}
