{
  "pluginId": "com.digitalarsenal.flows.cellular-network-ingest",
  "name": "Cellular Network Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "The INGEST counterpart to cellular-network-aggregate, which is a per-request HTTP aggregate: route -> http -> parse -> merge -> respond, no storage node, no publication node, nothing persisted. That is the correct shape for the browser demo and the wrong shape for ingest, and the two cannot be the same flow - the aggregate is capabilities [] on route BY DESIGN so it stays browser-shaped. Here a cron TIMER tick enters at cell-tower-ingest:mark_query, which builds the flatsql-query that reads this provider's durable resume mark; hostcap/flatsql-query returns it to cell-tower-ingest:ingest_plan, which emits ONE hostcap/http-request descriptor carrying a Range header for the next chunk plus the cell-tower-source run contract. The chunk is bounded by the Go server host's 4 MiB response-body cap (hostcap/http-request manifest), so a 40M-row bulk export is fetched as a sequence of ranged chunks instead of one truncated GET; cellular-worldwide-ingest-exceeds-host01 measured a 4.75 MB CSV already forcing 8192 linear-memory pages. cell-tower-source's parse and deconflict are REUSED UNCHANGED - decoding a provider body and merging sites are the same operations whether the answer is served or stored - and cell-tower-ingest:ingest_meta authors the storage attribution ($TBS + $TBS.SOURCES provenance, reconcile=append because each batch is one CHUNK of the provider's set, not the set) before hostcap/storage-ingest persists it through the policy-mediated storage.ingest_with_source cap op. cell-tower-ingest:publish_request then advances the resume mark FROM THE STORAGE RESULT - never at dispatch, so a crash between fetch and store re-fetches one chunk instead of skipping rows invisibly - and emits the dataset-publication POST only when a publish URL is configured. The host owns no schedule, no provider list, no chunking policy and no record semantics: it contributes timers, HTTP egress, guarded persistence and the FlatSQL row that holds the mark. No new host connector is required.",
  "capabilities": [
    "http",
    "storage_ingest",
    "storage_query"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.cell-tower-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.flatsql-query",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.cell-tower-source",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
