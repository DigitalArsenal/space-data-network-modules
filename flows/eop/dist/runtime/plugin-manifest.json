{
  "pluginId": "com.digitalarsenal.flows.eop",
  "name": "Earth orientation",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "Every linked guest is wasi-sequential; the flow dispatches them serially and delegates external concurrency to its host."
  },
  "description": "Daily USNO finals2000A (IERS Rapid Service/Prediction Center), parsed in WASM and published as SDS EOP on lane eop/usno-finals2000a. U.S. Government work, public domain.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.eop-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.flows.eop.lane",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.eop-parser",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.6.0",
      "maxVersion": "0.6.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "daily",
      "displayName": "Flow trigger daily",
      "description": "Compiled-flow ingress for trigger \"daily\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK) from the flow timer; its fields are not read."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "TimerTick (module-sdk runtime type TICK) from the flow timer; its fields are not read."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-flow-notice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (FNTC) KIND Unchanged, REASON not-modified, on HTTP 304 only; no records and no meta."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "FlowNotice (FNTC) KIND Unchanged, REASON not-modified, on HTTP 304 only; no records and no meta."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "ICN.fbs",
      "fileIdentifier": "$ICN",
      "rootTypeName": "ICN"
    },
    {
      "schemaName": "EOP.fbs",
      "fileIdentifier": "$EOP",
      "rootTypeName": "EOP"
    },
    {
      "schemaName": "FIL.fbs",
      "fileIdentifier": "$FIL",
      "rootTypeName": "FIL"
    }
  ],
  "runtimeTargets": [
