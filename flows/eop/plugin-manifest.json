{
  "schemaVersion": "1.0.0",
  "pluginId": "com.digitalarsenal.flows.eop.lane",
  "name": "Earth orientation lane glue",
  "version": "0.1.0",
  "description": "Bytes in, bytes out, between eop-request, the host's HTTP hook, eop-parser and the host's ingest hook: a full-response validator on the request, an optional node-owned archive mirror (eop_archive_url), and the lane's identity and licence on the parser's IngestRequest. No parsing, no network, no clock and no physics.",
  "pluginFamily": "infrastructure",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "Bounded rewrite of one typed frame per invocation; the host owns I/O and the cron owns concurrency."
  },
  "methods": [
    {
      "methodId": "route_request",
      "displayName": "Request the whole file",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequest.fbs",
                  "fileIdentifier": "HREQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequest.fbs",
                  "fileIdentifier": "HREQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "restore_response",
      "displayName": "Restore the request's response",
      "inputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponse.fbs",
                  "fileIdentifier": "HRSP",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "response-typed",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponse.fbs",
                  "fileIdentifier": "HRSP",
                  "rootTypeName": "HttpResponse",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "attribute_lane",
      "displayName": "Name the lane and its licence",
      "inputPorts": [
        {
          "portId": "meta",
          "acceptedTypeSets": [
            {
              "setId": "meta-typed",
              "allowedTypes": [
                {
                  "schemaName": "IngestRequest.fbs",
                  "fileIdentifier": "INGQ",
                  "rootTypeName": "IngestRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "meta",
          "acceptedTypeSets": [
            {
              "setId": "meta-typed",
              "allowedTypes": [
                {
                  "schemaName": "IngestRequest.fbs",
                  "fileIdentifier": "INGQ",
                  "rootTypeName": "IngestRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
