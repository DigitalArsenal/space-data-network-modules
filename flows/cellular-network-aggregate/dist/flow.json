  "api": {
    "tag": "cellular",
    "tagDescription": "Terrestrial cellular base-station aggregation across open provider registries.",
    "routes": [
      {
        "path": "aggregate",
        "method": "POST",
        "operationId": "aggregateCellularSites",
        "summary": "Aggregate and deconflict cellular base-station sites across providers",
        "description": "Takes a provider set and a tbsMergeMethod (the client's JSON body: PROVIDERS, METHOD, LIMIT, FULL_POPULATION, BBOX, REFRESH) and answers application/vnd.sdn.flatbuffers.stream: the dataset's $DAV availability frame followed by the size-prefixed $TBS records (served from the store unless REFRESH:true; the cache's age rides as x-sdn-cache* headers and in the $DAV). ANONYMOUS is requested deliberately: every provider reachable without a credential publishes open data under an attribution licence, the answer carries that attribution in $TBS.SOURCES, and this is a public read that changes no node state. The host still decides; gateway.anonymous.deny overrides this request. format=json answers 406: the responder renders JSON for $OMM records only.",
        "anonymous": true
      },
      {
        "path": "providers",
        "method": "GET",
        "operationId": "listCellularProviders",
        "summary": "The provider catalog this node's module can reach",
        "description": "Provider ids, access posture and whether a credential is currently held, as a $QRP projection page (one row per provider; format=json renders a bare array of objects, the key slot's public key as base64). Anonymous for the same reason as aggregate: it is a public read of open-data source metadata and reveals no secret. Credential VALUES are never exposed by any route.",
        "anonymous": true
      },
      {
        "path": "credentials/{providerId}",
        "method": "PUT",
        "operationId": "storeCellularProviderCredential",
        "summary": "Store a browser-sealed provider credential in the node's credential store",
        "description": "Takes the node's own keyslot envelope (the client's JSON {slotId, ephemeralPublicKey, nonce, ciphertext}), asks the host to open it (keyslot.unwrap) and writes the result to the machine-bound credential store (secrets.put) under the lane cell_<providerId>. The value is never echoed, logged or readable back through any route; the answer is a one-row $QRP projection (providerId, credentialLane, credentialConfigured, stored). NOT ANONYMOUS, and deliberately so: an anonymous visitor overwriting this node's provider credentials would change what every other viewer's run does. There is no plaintext branch - a caller who cannot seal cannot store.",
        "anonymous": false,
        "params": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "A provider id from GET /providers. The lane written is cell_<providerId>, derived by the module from its own compiled registry — never a lane name the caller supplies.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "credentials/{providerId}",
        "method": "DELETE",
        "operationId": "clearCellularProviderCredential",
        "summary": "Clear a stored provider credential",
        "description": "Removes the cell_<providerId> lane from the node's credential store (secrets.clear). Answers the same one-row $QRP projection whether or not anything was there, so a write grant does not become a presence oracle. NOT ANONYMOUS, for the same reason as the PUT.",
        "anonymous": false,
        "params": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "A provider id from GET /providers. The lane written is cell_<providerId>, derived by the module from its own compiled registry — never a lane name the caller supplies.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      {
        "path": "tiles/meta",
        "method": "GET",
        "operationId": "getCellularTileMeta",
