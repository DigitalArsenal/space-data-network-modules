{
  "programId": "com.digitalarsenal.flows.cellular-network-aggregate",
  "name": "Cellular Network Aggregation",
  "version": "0.1.0",
  "description": "Signed isomorphic graph, mounted at /api/v1/cellular. One $HTQ request enters on the http-request trigger; cell-tower-source `route` reads the caller's PROVIDERS list and tbsMergeMethod and fans out one hostcap/http-request GET per selected provider; `parse` normalizes each provider's native payload into reports; `deconflict` merges them across providers and emits a size-prefixed $TBS record stream, which foundation/http-respond writes back to the caller. The host owns no schedule, no provider list, no merge policy and no record semantics — it mounts a route and moves bytes. Configuration is request-scoped, so two callers may ask for different provider sets concurrently without either changing node state.",
  "nodes": [
    {
      "nodeId": "route",
      "pluginId": "com.digitalarsenal.data-source.cell-tower-source",
      "methodId": "route",
      "kind": "transform",
      "capabilities": [],
      "drainPolicy": "single-shot",
      "artifact": {
        "path": "../data-source/cell-tower-source/dist/isomorphic/module.wasm",
        "publisher": "../data-source/cell-tower-source/publisher.json",
        "sha256": "576e294724785f289cfffeb9500a8aef2ac413902573ba498ddd1b478a0cf088"
      }
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "capabilities": [
        "http"
      ],
      "drainPolicy": "drain-until-yield",
      "artifact": {
        "path": "../hostcap/http-request/dist/isomorphic/module.wasm",
        "publisher": "../hostcap/http-request/publisher.json",
        "sha256": "574ad19601b2cd7954d34d60a7551a2b22e69f65f63279d935da1e7943aa6316"
      }
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.cell-tower-source",
      "methodId": "parse",
      "kind": "transform",
      "capabilities": [],
      "drainPolicy": "drain-until-yield",
      "artifact": {
        "path": "../data-source/cell-tower-source/dist/isomorphic/module.wasm",
        "publisher": "../data-source/cell-tower-source/publisher.json",
        "sha256": "576e294724785f289cfffeb9500a8aef2ac413902573ba498ddd1b478a0cf088"
      }
    },
    {
      "nodeId": "merge",
      "pluginId": "com.digitalarsenal.data-source.cell-tower-source",
      "methodId": "deconflict",
      "kind": "transform",
      "capabilities": [],
      "drainPolicy": "single-shot",
      "artifact": {
        "path": "../data-source/cell-tower-source/dist/isomorphic/module.wasm",
        "publisher": "../data-source/cell-tower-source/publisher.json",
        "sha256": "576e294724785f289cfffeb9500a8aef2ac413902573ba498ddd1b478a0cf088"
      }
    },
    {
      "nodeId": "respond",
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "methodId": "respond",
      "kind": "responder",
      "capabilities": [],
      "drainPolicy": "single-shot",
      "artifact": {
        "path": "../foundation/http-respond/dist/isomorphic/module.wasm",
        "publisher": "../foundation/http-respond/publisher.json",
        "sha256": "26cb434bf23b9f8064dabc376eaeaca07c0698669a7d6471f35d75d7cf2da42a"
      }
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "capabilities": [],
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "route-http",
      "fromNodeId": "route",
      "fromPortId": "requests",
      "toNodeId": "http",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 16,
      "opaque": true
    },
    {
      "edgeId": "route-job-parse",
      "fromNodeId": "route",
      "fromPortId": "job",
      "toNodeId": "parse",
      "toPortId": "job",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "http-parse",
      "fromNodeId": "http",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "responses",
      "backpressurePolicy": "queue",
      "queueDepth": 16,
      "opaque": true
    },
    {
      "edgeId": "parse-job-merge",
      "fromNodeId": "parse",
      "fromPortId": "job",
      "toNodeId": "merge",
      "toPortId": "job",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "parse-reports-merge",
      "fromNodeId": "parse",
      "fromPortId": "reports",
      "toNodeId": "merge",
      "toPortId": "reports",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "merge-records-respond",
      "fromNodeId": "merge",
      "fromPortId": "records",
      "toNodeId": "respond",
      "toPortId": "body",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "merge-summary-respond",
      "fromNodeId": "merge",
      "fromPortId": "decision",
      "toNodeId": "respond",
      "toPortId": "decision",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "route-reply-respond",
      "fromNodeId": "route",
      "fromPortId": "reply",
      "toNodeId": "respond",
      "toPortId": "decision",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    },
    {
      "edgeId": "respond-egress",
      "fromNodeId": "respond",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "response",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "route-catalog-respond",
      "fromNodeId": "route",
      "fromPortId": "catalog",
      "toNodeId": "respond",
      "toPortId": "body",
      "backpressurePolicy": "queue",
      "queueDepth": 4,
      "opaque": true
    }
  ],
  "triggers": [
    {
      "triggerId": "http-request",
      "kind": "http-request",
      "source": "host-http",
      "httpPath": "/api/v1/cellular/",
      "description": "The ONE http trigger. flowrt/httpmount.go:562-570 takes the first http-request trigger and breaks, so a second trigger is unreachable rather than a second route; PATH dispatch happens in-wasm, which is also what HttpRequestAbi.fbs mandates."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "http-request",
      "targetNodeId": "route",
      "targetPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 16
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.cell-tower-source",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.foundation.http-respond"
  ],
  "api": {
    "tag": "cellular",
    "tagDescription": "Terrestrial cellular base-station aggregation across open provider registries.",
    "routes": [
      {
        "path": "aggregate",
        "method": "POST",
        "operationId": "aggregateCellularSites",
        "summary": "Aggregate and deconflict cellular base-station sites across providers",
        "description": "Takes a provider set and a tbsMergeMethod and answers with a size-prefixed $TBS record stream. ANONYMOUS is requested deliberately: every provider reachable without a credential publishes open data under an attribution licence, the answer carries that attribution in $TBS.SOURCES, and this is a public read that changes no node state. The host still decides; gateway.anonymous.deny overrides this request.",
        "anonymous": true
      },
      {
        "path": "providers",
        "method": "GET",
        "operationId": "listCellularProviders",
        "summary": "The provider catalog this node's module can reach",
        "description": "Provider ids, access posture and whether a credential is currently held. Anonymous for the same reason as aggregate: it is a public read of open-data source metadata and reveals no secret. Credential VALUES are never exposed by any route.",
        "anonymous": true
      }
    ]
  }
}
