{
  "pluginId": "com.digitalarsenal.flows.cellular-network-aggregate",
  "name": "Cellular Network Aggregation",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Signed isomorphic graph, mounted at /api/v1/cellular. One $HTQ request enters on the http-request trigger; cell-tower-source `route` reads the caller's PROVIDERS list and tbsMergeMethod and fans out one hostcap/http-request GET per selected provider; `parse` normalizes each provider's native payload into reports; `deconflict` merges them across providers and emits a size-prefixed $TBS record stream, which foundation/http-respond writes back to the caller. The catalog and credential routes are finished by cell-tower-credentials, the ONE node holding a credential capability: it appends the node key slot, reports which lanes are configured, and opens/stores a browser-sealed credential. The host owns no schedule, no provider list, no merge policy and no record semantics — it mounts a route and moves bytes. Configuration is request-scoped, so two callers may ask for different provider sets concurrently without either changing node state.",
  "capabilities": [
    "http",
    "secrets:cell_opencellid",
    "secrets:cell_opencellid:write",
    "secrets:cell_wigle",
    "secrets:cell_wigle:write",
    "wallet_sign"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.cell-tower-source",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.cell-tower-credentials",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.foundation.http-respond",
      "minVersion": "0.2.1",
      "maxVersion": "0.2.1"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 4 MiB response cap, 30 s default timeout. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "http_request",
      "displayName": "Flow trigger http-request",
      "description": "Compiled-flow ingress for trigger \"http-request\" (http-request).",
      "inputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-request-envelope",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "The $HTQ HttpRequest envelope the host pumps at the flow ingress.",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Host-http trigger envelope produced by the flow runtime; its shape is defined by the host's http mount, not by SDS."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The HTTP request envelope."
        }
      ],
      "outputPorts": [
        {
          "portId": "response",
          "acceptedTypeSets": [
            {
              "setId": "sdn-http-response-envelope",
              "allowedTypes": [
                {
                  "schemaName": "HttpResponseAbi.fbs",
                  "fileIdentifier": "$HTR",
                  "rootTypeName": "HttpResponse"
                }
              ],
              "description": "Canonical WASM-served HTTP response envelope ($HTR, module-sdk schemas/HttpResponseAbi.fbs): STATUS, HEADERS (sorted, lower-cased names), BODY. The host streams it back verbatim."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Exactly one HTTP response envelope per invoke."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "TBS.fbs",
      "fileIdentifier": "$TBS",
      "rootTypeName": "TBS"
    },
    {
      "schemaName": "HttpResponseAbi.fbs",
      "fileIdentifier": "$HTR",
      "rootTypeName": "HttpResponse"
    }
  ],
  "runtimeTargets": [
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_cellular_network_aggregate-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "wasmedge"
    }
  ],
