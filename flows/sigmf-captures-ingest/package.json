{
  "name": "@digitalarsenal/sdn-flow-sigmf-captures-ingest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ./node_modules/space-data-module-sdk/bin/space-data-module.js flow check ../sigmf-captures-ingest.flow.json --deps ../sigmf-captures-ingest.deps.json",
    "build": "export SPACE_DATA_STANDARDS_ROOT=\"${SPACE_DATA_STANDARDS_ROOT:-$(cd ../../../spacedatastandards.org && pwd)}\"; node ./node_modules/space-data-module-sdk/bin/space-data-module.js flow compile ../sigmf-captures-ingest.flow.json --deps ../sigmf-captures-ingest.deps.json --out ./dist/iqc",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "space-data-module-sdk": "0.9.12"
  },
  "overrides": {
    "hd-wallet-wasm": "2.1.0"
  }
}
