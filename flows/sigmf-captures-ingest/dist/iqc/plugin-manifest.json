{
  "pluginId": "com.digitalarsenal.flows.sigmf-captures-ingest",
  "name": "SigMF Raw-IQ Capture Ingest Flow",
  "version": "0.2.0",
  "pluginFamily": "flow",
  "description": "Per-provider ingest flow, raw-IQ capture pointers (typed contracts 1.0: every edge carries one FlatBuffers type; no JSON or base64 travels between nodes): a cron TIMER tick (TimerTick) enters at sigmf-captures:request, which emits ONE bulk HttpRequest GET of the configured archive's metadata index (default IQEngine https://www.iqengine.org/api/datasources/local/local/meta — anonymous, no token) rather than a per-file crawl of a community-run service, its parse job in CONTEXT (one size-prefixed IngestRequest skeleton: schema IQC.fbs, provider, the adapter's source name, source URL, reconcile None, archive naming). hostcap/http-request answers the HttpResponse with the job echoed, so request and job are never paired by position. sigmf-captures:parse resolves the source adapter from the job's source name (an unknown one fails closed), reads the archive coordinates from the same node CONFIG the request used, and emits a size-prefixed $IQC record stream (batch = sha256 of the payload; SigMF hertz carried unconverted; DATATYPE verbatim; GEOLOCATION omitted when unpublished and REFUSED when the coordinates are out of WGS-84 range; licence per RECORDING, empty meaning unknown terms, so the batch tags name no licence), the IngestRequest and the HttpResponse verbatim as the raw document, and hostcap/storage-ingest persists the batch through the policy-mediated storage.ingest_with_source hostcall (typed $PIV), archiving the raw index as sigmf/<adapter>-meta.json. $IQC is a POINTER RECORD: PAYLOADS carry the upstream URLs and hashes with CUSTODY UPSTREAM_ONLY, so no capture payload is ever mirrored by this flow. Egress: result (IngestResult), notice (FlowNotice). HTTP 304 Not Modified is a successful run with nothing new, not a failed fetch: the parse node emits one FlowNotice (Unchanged, not-modified) on its 'unchanged' port straight to the egress notice port and no meta/records/raw frames, so storage-ingest never fires and no batch is stored or announced. All decisions live in-wasm; the host supplies only the http and storage connectors.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.sigmf-captures",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_sigmf_captures",
      "displayName": "Flow trigger timer-sigmf-captures",
      "description": "Compiled-flow ingress for trigger \"timer-sigmf-captures\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK) from the flow's timer trigger."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick (its fields are not read)."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-result",
              "allowedTypes": [
                {
                  "schemaName": "IngestResult.fbs",
                  "fileIdentifier": "INGR",
                  "rootTypeName": "IngestResult",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "IngestResult (module-sdk runtime type INGR): SCHEMA, PROVIDER_ID, SOURCE_NAME, BATCH_ID, INSERTED, RECONCILED_DUPLICATES, RECONCILED_OLD_BATCHES, ARCHIVED; or REFUSED saying why the batch was not stored (a value over its aligned bound, or a host refusal)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "EXACTLY ONE IngestResult per invocation."
        },
        {
          "portId": "notice",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-flow-notice",
              "allowedTypes": [
                {
                  "schemaName": "FlowNotice.fbs",
                  "fileIdentifier": "FNTC",
                  "rootTypeName": "FlowNotice",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "FlowNotice (FNTC): KIND Unchanged, SCHEMA IQC.fbs, PROVIDER_ID, SOURCE_NAME, REASON not-modified, ITEMS the source URL, AT_MS the host's retrieval time."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Emitted ONLY when the fetch answered HTTP 304 Not Modified (the host sent the recorded ETag / Last-Modified validators): one notice frame and no meta/records/raw frames, so the ingest node never becomes ready and nothing is stored or announced."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "IQC.fbs",
      "fileIdentifier": "$IQC",
      "rootTypeName": "IQC"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
