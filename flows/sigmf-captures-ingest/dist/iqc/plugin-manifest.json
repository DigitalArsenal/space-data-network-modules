{
  "pluginId": "com.digitalarsenal.flows.sigmf-captures-ingest",
  "name": "SigMF Raw-IQ Capture Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Per-provider ingest flow, raw-IQ capture pointers: a cron TIMER tick enters at sigmf-captures:request, which emits ONE bulk hostcap/http-request GET of the configured archive's metadata index (default IQEngine https://www.iqengine.org/api/datasources/local/local/meta — anonymous, no token) rather than a per-file crawl of a community-run service. sigmf-captures:parse joins that job with the response and emits a size-prefixed $IQC record stream (batch = sha256 of the payload; SigMF hertz carried unconverted; DATATYPE verbatim; GEOLOCATION omitted when unpublished and REFUSED when the coordinates are out of WGS-84 range; licence per RECORDING, empty meaning unknown terms), and hostcap/storage-ingest persists it through the policy-mediated storage.ingest_with_source cap op. $IQC is a POINTER RECORD: PAYLOADS carry the upstream URLs and hashes with CUSTODY UPSTREAM_ONLY, so no capture payload is ever mirrored by this flow. Results land on the egress sink. All decisions live in-wasm; the host supplies only the http and storage connectors.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.sigmf-captures",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall. Go server host: 4 MiB response cap, 30 s default timeout. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall (sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_sigmf_captures",
      "displayName": "Flow trigger timer-sigmf-captures",
      "description": "Compiled-flow ingress for trigger \"timer-sigmf-captures\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-timer-tick",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "Timer tick frame (content ignored).",
              "wildcardJustification": {
                "kind": "intra-flow-control-frame",
                "mediaType": "application/json",
                "detail": "Cron timer tick frame produced by the flow runtime and consumed inside this flow only; it carries no payload at all, so there is no SDS record to name."
              }
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-ingest-result-json",
              "allowedTypes": [
                {
                  "acceptsAnyFlatbuffer": true
                }
              ],
              "description": "UTF-8 JSON host result: {\"schema\",\"inserted\",\"batch_id\",\"reconciled_duplicates\"?,\"reconciled_old_batches\"?,\"archived\"?,\"provenance\"?}."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "Ingest result summary."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "IQC.fbs",
      "fileIdentifier": "$IQC",
      "rootTypeName": "IQC"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "com_digitalarsenal_flows_sigmf_captures_ingest-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "req",
      "pluginId": "com.digitalarsenal.data-source.sigmf-captures",
      "methodId": "request",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.sigmf-captures",
      "methodId": "parse",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "ingest_iqc",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "dispatchModel": "host-capability",
      "uiX": 0,
      "uiY": 0
    }
  ],
  "flowEdges": [
    {
      "edgeId": "req-http",
      "fromNodeId": "req",
      "fromPortId": "request",
      "toNodeId": "http",
      "toPortId": "request",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "req-parse-job",
      "fromNodeId": "req",
      "fromPortId": "job",
      "toNodeId": "parse",
      "toPortId": "job",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "http-parse",
      "fromNodeId": "http",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "response",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "parse-iqc-meta",
      "fromNodeId": "parse",
      "fromPortId": "iqc_meta",
      "toNodeId": "ingest_iqc",
      "toPortId": "meta",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "parse-iqc-records",
      "fromNodeId": "parse",
      "fromPortId": "iqc_records",
      "toNodeId": "ingest_iqc",
      "toPortId": "records",
      "contract": {
        "canonicalType": {
          "schemaName": "IQC.fbs",
          "fileIdentifier": "$IQC",
          "schemaVersion": null,
          "schemaHash": [],
          "acceptsAnyFlatbuffer": false,
          "wireFormat": "flatbuffer",
          "rootTypeName": "IQC",
          "fixedStringLength": 0,
          "byteLength": 0,
          "requiredAlignment": 0
        },
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": false,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "parse-iqc-raw",
      "fromNodeId": "parse",
      "fromPortId": "raw",
      "toNodeId": "ingest_iqc",
      "toPortId": "raw",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    },
    {
      "edgeId": "ingest-iqc-egress",
      "fromNodeId": "ingest_iqc",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "contract": {
        "canonicalType": null,
        "alignedType": null,
        "canonicalFallbackAvailable": true,
        "alignedEligible": false,
        "opaque": true,
        "routePolicy": "canonical-only"
      }
    }
  ],
  "flowTriggers": [
    {
      "triggerId": "timer-sigmf-captures",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 604800000,
      "httpPath": null
    }
  ],
  "flowTriggerBindings": [
    {
      "triggerId": "timer-sigmf-captures",
      "targetNodeId": "req",
      "targetPortId": "tick"
    }
  ],
  "abiVersion": 1
}
