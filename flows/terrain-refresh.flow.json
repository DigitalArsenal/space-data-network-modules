      "methodId": "sign",
      "kind": "transform",
      "capabilities": [
        "clock",
        "secrets:storage_r2"
      ],
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http_put",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "capabilities": [
        "http"
      ],
      "drainPolicy": "single-shot"
