{
  "schemaVersion": "1.0.0",
  "pluginId": "com.digitalarsenal.flows.object-covariance.control",
  "name": "Incremental object covariance controller",
  "version": "0.1.0",
  "description": "Cron orchestration only: page OCM cursors and newest OMMs, pass causal histories to gp-error-model, ingest its OCM bytes. No numerical covariance or propagation implementation.",
  "pluginFamily": "infrastructure",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct",
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "sequentialJustification": {
    "kind": "caller-level-parallelism",
    "detail": "One bounded storage query or object calculation is outstanding; the cron owns concurrency."
  },
  "methods": [
    {
      "methodId": "advance",
      "displayName": "Advance the covariance reactor",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "tick-typed",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "rows",
          "acceptedTypeSets": [
            {
              "setId": "rows-typed",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 64,
          "required": false
        },
        {
          "portId": "status",
          "acceptedTypeSets": [
            {
              "setId": "status-typed",
              "allowedTypes": [
                {
                  "schemaName": "FSO.fbs",
                  "fileIdentifier": "$FSO",
                  "rootTypeName": "FSO",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "ocm",
          "acceptedTypeSets": [
            {
              "setId": "ocm-typed",
              "allowedTypes": [
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "stored",
          "acceptedTypeSets": [
            {
              "setId": "stored-typed",
              "allowedTypes": [
                {
                  "schemaName": "IngestResult.fbs",
                  "fileIdentifier": "INGR",
                  "rootTypeName": "IngestResult",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "outputPorts": [
        {
          "portId": "query",
          "acceptedTypeSets": [
            {
              "setId": "query-typed",
              "allowedTypes": [
                {
                  "schemaName": "FSO.fbs",
                  "fileIdentifier": "$FSO",
                  "rootTypeName": "FSO",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "elements",
          "acceptedTypeSets": [
            {
              "setId": "elements-typed",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "request-typed",
              "allowedTypes": [
                {
                  "schemaName": "ERM.fbs",
                  "fileIdentifier": "$ERM",
                  "rootTypeName": "ERM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "records",
          "acceptedTypeSets": [
            {
              "setId": "records-typed",
              "allowedTypes": [
                {
                  "schemaName": "OCM.fbs",
                  "fileIdentifier": "$OCM",
                  "rootTypeName": "OCM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        },
        {
          "portId": "meta",
          "acceptedTypeSets": [
            {
              "setId": "meta-typed",
              "allowedTypes": [
                {
                  "schemaName": "IngestRequest.fbs",
                  "fileIdentifier": "INGQ",
                  "rootTypeName": "IngestRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
