{
  "pluginId": "com.digitalarsenal.flows.imager-native-tile-ingest",
  "name": "Geostationary Imager Native Tile Ingest Flow",
  "version": "0.1.0",
  "pluginFamily": "flow",
  "description": "Hourly ingest of geostationary imager observations at the imager's own resolution (owner 2026-10-23: the satellites' own resolution on the node, its own module set beside imager-observation-ingest): GOES-East and GOES-West ABI L1b/L2 NetCDF4 from NOAA Open Data Dissemination's anonymous public buckets as raw per-satellite level-5 $WXF tiles (5.625 degrees, 320 x 320 cells of ~2 km; the 0.64 um reflectance 640 x 640 of ~1 km), the layout of DigitalArsenal/Cesium_Weather tools/raw_satellite.py native_tiles that the world-clouds detail regions read, on typed contracts 1.0 (no JSON frames). timer (TimerTick) -> plan (one S3 listing HttpRequest per satellite and product folder of the frame hour) -> http -> select_files (the hour's first full-disk scan of each wanted field; byte ranges above imager_max_part_bytes; ONE PART PER INVOCATION, the rest yielded) -> http -> parse (once a file is whole, its field read and held, ONE TILE ROW AN INVOCATION - one IngestRequest and record stream, source <bucket>-tiles5 - the rest yielded) -> storage-ingest (wxf_records) -> publish_request -> http (dataset publication, only when imager_publish_url is set). Skips and missing files are FlowNotices at the egress. Memory: the parser holds one file (a daytime 0.5 km band ~430 MB) while its field (the 1 km reflectance, 10848^2 float32, ~470 MB) is read, then the field alone; run the service with memory_pages 24576.",
  "capabilities": [
    "http",
    "storage_ingest"
  ],
  "dependencies": [
    {
      "pluginId": "com.digitalarsenal.data-source.imager-native-tile-source",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "minVersion": "0.2.0",
      "maxVersion": "0.2.0"
    },
    {
      "pluginId": "com.digitalarsenal.data-source.imager-native-tile-parser",
      "minVersion": "0.1.0",
      "maxVersion": "0.1.0"
    },
    {
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "minVersion": "0.6.0",
      "maxVersion": "0.6.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "host-http",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "http",
      "resource": "https://*",
      "description": "Outbound HTTP through the host http.request hostcall (SDS $PIV). Go server host: 100 MiB response ceiling lowered per request by MAX_BYTES (exceeding it is an error, never a truncation), 30 s default timeout, per-destination egress pacing. SDK NodeHost/BrowserHost: fetch-based, origin allowlists enforced by host policy.",
      "properties": {
        "hostOps": [
          "http.request"
        ]
      }
    },
    {
      "interfaceId": "host-storage-ingest",
      "kind": "host-service",
      "direction": "bidirectional",
      "capability": "storage_ingest",
      "resource": "sdn://storage/ingest",
      "description": "Provenance/batch-capable record ingest through the host storage.ingest_with_source hostcall, sent as an SDS $PIV invocation (StorageIngestParams + raw records/archive + list provenance; sdn-server modulert/caps/storage.go).",
      "properties": {
        "hostOps": [
          "storage.ingest_with_source"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "timer_imager_tiles",
      "displayName": "Flow trigger timer-imager-tiles",
      "description": "Compiled-flow ingress for trigger \"timer-imager-tiles\" (timer).",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-timer-tick",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "TimerTick (module-sdk runtime type TICK); its payload is not read."
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Cron timer tick."
        }
      ],
      "outputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-result",
              "allowedTypes": [
                {
                  "schemaName": "IngestResult.fbs",
                  "fileIdentifier": "INGR",
                  "rootTypeName": "IngestResult",
                  "wireFormat": "flatbuffer"
                }
              ],
              "description": "IngestResult (module-sdk runtime type INGR): SCHEMA, PROVIDER_ID, SOURCE_NAME, BATCH_ID, INSERTED, RECONCILED_DUPLICATES, RECONCILED_OLD_BATCHES, ARCHIVED; or REFUSED saying why the batch was not stored (a value over its aligned bound, or a host refusal)."
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "EXACTLY ONE IngestResult per invocation."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "WXF.fbs",
      "fileIdentifier": "$WXF",
      "rootTypeName": "WXF"
    }
  ],
  "runtimeTargets": [
