      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_maxprob",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "publish_request",
