{
  "id": "supplemental-omm",
  "name": "Supplemental OMM",
  "version": "1.0.1",
  "description": "Five independent ephemeris providers fitted into supplemental OMM, OCM, and OBD records by one composed isomorphic module.",
  "modules": [
    {
      "id": "supplemental-omm",
      "pluginId": "org.sdn.flows.od-supplemental-omm",
      "version": "1.0.1",
      "role": "primary",
      "description": "The complete five-provider, full-arc orbit-determination, FlatSQL, publication, and status composition.",
      "maxMemoryPages": 16384,
      "runtimeTarget": "node"
    }
  ],
  "data": [
    {
      "id": "fitted-omm",
      "sdsType": "OMM",
      "direction": "produces",
      "moduleId": "supplemental-omm"
    },
    {
      "id": "runtime-status",
      "sdsType": "DSS",
      "direction": "produces",
      "moduleId": "supplemental-omm",
      "description": "Generic per-node runtime counters emitted as canonical DSS records inside signed-node FSB transport envelopes."
    },
    {
      "id": "fitted-ocm",
      "sdsType": "OCM",
      "direction": "produces",
      "moduleId": "supplemental-omm"
    },
    {
      "id": "fit-diagnostics",
      "sdsType": "OBD",
      "direction": "produces",
      "moduleId": "supplemental-omm"
    }
  ],
  "sources": [
