{
  "name": "@digitalarsenal/sdn-flow-supplemental-omm",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "sdn-module": "./dist/isomorphic/module.wasm",
  "scripts": {
    "build": "node ./nodes/od/build.mjs && node ./nodes/status/build.mjs",
    "check": "node ./node_modules/space-data-module-sdk/bin/space-data-module.js flow check ./flow.json --deps ./deps.json",
    "release": "node ./scripts/release.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify": "npm run test && npm run check"
  },
  "devDependencies": {
    "flatbuffers": "25.9.23",
    "space-data-module-sdk": "0.9.12",
    "spacedatastandards.org": "1.261.0"
  },
  "overrides": {
    "hd-wallet-wasm": "2.1.2"
  }
}
