    {
      "nodeId": "od",
      "pluginId": "org.sdn.flows.supplemental-omm.od",
      "methodId": "fit",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "store",
      "pluginId": "com.digitalarsenal.flatsql.store",
      "methodId": "append_records",
      "kind": "sink",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "publication",
      "pluginId": "org.sdn.flows.supplemental-omm.publication",
      "methodId": "publish_records",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "status",
      "pluginId": "org.sdn.flows.supplemental-omm.status",
      "methodId": "record_event",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    }
  ],
  "flowEdges": [
