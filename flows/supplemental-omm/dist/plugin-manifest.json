{
  "pluginId": "org.sdn.flows.od-supplemental-omm",
  "name": "Supplemental OMM Orbit Determination",
  "version": "1.0.0",
  "pluginFamily": "flow",
  "description": "Signed isomorphic graph: one WASM timer policy fans typed ticks to five independent provider nodes; provider FSB ephemerides feed an independent OD node; fitted FSB records reach independently signed FlatSQL, publication, and status nodes. Hosts expose only application-blind capabilities and never own schedule, storage, status, or publication policy.",
  "capabilities": [
    "clock",
    "http",
    "pubsub",
    "storage_adapter",
    "timers"
  ],
  "dependencies": [
    {
      "pluginId": "org.sdn.flows.supplemental-omm.timer",
      "minVersion": "1.0.0",
      "maxVersion": "1.0.0"
    },
    {
      "pluginId": "com.orbpro.spacex-starlink-source",
      "minVersion": "2.0.0",
      "maxVersion": "2.0.0"
    },
    {
      "pluginId": "com.orbpro.glonass-source",
      "minVersion": "2.0.0",
      "maxVersion": "2.0.0"
    },
    {
      "pluginId": "com.orbpro.intelsat-source",
      "minVersion": "2.0.0",
      "maxVersion": "2.0.0"
    },
    {
      "pluginId": "com.orbpro.cpf-source",
      "minVersion": "2.0.0",
      "maxVersion": "2.0.0"
    },
    {
      "pluginId": "com.orbpro.iss-source",
      "minVersion": "2.0.0",
      "maxVersion": "2.0.0"
    },
    {
      "pluginId": "org.sdn.flows.supplemental-omm.od",
      "minVersion": "1.0.0",
      "maxVersion": "1.0.0"
    },
    {
      "pluginId": "com.digitalarsenal.flatsql.store",
      "minVersion": "2.0.2",
      "maxVersion": "2.0.2"
    },
    {
      "pluginId": "org.sdn.flows.supplemental-omm.publication",
      "minVersion": "1.0.0",
      "maxVersion": "1.0.0"
    },
    {
      "pluginId": "org.sdn.flows.supplemental-omm.status",
      "minVersion": "1.0.0",
      "maxVersion": "1.0.0"
    }
  ],
  "externalInterfaces": [
    {
      "interfaceId": "generic-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "properties": {
        "hostOps": [
          "clock.now"
        ]
      }
    },
    {
      "interfaceId": "generic-timers",
      "kind": "host-service",
      "direction": "output",
      "capability": "timers",
      "resource": "host://timers",
      "properties": {
        "hostOps": [
          "timers.arm",
          "timers.cancel"
        ]
      }
    },
    {
      "interfaceId": "generic-pubsub",
      "kind": "host-service",
      "direction": "output",
      "capability": "pubsub",
      "resource": "host://pubsub",
      "properties": {
        "hostOps": [
          "pubsub.publish"
        ]
      }
    }
  ],
  "methods": [
    {
      "methodId": "startup",
      "displayName": "Flow trigger startup",
      "description": "Compiled-flow ingress for trigger \"startup\" (manual).",
      "inputPorts": [
        {
          "portId": "wakeup",
          "acceptedTypeSets": [
            {
              "setId": "fso-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSO.fbs",
                  "fileIdentifier": "$FSO",
                  "schemaVersion": "1.158.2",
                  "schemaHash": "a298ef96af29624073edf749848e8ff1e5b8f45e56966c2e210cb719f3c5e821",
                  "rootTypeName": "FSO",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSO.fbs",
                  "fileIdentifier": "$FSO",
                  "schemaVersion": "1.158.2",
                  "schemaHash": "a298ef96af29624073edf749848e8ff1e5b8f45e56966c2e210cb719f3c5e821",
                  "rootTypeName": "FSO",
                  "wireFormat": "aligned-binary",
                  "byteLength": 361648,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Optional typed control/wakeup envelope. Generic wakeup delivery may invoke the method without a body."
        }
      ],
      "outputPorts": [],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "FSO.fbs",
      "fileIdentifier": "$FSO",
      "schemaVersion": "1.158.2",
      "schemaHash": "a298ef96af29624073edf749848e8ff1e5b8f45e56966c2e210cb719f3c5e821",
      "rootTypeName": "FSO"
    },
    {
      "schemaName": "FSB.fbs",
      "fileIdentifier": "$FSB",
      "schemaVersion": "1.158.1",
      "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
      "rootTypeName": "FSB"
    },
    {
      "schemaName": "DSS.fbs",
      "fileIdentifier": "$DSS",
      "schemaVersion": "1.99.0",
      "schemaHash": "819a40979c746d4e712fb62c1af54592b0067a6e8166afad9d83ed494bff7a37",
      "rootTypeName": "DSS"
    }
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "buildArtifacts": [
    {
      "artifactId": "org_sdn_flows_od_supplemental_omm-flow-runtime",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "flowNodes": [
    {
      "nodeId": "timer",
      "pluginId": "org.sdn.flows.supplemental-omm.timer",
      "methodId": "on_wakeup",
      "kind": "trigger",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "provider-starlink",
      "pluginId": "com.orbpro.spacex-starlink-source",
      "methodId": "emit",
      "kind": "transform",
      "dispatchModel": null,
      "uiX": 0,
      "uiY": 0
    },
    {
      "nodeId": "provider-glonass",
      "pluginId": "com.orbpro.glonass-source",
