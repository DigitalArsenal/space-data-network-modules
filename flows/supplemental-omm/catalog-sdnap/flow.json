{
  "programId": "org.sdn.flows.catalog-sdnap",
  "name": "Catalog SDN-AP sets",
  "version": "1.0.0",
  "description": "Fits SDN-AP element sets for the whole current catalog and publishes them beside the SGP4 sets (typed contracts 1.0: FlatBuffers only). A host-cron TimerTick starts sdnap.catalog_request, a $QRP Request for the node's current $OMM catalog (source celestrak-gp, nearest to now); data-source/retrieval omm_bulk answers it from the store with a page; sdnap.from_page sends the page's records one at a time, each with a default $PCF, to propagator/sdn-ap propagate (each set's own theory: its $OEM on the set's epoch grid); sdnap.prepare sends that $OEM on with a $PCF (THEORY SDNAP) to propagator/sdn-ap fit, one ephemeris an invocation so a set the fit refuses costs only its object; sdnap.wrap files the fit's $OMM (MEAN_ELEMENT_THEORY SDNAP, with COVARIANCE) and $OBD as IngestRequests with their record streams for two hostcap/storage-ingest nodes, and sdnap.publish_request turns each stored batch's IngestResult into the dataset-publication POST (config omm_publish_url). Egress: result (IngestResult), publication (HttpResponse). Every node is an independently signed isomorphic child of the release bundle (scripts/release.mjs --flow-dir catalog-sdnap).",
  "nodes": [
    {
      "nodeId": "publish_omm",
      "pluginId": "org.sdn.flows.supplemental-omm.sdnap",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http_publish_omm",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "publish_obd",
      "pluginId": "org.sdn.flows.supplemental-omm.sdnap",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http_publish_obd",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "ingest_omm",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_obd",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "wrap",
      "pluginId": "org.sdn.flows.supplemental-omm.sdnap",
      "methodId": "wrap",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "fit",
      "pluginId": "com.spacedatanetwork.sdn-ap-propagator",
      "methodId": "fit",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "prepare",
      "pluginId": "org.sdn.flows.supplemental-omm.sdnap",
      "methodId": "prepare",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "propagate",
      "pluginId": "com.spacedatanetwork.sdn-ap-propagator",
      "methodId": "propagate",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "from_page",
      "pluginId": "org.sdn.flows.supplemental-omm.sdnap",
      "methodId": "from_page",
      "kind": "transform",
      "drainPolicy": "drain-until-yield"
    },
    {
      "nodeId": "retrieval",
      "pluginId": "com.digitalarsenal.data-source.retrieval",
      "methodId": "omm_bulk",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "catalog_request",
      "pluginId": "org.sdn.flows.supplemental-omm.sdnap",
      "methodId": "catalog_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
