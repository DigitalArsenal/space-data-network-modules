{
  "pluginId": "org.sdn.flows.supplemental-omm.provider-starlink",
  "name": "Starlink Complete Ephemeris Provider",
  "version": "1.0.0",
  "description": "Downloads the complete Starlink operator ephemeris catalog into a durable WASM-owned opaque spool before emitting byte-exact provider-native responses as paired canonical or aligned FSB chunks.",
  "pluginFamily": "data_source",
  "capabilities": [
    "http",
    "storage_adapter"
  ],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "emit",
      "displayName": "Fetch Complete Starlink Ephemerides",
      "inputPorts": [
        {
          "portId": "config",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "aligned-binary",
                  "byteLength": 1048744,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "outputPorts": [
        {
          "portId": "oem",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "aligned-binary",
                  "byteLength": 1048744,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 4096,
          "required": false
        },
        {
          "portId": "progress",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
