{
  "pluginId": "org.sdn.flows.supplemental-omm.provider-intelsat",
  "name": "Intelsat Complete Ephemeris Provider",
  "version": "1.0.0",
  "description": "Discovers and fetches the complete configured Intelsat ECF response and emits byte-exact provider-native data as paired canonical or aligned FSB chunks.",
  "pluginFamily": "data_source",
  "capabilities": [
    "http"
  ],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "emit",
      "displayName": "Fetch Complete Intelsat Ephemeris",
      "inputPorts": [
        {
          "portId": "config",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "aligned-binary",
                  "byteLength": 1048744,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "outputPorts": [
        {
          "portId": "oem",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "aligned-binary",
                  "byteLength": 1048744,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 4096,
          "required": true
        }
      ],
      "maxBatch": 4096,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "FSB.fbs",
      "fileIdentifier": "$FSB",
      "schemaVersion": "1.164.0",
      "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
      "rootTypeName": "FSB"
    }
  ],
  "buildArtifacts": [
    {
      "artifactId": "supplemental-omm-provider-intelsat-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1,
  "sequentialJustification": {
    "kind": "inherently-sequential-algorithm",
    "detail": "The Intelsat provider streams one provider-native response and emits bounded paired FSB chunks in arrival order; chunk k+1's framing offset is produced by chunk k, so the parse cannot be split across threads. Fan-out for the five providers is caller-level, performed by the flow host running the provider nodes concurrently, not inside any one provider."
  }
}
