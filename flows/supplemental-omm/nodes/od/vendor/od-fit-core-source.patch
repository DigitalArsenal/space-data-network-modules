+                terminal.error_code = "terminal-reentry-ocm-failed";
+                terminal.error_message =
+                    "unable to build the complete terminal-reentry OCM";
+            } else {
+                terminal.ok = true;
+                terminal.terminal_reentry_ocm_only = true;
+            }
+            results.push_back(std::move(terminal));
+            return results;
+        }
+        std::vector<FitResult> fits = fit_sgp4_epoch_series(series, config);
+        const bool strictly_ordered =
+            std::adjacent_find(
+                series.samples.begin(), series.samples.end(),
+                [](const EphemerisPoint& left,
+                   const EphemerisPoint& right) {
+                    return right.epoch_jd <= left.epoch_jd;
+                }) == series.samples.end();
+        if (!fits.empty() &&
+            !fitted_epochs_pass_publication_gate(fits)) {
+            FitterConfig fallback = config;
