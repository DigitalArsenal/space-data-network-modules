+bool preflight_fit_epochs(const std::vector<PluginFitFBResult>& epochs,
+                          std::string* error_code,
+                          std::string* error_message) {
+    if (epochs.empty()) {
+        *error_code = "fit-empty";
+        *error_message = "complete-arc fitter produced no epoch records";
+        return false;
+    }
+    if (epochs.size() == 1 && epochs.front().terminal_reentry_ocm_only) {
+        const PluginFitFBResult& terminal = epochs.front();
+        if (terminal.ok && terminal.omm.empty() && !terminal.ocm.empty()) {
+            return true;
+        }
+        *error_code = "terminal-reentry-ocm-invalid";
+        *error_message =
+            "terminal reentry must produce exactly one OCM and no OMM";
+        return false;
+    }
+    for (const PluginFitFBResult& epoch : epochs) {
+        if (epoch.terminal_reentry_ocm_only ||
+            !epoch.ok || epoch.omm.empty() || epoch.ocm.empty()) {
+            if (!epoch.ok) {
+                *error_code = epoch.error_code.empty()
+                    ? "fit-epoch-failed"
+                    : epoch.error_code;
+                *error_message = epoch.error_message.empty()
+                    ? "complete-arc fitter returned a failed epoch"
+                    : epoch.error_message;
+            } else {
+                *error_code = "fit-incomplete-epoch";
+                *error_message =
+                    "complete-arc fitter returned an incomplete epoch record set";
+            }
+            return false;
+        }
+    }
+    return true;
