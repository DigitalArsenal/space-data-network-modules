+bool assign_observed_mean_motion_derivatives(
+    std::vector<FitResult>* fits) {
+    if (!fits || fits->empty()) return false;
+    if (fits->size() == 1) {
+        fits->front().elements.mean_motion_dot = 0.0;
+        fits->front().elements.mean_motion_ddot = 0.0;
+        return true;
+    }
+
+    for (std::size_t index = 0; index < fits->size(); ++index) {
+        double derivative = 0.0;
+        if (index == 0 || index + 1 == fits->size()) {
+            const std::size_t left =
+                index == 0 ? 0 : fits->size() - 2;
+            const std::size_t right = left + 1;
+            const double elapsed_days =
+                (*fits)[right].elements.epoch_jd -
+                (*fits)[left].elements.epoch_jd;
+            if (!(elapsed_days > 0.0) ||
+                !finite_binary64(elapsed_days)) {
+                return false;
+            }
+            derivative =
+                ((*fits)[right].elements.mean_motion -
+                 (*fits)[left].elements.mean_motion) /
+                elapsed_days;
+        } else {
+            const FitResult& left = (*fits)[index - 1];
+            const FitResult& center = (*fits)[index];
+            const FitResult& right = (*fits)[index + 1];
+            const double x0 = left.elements.epoch_jd;
+            const double x1 = center.elements.epoch_jd;
+            const double x2 = right.elements.epoch_jd;
+            if (!(x0 < x1 && x1 < x2) ||
+                !finite_binary64(x0) ||
+                !finite_binary64(x1) ||
+                !finite_binary64(x2)) {
+                return false;
+            }
+            const double t0 = x0 - x1;
+            const double t2 = x2 - x1;
+            const double left_weight =
+                -t2 / (t0 * (t0 - t2));
+            const double center_weight =
+                (-t0 - t2) / ((-t0) * (-t2));
+            const double right_weight =
+                -t0 / ((t2 - t0) * t2);
+            derivative =
+                left.elements.mean_motion * left_weight +
+                center.elements.mean_motion * center_weight +
+                right.elements.mean_motion * right_weight;
+        }
+        if (!finite_binary64(derivative)) return false;
+        (*fits)[index].elements.mean_motion_dot = derivative;
+        (*fits)[index].elements.mean_motion_ddot = 0.0;
+    }
+    return true;
+}
