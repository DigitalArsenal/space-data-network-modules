+std::vector<std::size_t> select_fit_epoch_indices(
+    const std::vector<EphemerisPoint>& points,
+    double spacing_sec,
+    double fit_window_sec) {
+    std::vector<std::size_t> indices;
+    if (points.size() < 3) return indices;
+
+    const double spacing =
+        spacing_sec > 0.0 ? spacing_sec : 21600.0;
+    const double window_sec =
+        fit_window_sec > 0.0 ? fit_window_sec : 28800.0;
+    const double spacing_days = spacing / SEC_PER_DAY;
+    const double window_days = window_sec / SEC_PER_DAY;
+    const double first_jd = points.front().epoch_jd;
+    const double last_jd = points.back().epoch_jd;
+    constexpr double kEpochToleranceDays = 1e-9;
+    if (last_jd - first_jd + kEpochToleranceDays < window_days) {
+        return indices;
+    }
+    for (std::size_t index = 1; index < points.size(); ++index) {
+        if (!(points[index].epoch_jd > points[index - 1].epoch_jd)) {
+            return {};
+        }
+    }
+
+    const double latest_complete_start = last_jd - window_days;
+    for (std::size_t k = 0;; ++k) {
+        const double target =
+            first_jd + static_cast<double>(k) * spacing_days;
+        if (target > latest_complete_start + kEpochToleranceDays) break;
+        const auto it = std::lower_bound(
+            points.begin(), points.end(), target - kEpochToleranceDays,
+            [](const EphemerisPoint& point, double value) {
+                return point.epoch_jd < value;
+            });
+        if (it == points.end() ||
+            it->epoch_jd > latest_complete_start + kEpochToleranceDays) {
+            break;
+        }
+        const std::size_t index =
+            static_cast<std::size_t>(it - points.begin());
+        if (indices.empty() || indices.back() != index) {
+            indices.push_back(index);
+        }
+    }
+
+    const auto terminal_after = std::upper_bound(
+        points.begin(), points.end(),
+        latest_complete_start + kEpochToleranceDays,
+        [](double value, const EphemerisPoint& point) {
+            return value < point.epoch_jd;
+        });
+    if (terminal_after != points.begin()) {
+        const std::size_t terminal = static_cast<std::size_t>(
+            std::prev(terminal_after) - points.begin());
+        if (indices.empty() || indices.back() != terminal) {
+            indices.push_back(terminal);
+        }
+    }
+    return indices;
+}
+
+std::vector<FitResult> fit_sgp4_epoch_series(
+    const StateSeries& series,
+    const FitterConfig& config) {
+    FitterConfig cfg = config;
+    if (series.meta.position_only) cfg.position_only = true;
+    cfg.fit_window_sec = cfg.multi_epoch_window_sec;
+    cfg.use_all_window_states = true;
+
+    const std::vector<std::size_t> indices =
+        select_fit_epoch_indices(
+            series.samples, cfg.multi_epoch_spacing_sec,
+            cfg.multi_epoch_window_sec);
+    std::vector<FitResult> results;
+    results.reserve(indices.size());
+    for (const std::size_t index : indices) {
+        FitResult result = fit_single_epoch(series.samples, index, cfg);
+        if (series.meta.norad_cat_id > 0)
+            result.elements.norad_cat_id = series.meta.norad_cat_id;
+        if (!series.meta.object_name.empty())
+            result.elements.object_name = series.meta.object_name;
+        if (!series.meta.object_id.empty())
+            result.elements.object_id = series.meta.object_id;
+        result.elements.data_source = series.meta.data_source;
+        results.push_back(std::move(result));
+    }
+    return results;
+}
