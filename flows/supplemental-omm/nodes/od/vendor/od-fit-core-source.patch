+std::vector<uint8_t> build_terminal_reentry_ocm_flatbuffer(
+    const StateSeries& series,
+    double state_step_seconds,
+    const std::string& originator) {
+    if (series.samples.size() < 3 || !(state_step_seconds > 0.0)) return {};
+
+    const std::string start_time =
+        jd_to_iso_milliseconds(series.samples.front().epoch_jd);
+    const std::string stop_time =
+        jd_to_iso_milliseconds(series.samples.back().epoch_jd);
+    const double time_span_days =
+        state_step_seconds *
+        static_cast<double>(series.samples.size() - 1) / 86400.0;
+
+    std::vector<double> states;
+    states.reserve(series.samples.size() * 6);
+    for (const EphemerisPoint& sample : series.samples) {
+        states.push_back(sample.x);
+        states.push_back(sample.y);
+        states.push_back(sample.z);
+        states.push_back(sample.vx);
+        states.push_back(sample.vy);
+        states.push_back(sample.vz);
+    }
+
+    flatbuffers::FlatBufferBuilder fbb(
+        4096 + states.size() * sizeof(double));
+    using ::flatbuffers::Offset;
+    using ::flatbuffers::String;
+
+    const auto version = fbb.CreateString("3.0");
+    const auto creation = fbb.CreateString(stop_time);
+    const auto encoded_originator =
+        fbb.CreateString(originator.empty() ? "SDN-OD" : originator);
+    const auto object_name = series.meta.object_name.empty()
+        ? Offset<String>{}
+        : fbb.CreateString(series.meta.object_name);
+    const auto object_id = series.meta.object_id.empty()
+        ? Offset<String>{}
+        : fbb.CreateString(series.meta.object_id);
+    const std::string catalog_id = series.meta.norad_cat_id > 0
+        ? std::to_string(series.meta.norad_cat_id)
+        : std::string();
+    const auto catalog_name = catalog_id.empty()
+        ? Offset<String>{}
+        : fbb.CreateString(catalog_id);
+    const auto object_designator = catalog_id.empty()
+        ? Offset<String>{}
+        : fbb.CreateString(catalog_id);
+    const auto time_system = fbb.CreateString("UTC");
+    const auto epoch_tzero = fbb.CreateString(start_time);
+    const auto encoded_start = fbb.CreateString(start_time);
+    const auto encoded_stop = fbb.CreateString(stop_time);
+    const auto ops_status = fbb.CreateString("DECAYING");
+    const auto orbit_category = fbb.CreateString("REENTRY");
+    const auto trajectory_element = fbb.CreateString("TRAJECTORY");
+    const auto data_elements =
+        fbb.CreateVector(std::vector<Offset<String>>{trajectory_element});
+    const auto trajectory_description = fbb.CreateString(
+        "TERMINAL_REENTRY_SOURCE_TRAJECTORY_TEME");
+    const auto reference_frame_name = fbb.CreateString("REFERENCE_FRAME");
+    const auto reference_frame_value = fbb.CreateString("TEME");
+    const auto source_frame_name = fbb.CreateString("SOURCE_FRAME");
+    const auto source_frame_value = fbb.CreateString(
+        series.meta.source_frame.empty() ? "UNSPECIFIED"
+                                         : series.meta.source_frame);
+    const auto terminal_name = fbb.CreateString("TERMINAL_REENTRY");
+    const auto terminal_value = fbb.CreateString("true");
+    const auto covariance_name = fbb.CreateString("COVARIANCE");
+    const auto covariance_value = fbb.CreateString("NOT_PROVIDED");
+    const auto state_data = fbb.CreateVector(states);
+
+    HeaderBuilder header_builder(fbb);
+    header_builder.add_CCSDS_OCM_VERS(version);
+    header_builder.add_CREATION_DATE(creation);
+    header_builder.add_ORIGINATOR(encoded_originator);
+    const auto header = header_builder.Finish();
+
+    MetadataBuilder metadata_builder(fbb);
+    metadata_builder.add_OBJECT_NAME(object_name);
+    metadata_builder.add_INTERNATIONAL_DESIGNATOR(object_id);
+    metadata_builder.add_CATALOG_NAME(catalog_name);
+    metadata_builder.add_OBJECT_DESIGNATOR(object_designator);
+    metadata_builder.add_TIME_SYSTEM(time_system);
+    metadata_builder.add_EPOCH_TZERO(epoch_tzero);
+    metadata_builder.add_OPS_STATUS(ops_status);
+    metadata_builder.add_ORBIT_CATEGORY(orbit_category);
+    metadata_builder.add_OCM_DATA_ELEMENTS(data_elements);
+    metadata_builder.add_START_TIME(encoded_start);
+    metadata_builder.add_STOP_TIME(encoded_stop);
+    metadata_builder.add_TIME_SPAN(time_span_days);
+    const auto metadata = metadata_builder.Finish();
+
+    std::vector<Offset<UserDefinedParameters>> user_parameters;
+    UserDefinedParametersBuilder reference_builder(fbb);
+    reference_builder.add_PARAM_NAME(reference_frame_name);
+    reference_builder.add_PARAM_VALUE(reference_frame_value);
+    user_parameters.push_back(reference_builder.Finish());
+    UserDefinedParametersBuilder source_builder(fbb);
+    source_builder.add_PARAM_NAME(source_frame_name);
+    source_builder.add_PARAM_VALUE(source_frame_value);
+    user_parameters.push_back(source_builder.Finish());
+    UserDefinedParametersBuilder terminal_builder(fbb);
+    terminal_builder.add_PARAM_NAME(terminal_name);
+    terminal_builder.add_PARAM_VALUE(terminal_value);
+    user_parameters.push_back(terminal_builder.Finish());
+    UserDefinedParametersBuilder covariance_builder(fbb);
+    covariance_builder.add_PARAM_NAME(covariance_name);
+    covariance_builder.add_PARAM_VALUE(covariance_value);
+    user_parameters.push_back(covariance_builder.Finish());
+    const auto encoded_user_parameters = fbb.CreateVector(user_parameters);
+
+    OCMBuilder ocm_builder(fbb);
+    ocm_builder.add_HEADER(header);
+    ocm_builder.add_METADATA(metadata);
+    ocm_builder.add_TRAJ_TYPE(trajectoryType::CARTESIAN_PV);
+    ocm_builder.add_TRAJ_TYPE_DESCRIPTION(trajectory_description);
+    ocm_builder.add_STATE_STEP_SIZE(state_step_seconds);
+    ocm_builder.add_STATE_VECTOR_SIZE(static_cast<uint8_t>(6));
+    ocm_builder.add_STATE_DATA(state_data);
+    ocm_builder.add_USER_DEFINED_PARAMETERS(encoded_user_parameters);
+    const auto ocm = ocm_builder.Finish();
+
+    FinishSizePrefixedOCMBuffer(fbb, ocm);
+    const uint8_t* bytes = fbb.GetBufferPointer();
+    return std::vector<uint8_t>(bytes, bytes + fbb.GetSize());
+}
+
 }  // namespace od
