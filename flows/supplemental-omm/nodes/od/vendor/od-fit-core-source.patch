+enum class TerminalReentryClassification {
+    NotTerminal,
+    Valid,
+    Invalid,
+};
+
+TerminalReentryClassification classify_terminal_reentry(
+    const StateSeries& series,
+    double* state_step_seconds,
+    std::string* error_message) {
+    constexpr double kWgs72EarthRadiusKm = 6378.135;
+    constexpr double kReentryInterfaceAltitudeKm = 120.0;
+    constexpr double kUniformStepToleranceSeconds = 0.001;
+    if (series.samples.empty()) {
+        return TerminalReentryClassification::NotTerminal;
+    }
+    const EphemerisPoint& terminal = series.samples.back();
+    if (!finite_binary64(terminal.x) || !finite_binary64(terminal.y) ||
+        !finite_binary64(terminal.z)) {
+        return TerminalReentryClassification::NotTerminal;
+    }
+    const double terminal_radius_squared =
+        terminal.x * terminal.x +
+        terminal.y * terminal.y +
+        terminal.z * terminal.z;
+    constexpr double kReentryInterfaceRadiusKm =
+        kWgs72EarthRadiusKm + kReentryInterfaceAltitudeKm;
+    if (!(terminal_radius_squared <=
+          kReentryInterfaceRadiusKm * kReentryInterfaceRadiusKm)) {
+        return TerminalReentryClassification::NotTerminal;
+    }
+    if (series.meta.center_name != "EARTH") {
+        *error_message =
+            "terminal reentry requires an Earth-centered trajectory";
+        return TerminalReentryClassification::Invalid;
+    }
+    if (series.meta.position_only || series.samples.size() < 3) {
+        *error_message =
+            "terminal reentry requires at least three full position/velocity states";
+        return TerminalReentryClassification::Invalid;
+    }
+    double expected_step = 0.0;
+    for (std::size_t index = 0; index < series.samples.size(); ++index) {
+        const EphemerisPoint& sample = series.samples[index];
+        if (!finite_binary64(sample.epoch_jd) ||
+            !finite_binary64(sample.x) || !finite_binary64(sample.y) ||
+            !finite_binary64(sample.z) || !finite_binary64(sample.vx) ||
+            !finite_binary64(sample.vy) || !finite_binary64(sample.vz)) {
+            *error_message =
+                "terminal reentry contains a non-finite state";
+            return TerminalReentryClassification::Invalid;
+        }
+        if (index == 0) continue;
+        const double step =
+            (sample.epoch_jd - series.samples[index - 1].epoch_jd) *
+            86400.0;
+        if (!(step > 0.0)) {
+            *error_message =
+                "terminal reentry epochs must be strictly increasing";
+            return TerminalReentryClassification::Invalid;
+        }
+        if (index == 1) {
+            expected_step =
+                std::round(step * 1000.0) / 1000.0;
+            if (!(expected_step > 0.0)) {
+                *error_message =
+                    "terminal reentry epoch step is below one millisecond";
+                return TerminalReentryClassification::Invalid;
+            }
+        }
+        const double elapsed =
+            (sample.epoch_jd - series.samples.front().epoch_jd) *
+            86400.0;
+        const double expected_elapsed =
+            expected_step * static_cast<double>(index);
+        if (std::abs(elapsed - expected_elapsed) >
+            kUniformStepToleranceSeconds) {
+            *error_message =
+                "terminal reentry states must use one uniform epoch step";
+            return TerminalReentryClassification::Invalid;
+        }
+    }
+    *state_step_seconds = expected_step;
+    return TerminalReentryClassification::Valid;
+}
+
+bool fitted_epochs_pass_publication_gate(
+    const std::vector<FitResult>& fits) {
+    constexpr double kMaximumRmsKm = 12.0;
+    return !fits.empty() &&
+        std::all_of(
+            fits.begin(), fits.end(),
+            [](const FitResult& fit) {
+                return finite_binary64(fit.rms_km) &&
+                    fit.rms_km >= 0.0 &&
+                    fit.rms_km < kMaximumRmsKm &&
+                    fit.converged;
+            });
+}
