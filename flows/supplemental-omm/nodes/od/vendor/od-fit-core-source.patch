+std::string jd_to_iso_milliseconds(double jd) {
+    constexpr double kUnixEpochJulianDate = 2440587.5;
+    constexpr std::int64_t kMillisecondsPerDay = 86400000;
+    const std::int64_t unix_milliseconds = static_cast<std::int64_t>(
+        std::llround(
+            (jd - kUnixEpochJulianDate) *
+            static_cast<double>(kMillisecondsPerDay)));
+    std::int64_t days = unix_milliseconds / kMillisecondsPerDay;
+    std::int64_t day_milliseconds =
+        unix_milliseconds % kMillisecondsPerDay;
+    if (day_milliseconds < 0) {
+        day_milliseconds += kMillisecondsPerDay;
+        --days;
+    }
+
+    const std::int64_t julian_day_number = days + 2440588;
+    std::int64_t l = julian_day_number + 68569;
+    const std::int64_t n = 4 * l / 146097;
+    l -= (146097 * n + 3) / 4;
+    const std::int64_t i = 4000 * (l + 1) / 1461001;
+    l = l - 1461 * i / 4 + 31;
+    const std::int64_t j = 80 * l / 2447;
+    const int day = static_cast<int>(l - 2447 * j / 80);
+    l = j / 11;
+    const int month = static_cast<int>(j + 2 - 12 * l);
+    const int year = static_cast<int>(100 * (n - 49) + i + l);
+
+    const int hour =
+        static_cast<int>(day_milliseconds / 3600000);
+    day_milliseconds %= 3600000;
+    const int minute =
+        static_cast<int>(day_milliseconds / 60000);
+    day_milliseconds %= 60000;
+    const int second =
+        static_cast<int>(day_milliseconds / 1000);
+    const int millisecond =
+        static_cast<int>(day_milliseconds % 1000);
+
+    char encoded[32];
+    std::snprintf(
+        encoded, sizeof(encoded),
+        "%04d-%02d-%02dT%02d:%02d:%02d.%03dZ",
+        year, month, day, hour, minute, second, millisecond);
+    return encoded;
+}
+
