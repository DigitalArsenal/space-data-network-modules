{
  "pluginId": "org.sdn.flows.supplemental-omm.sdnap",
  "name": "Supplemental OMM SDN-AP adapter",
  "version": "1.0.0",
  "description": "The two adapters around propagator/sdn-ap's fit in the Supplemental OMM flow (typed contracts 1.0: FlatBuffers only). prepare takes each source's SDS $OEM and emits it on `ephemeris` beside a $PCF (THEORY SDNAP) on `configuration`, one ephemeris and one $PCF an invocation, yielding until every ephemeris it was handed is sent (the fit's configuration port takes one frame, and an ephemeris the fit refuses then costs only that object). wrap takes the fit's $OMM (SDNAP, with COVARIANCE) and $OBD and emits each standard's IngestRequest (INGQ) on `<code>_meta` beside its size-prefixed record stream on `<code>`: SCHEMA, TAGS PROVIDER_ID supplemental-omm, SOURCE_NAME sdn-ap, BATCH_ID the SHA-256 of the stream, CONTENT_KEY_ID public, RECONCILE Duplicates, PROVENANCE. No hostcalls. catalog_request asks the node's current $OMM catalog (a $QRP Request for data-source/retrieval omm_bulk) on each timer tick; from_page sends the page's records one at a time, each with a default $PCF, for propagator/sdn-ap propagate; publish_request is the OD node's, for this adapter's batches (config omm_publish_url).",
  "pluginFamily": "orbit_determination",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "direct"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "prepare",
      "displayName": "Pair an ephemeris with the SDN-AP configuration",
      "maxBatch": 65535,
      "drainPolicy": "drain-until-yield",
      "inputPorts": [
        {
          "portId": "oem",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "description": "SDS $OEM, one object per frame, from any of the flow's source modules.",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "SDS $OEM, one object per frame, from any of the flow's source modules."
        }
      ],
      "outputPorts": [
        {
          "portId": "ephemeris",
          "acceptedTypeSets": [
            {
              "setId": "sds-oem",
              "description": "The input $OEM, unchanged.",
              "allowedTypes": [
                {
                  "schemaName": "OEM.fbs",
                  "fileIdentifier": "$OEM",
                  "rootTypeName": "OEM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "The input $OEM, unchanged."
        },
        {
          "portId": "configuration",
          "acceptedTypeSets": [
            {
              "setId": "sds-pcf",
              "description": "A $PCF 1.0 with THEORY SDNAP and every table at its default: what propagator/sdn-ap fit reads.",
              "allowedTypes": [
                {
                  "schemaName": "PCF.fbs",
                  "fileIdentifier": "$PCF",
                  "rootTypeName": "PCF",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "A $PCF 1.0 with THEORY SDNAP and every table at its default: what propagator/sdn-ap fit reads. One per invocation."
        }
      ]
    },
    {
      "methodId": "wrap",
      "displayName": "File the SDN-AP fit",
      "maxBatch": 65535,
      "drainPolicy": "single-shot",
      "inputPorts": [
        {
          "portId": "elements",
          "acceptedTypeSets": [
            {
              "setId": "sds-omm",
              "description": "The fit's $OMM (MEAN_ELEMENT_THEORY SDNAP, with COVARIANCE).",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true,
          "description": "The fit's $OMM (MEAN_ELEMENT_THEORY SDNAP, with COVARIANCE)."
        },
        {
          "portId": "determination",
          "acceptedTypeSets": [
            {
              "setId": "sds-obd",
              "description": "The fit's $OBD.",
              "allowedTypes": [
                {
                  "schemaName": "OBD.fbs",
                  "fileIdentifier": "$OBD",
                  "rootTypeName": "OBD",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "The fit's $OBD."
        }
      ],
      "outputPorts": [
        {
          "portId": "omm_meta",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-request",
              "description": "IngestRequest filing the omm stream: SCHEMA OMM.fbs, TAGS PROVIDER_ID supplemental-omm, SOURCE_NAME sdn-ap, BATCH_ID the SHA-256 of the stream, CONTENT_KEY_ID public.",
              "allowedTypes": [
                {
                  "schemaName": "IngestRequest.fbs",
                  "fileIdentifier": "INGQ",
                  "rootTypeName": "IngestRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "IngestRequest filing the omm stream: SCHEMA OMM.fbs, TAGS PROVIDER_ID supplemental-omm, SOURCE_NAME sdn-ap, BATCH_ID the SHA-256 of the stream, CONTENT_KEY_ID public."
        },
        {
          "portId": "omm",
          "acceptedTypeSets": [
            {
              "setId": "sds-omm-record-stream",
              "description": "Size-prefixed $OMM records.",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Size-prefixed $OMM records."
        },
        {
          "portId": "obd_meta",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-request",
              "description": "IngestRequest filing the obd stream.",
              "allowedTypes": [
                {
                  "schemaName": "IngestRequest.fbs",
                  "fileIdentifier": "INGQ",
                  "rootTypeName": "IngestRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "IngestRequest filing the obd stream."
        },
        {
          "portId": "obd",
          "acceptedTypeSets": [
            {
              "setId": "sds-obd-record-stream",
              "description": "Size-prefixed $OBD records.",
              "allowedTypes": [
                {
                  "schemaName": "OBD.fbs",
                  "fileIdentifier": "$OBD",
                  "rootTypeName": "OBD",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Size-prefixed $OBD records."
        }
      ]
    },
    {
      "methodId": "catalog_request",
      "displayName": "Ask the node for its current catalog",
      "maxBatch": 1,
      "drainPolicy": "single-shot",
      "inputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "timer-tick",
              "description": "The flow trigger firing (TimerTick, TICK); its fields are not read.",
              "allowedTypes": [
                {
                  "schemaName": "TimerTick.fbs",
                  "fileIdentifier": "TICK",
                  "rootTypeName": "TimerTick",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true,
          "description": "The flow trigger firing (TimerTick, TICK); its fields are not read."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sds-qrp-request",
              "description": "A $QRP Request for the current $OMM catalog (SCHEMA_NAME OMM.fbs, SOURCE_NAME celestrak-gp, TIME_PROFILE Nearest), asking the host for the records inline.",
              "allowedTypes": [
                {
                  "schemaName": "QRP.fbs",
                  "fileIdentifier": "$QRP",
                  "rootTypeName": "QRP",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "A $QRP Request for the current $OMM catalog (SCHEMA_NAME OMM.fbs, SOURCE_NAME celestrak-gp, TIME_PROFILE Nearest), asking the host for the records inline."
        }
      ]
    },
    {
      "methodId": "from_page",
      "displayName": "Send the catalog one record at a time",
      "maxBatch": 65535,
      "drainPolicy": "drain-until-yield",
      "inputPorts": [
        {
          "portId": "page",
          "acceptedTypeSets": [
            {
              "setId": "sds-qrp-page",
              "description": "data-source/retrieval omm_bulk's page: the size-prefixed $QRP header, then the size-prefixed records.",
              "allowedTypes": [
                {
                  "schemaName": "QRP.fbs",
                  "fileIdentifier": "$QRP",
                  "rootTypeName": "QRP",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "data-source/retrieval omm_bulk's page: the size-prefixed $QRP header, then the size-prefixed records."
        }
      ],
      "outputPorts": [
        {
          "portId": "omm",
          "acceptedTypeSets": [
            {
              "setId": "sds-omm",
              "description": "One catalog $OMM (not size-prefixed).",
              "allowedTypes": [
                {
                  "schemaName": "OMM.fbs",
                  "fileIdentifier": "$OMM",
                  "rootTypeName": "OMM",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "One catalog $OMM (not size-prefixed)."
        },
        {
          "portId": "configuration",
          "acceptedTypeSets": [
            {
              "setId": "sds-pcf",
              "description": "A $PCF 1.0 with every table at its default: propagator/sdn-ap propagate takes each set's own theory. One per record.",
              "allowedTypes": [
                {
                  "schemaName": "PCF.fbs",
                  "fileIdentifier": "$PCF",
                  "rootTypeName": "PCF",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "A $PCF 1.0 with every table at its default: propagator/sdn-ap propagate takes each set's own theory. One per record."
        }
      ]
    },
    {
      "methodId": "publish_request",
      "displayName": "Publish a stored batch",
      "maxBatch": 65535,
      "drainPolicy": "single-shot",
      "inputPorts": [
        {
          "portId": "result",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-result",
              "description": "IngestResult (INGR) from hostcap/storage-ingest.",
              "allowedTypes": [
                {
                  "schemaName": "IngestResult.fbs",
                  "fileIdentifier": "INGR",
                  "rootTypeName": "IngestResult",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 65535,
          "required": true,
          "description": "IngestResult (INGR) from hostcap/storage-ingest."
        },
        {
          "portId": "meta",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-ingest-request",
              "description": "The IngestRequest (INGQ) that batch was stored by.",
              "allowedTypes": [
                {
                  "schemaName": "IngestRequest.fbs",
                  "fileIdentifier": "INGQ",
                  "rootTypeName": "IngestRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "The IngestRequest (INGQ) that batch was stored by."
        }
      ],
      "outputPorts": [
        {
          "portId": "request",
          "acceptedTypeSets": [
            {
              "setId": "sdn-runtime-http-request",
              "description": "HttpRequest for hostcap/http-request: POST omm_publish_url, BODY the IngestResult, content-type application/octet-stream.",
              "allowedTypes": [
                {
                  "schemaName": "HttpRequest.fbs",
                  "fileIdentifier": "HREQ",
                  "rootTypeName": "HttpRequest",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 65535,
          "required": false,
          "description": "HttpRequest for hostcap/http-request: POST omm_publish_url, BODY the IngestResult, content-type application/octet-stream."
        }
      ]
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "OEM.fbs",
      "fileIdentifier": "$OEM",
      "rootTypeName": "OEM"
    },
    {
      "schemaName": "PCF.fbs",
      "fileIdentifier": "$PCF",
      "rootTypeName": "PCF"
    },
    {
      "schemaName": "OMM.fbs",
      "fileIdentifier": "$OMM",
      "rootTypeName": "OMM"
    },
    {
      "schemaName": "OBD.fbs",
      "fileIdentifier": "$OBD",
      "rootTypeName": "OBD"
    },
    {
      "schemaName": "QRP.fbs",
      "fileIdentifier": "$QRP",
      "rootTypeName": "QRP"
    }
  ],
  "buildArtifacts": [
    {
      "artifactId": "supplemental-omm-sdnap-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1,
  "sequentialJustification": {
    "kind": "inherently-sequential-algorithm",
    "detail": "Each method maps one frame set to its output frames in one pass; prepare keeps the ephemerides it has not sent yet in order; the node creates no thread."
  }
}
