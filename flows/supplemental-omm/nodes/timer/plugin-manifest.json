{
  "pluginId": "org.sdn.flows.supplemental-omm.timer",
  "name": "Supplemental OMM Hourly Timer Policy",
  "version": "1.0.0",
  "description": "Signed Supplemental OMM timer policy node. It owns the hourly UTC schedule, coalescing misfire policy, wakeup correlation token, and typed tick emission. The host supplies only wall-clock readings and generic wakeups at requested instants.",
  "pluginFamily": "infrastructure",
  "capabilities": [
    "clock",
    "timers"
  ],
  "externalInterfaces": [
    {
      "interfaceId": "generic-clock",
      "kind": "host-service",
      "direction": "input",
      "capability": "clock",
      "resource": "host://clock",
      "properties": {
        "hostOps": [
          "clock.now"
        ]
      }
    },
    {
      "interfaceId": "generic-timers",
      "kind": "host-service",
      "direction": "output",
      "capability": "timers",
      "resource": "host://timers",
      "properties": {
        "hostOps": [
          "timers.arm",
          "timers.cancel"
        ]
      }
    }
  ],
  "invokeSurfaces": [
    "direct"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "on_wakeup",
      "displayName": "Apply Hourly Wakeup Policy",
      "inputPorts": [
        {
          "portId": "wakeup",
          "acceptedTypeSets": [
            {
              "setId": "fso-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSO.fbs",
                  "fileIdentifier": "$FSO",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "7698d54cba61bbb638104d37211cc2dbb15e446aefcfedfb4a66d0c46c70b90f",
                  "rootTypeName": "FSO",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSO.fbs",
                  "fileIdentifier": "$FSO",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "7698d54cba61bbb638104d37211cc2dbb15e446aefcfedfb4a66d0c46c70b90f",
                  "rootTypeName": "FSO",
                  "wireFormat": "aligned-binary",
                  "byteLength": 361648,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "Optional typed control/wakeup envelope. Generic wakeup delivery may invoke the method without a body."
        }
      ],
      "outputPorts": [
        {
          "portId": "tick",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "aligned-binary",
                  "byteLength": 1048744,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false,
          "description": "One bounded FSB tick frame when the signed policy decides this wakeup is due."
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "FSO.fbs",
      "fileIdentifier": "$FSO",
      "schemaVersion": "1.164.0",
      "schemaHash": "7698d54cba61bbb638104d37211cc2dbb15e446aefcfedfb4a66d0c46c70b90f",
      "rootTypeName": "FSO"
    },
    {
      "schemaName": "FSB.fbs",
      "fileIdentifier": "$FSB",
      "schemaVersion": "1.164.0",
      "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
      "rootTypeName": "FSB"
    }
  ],
  "buildArtifacts": [
    {
      "artifactId": "supplemental-omm-timer-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1,
  "sequentialJustification": {
    "kind": "pure-transform",
    "detail": "The timer node is a pure policy transform: it reads one clock value, decides whether the hourly window has elapsed, and emits a single typed tick frame. It owns no data set to fan out, allocates no worker pool, and calls no pthread_create; the built artifact imports no wasi.thread-spawn and exports no wasi_thread_start. Parallelism for this flow lives in the OD fit node, one hop downstream."
  }
}
