{
  "pluginId": "org.sdn.flows.supplemental-omm.publication",
  "name": "Supplemental OMM Publication",
  "version": "1.0.0",
  "description": "Signed Supplemental OMM publication node. It owns publication policy and forwards exact typed record bytes through one application-blind host adapter.",
  "pluginFamily": "publisher",
  "capabilities": [
    "pubsub"
  ],
  "externalInterfaces": [
    {
      "interfaceId": "generic-pubsub",
      "kind": "host-service",
      "direction": "output",
      "capability": "pubsub",
      "resource": "host://pubsub",
      "properties": {
        "hostOps": [
          "pubsub.publish"
        ]
      }
    }
  ],
  "invokeSurfaces": [
    "direct"
  ],
  "runtimeTargets": [
    "browser",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "publish_records",
      "displayName": "Publish Records",
      "inputPorts": [
        {
          "portId": "records",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "aligned-binary",
                  "byteLength": 1048744,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 4096,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "published",
          "acceptedTypeSets": [
            {
              "setId": "fsb-dual",
              "allowedTypes": [
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "flatbuffer"
                },
                {
                  "schemaName": "FSB.fbs",
                  "fileIdentifier": "$FSB",
                  "schemaVersion": "1.164.0",
                  "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
                  "rootTypeName": "FSB",
                  "wireFormat": "aligned-binary",
                  "byteLength": 1048744,
                  "requiredAlignment": 8
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 4096,
          "required": true
        }
      ],
      "maxBatch": 4096,
      "drainPolicy": "drain-until-yield"
    }
  ],
  "schemasUsed": [
    {
      "schemaName": "FSB.fbs",
      "fileIdentifier": "$FSB",
      "schemaVersion": "1.164.0",
      "schemaHash": "0b23aa63d0e3f17d828fc84dd433605c2794cb81ade7c043cb200e954c84e945",
      "rootTypeName": "FSB"
    }
  ],
  "buildArtifacts": [
    {
      "artifactId": "supplemental-omm-publication-isomorphic",
      "kind": "wasm",
      "path": "dist/isomorphic/module.wasm",
      "target": "browser,wasmedge"
    }
  ],
  "abiVersion": 1,
  "sequentialJustification": {
    "kind": "inherently-sequential-algorithm",
    "detail": "The publication node walks one ordered batch of fitted result records and emits one canonical FSB transport envelope; the envelope's DATA vector offsets are produced in order, so record k+1's placement depends on record k. It spawns nothing, and the built artifact imports no wasi.thread-spawn and exports no wasi_thread_start."
  }
}
