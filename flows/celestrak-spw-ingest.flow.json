{
  "programId": "com.digitalarsenal.flows.celestrak-spw-ingest",
  "name": "CelesTrak Space Weather Ingest Flow",
  "version": "0.2.0",
  "engineLinkage": "bridge",
  "description": "Per-provider ingest flow, space weather. Typed contracts 1.0 (FlatBuffers only, no JSON and no base64): the timer's TimerTick enters the request builder; each HttpRequest carries its job - one size-prefixed $ICN (Ingest Connector) record naming the lane, the URL, the origin, the dataset and the usage terms - in CONTEXT, which hostcap/http-request echoes in the HttpResponse, so the parser reads its job from the response itself and nothing is paired by position. celestrak-request:spw emits the SW-All.csv HttpRequest (4 MiB budget); hostcap/http-request fetches it; celestrak-parser:parse_spw normalizes it into an $SPW record stream with its IngestRequest (batch = sha256 of the payload, reconcile Current; the runner's 7-day stale-source gate fails the batch in-wasm; archived as celestrak/SW-All.csv), and hostcap/storage-ingest persists it through the policy-mediated storage.ingest_with_source hostcall. After the store celestrak-request:publish_request joins the IngestResult with the parser's IngestRequest and (only when node CONFIG carries celestrak_publish_url) emits the loopback dataset-publication POST, its body the IngestResult. Egress: result (IngestResult), notice (FlowNotice Unchanged on HTTP 304), publication (the publication HttpResponse). All decisions live in-wasm.",
  "nodes": [
    {
      "nodeId": "req",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "spw",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "http",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "parse",
      "pluginId": "com.digitalarsenal.data-source.celestrak-parser",
      "methodId": "parse_spw",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest_spw",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_spw",
      "pluginId": "com.digitalarsenal.data-source.celestrak-request",
      "methodId": "publish_request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "publish_http_spw",
      "pluginId": "com.digitalarsenal.hostcap.http-request",
      "methodId": "request",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    }
  ],
  "edges": [
    {
      "edgeId": "req-http",
      "fromNodeId": "req",
      "fromPortId": "request",
      "toNodeId": "http",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "http-parse",
      "fromNodeId": "http",
      "fromPortId": "response",
      "toNodeId": "parse",
      "toPortId": "response",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-spw-meta",
      "fromNodeId": "parse",
      "fromPortId": "spw_meta",
      "toNodeId": "ingest_spw",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-spw-records",
      "fromNodeId": "parse",
      "fromPortId": "spw_records",
      "toNodeId": "ingest_spw",
      "toPortId": "spw_records",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-spw-raw",
      "fromNodeId": "parse",
      "fromPortId": "raw",
      "toNodeId": "ingest_spw",
      "toPortId": "raw",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-spw-egress",
      "fromNodeId": "ingest_spw",
      "fromPortId": "result",
      "toNodeId": "egress",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "ingest-spw-publish",
      "fromNodeId": "ingest_spw",
      "fromPortId": "result",
      "toNodeId": "publish_spw",
      "toPortId": "result",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-spw-meta-publish",
      "fromNodeId": "parse",
      "fromPortId": "spw_meta",
      "toNodeId": "publish_spw",
      "toPortId": "meta",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "publish-spw-http",
      "fromNodeId": "publish_spw",
      "fromPortId": "request",
      "toNodeId": "publish_http_spw",
      "toPortId": "request",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "publish-spw-egress",
      "fromNodeId": "publish_http_spw",
      "fromPortId": "response",
      "toNodeId": "egress",
      "toPortId": "publication",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    },
    {
      "edgeId": "parse-unchanged-egress",
      "fromNodeId": "parse",
      "fromPortId": "unchanged",
      "toNodeId": "egress",
      "toPortId": "notice",
      "backpressurePolicy": "queue",
      "queueDepth": 1
    }
  ],
  "triggers": [
    {
      "triggerId": "timer-spw",
      "kind": "timer",
      "source": "host-cron",
      "defaultIntervalMs": 10800000,
      "description": "Space weather sync timer (runner SpaceWeatherInterval floor, 3 h)."
    }
  ],
  "triggerBindings": [
    {
      "triggerId": "timer-spw",
      "targetNodeId": "req",
      "targetPortId": "tick",
      "backpressurePolicy": "queue",
      "queueDepth": 4
    }
  ],
  "requiredPlugins": [
    "com.digitalarsenal.data-source.celestrak-request",
    "com.digitalarsenal.hostcap.http-request",
    "com.digitalarsenal.data-source.celestrak-parser",
    "com.digitalarsenal.hostcap.storage-ingest"
  ]
}
