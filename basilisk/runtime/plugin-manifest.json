{
  "pluginId": "com.digitalarsenal.basilisk.runtime",
  "name": "Basilisk Runtime Module",
  "version": "0.3.0",
  "description": "Seed SDN module for Basilisk runtime: echoes an SDS $XTC telemetry/command dictionary on typed FlatBuffer ports, and runs a simplified deterministic pointing and power scenario: one SDS $PPS scenario in, one $PPS out with the resolved scenario, status and column-major telemetry.",
  "pluginFamily": "basilisk",
  "capabilities": [],
  "externalInterfaces": [],
  "invokeSurfaces": [
    "command"
  ],
  "runtimeTargets": [
    "browser",
    "wasi",
    "wasmedge"
  ],
  "methods": [
    {
      "methodId": "echo_xtc_dictionary",
      "displayName": "Echo XTCE Dictionary",
      "inputPorts": [
        {
          "portId": "dictionary",
          "acceptedTypeSets": [
            {
              "setId": "xtc-flatbuffer",
              "allowedTypes": [
                {
                  "schemaName": "XTC.fbs",
                  "fileIdentifier": "$XTC",
                  "rootTypeName": "XTC",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "dictionary",
          "acceptedTypeSets": [
            {
              "setId": "xtc-flatbuffer",
              "allowedTypes": [
                {
                  "schemaName": "XTC.fbs",
                  "fileIdentifier": "$XTC",
                  "rootTypeName": "XTC",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 0,
          "maxStreams": 1,
          "required": false
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    },
    {
      "methodId": "run_pointing_power_scenario",
      "displayName": "Run Pointing and Power Scenario",
      "inputPorts": [
        {
          "portId": "scenario",
          "acceptedTypeSets": [
            {
              "setId": "pps-scenario",
              "allowedTypes": [
                {
                  "schemaName": "PPS.fbs",
                  "fileIdentifier": "$PPS",
                  "rootTypeName": "PPS",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "outputPorts": [
        {
          "portId": "telemetry",
          "acceptedTypeSets": [
            {
              "setId": "pps-telemetry",
              "allowedTypes": [
                {
                  "schemaName": "PPS.fbs",
                  "fileIdentifier": "$PPS",
                  "rootTypeName": "PPS",
                  "wireFormat": "flatbuffer"
                }
              ]
            }
          ],
          "minStreams": 1,
          "maxStreams": 1,
          "required": true
        }
      ],
      "maxBatch": 1,
      "drainPolicy": "single-shot"
    }
  ]
}
